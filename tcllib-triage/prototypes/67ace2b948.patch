--- modules/mime/mime.tcl
+++ modules/mime/mime.tcl
@@ -1922,10 +1922,16 @@
     }
 
     if {[info exists state(error)]} {
         unset state(error)
     }
+
+    # A channel that translates \n into \r\n would turn the CRLF line
+    # endings of an unconverted body into \r\r\n. Map them to \n first.
+    set crlfP [expr {$converter eq {}
+		     && [lindex [fconfigure $channel -translation] end] eq "crlf"}]
+    set cr {}
 
     switch -- $state(value) {
         file {
             set closeP 1
             if {[info exists state(root)]} {
@@ -1959,16 +1965,26 @@
                     set X [read $fd $size]
                 }
                 if {$size > 0} {
                     set size [expr {$size - [string length $X]}]
                 }
-                if {$converter eq {}} {
+                if {$crlfP} {
+                    # Keep a trailing \r for the next chunk.
+                    set X $cr$X
+                    set cr {}
+                    if {[string index $X end] eq "\r"} {
+                        set cr \r
+                        set X [string range $X 0 end-1]
+                    }
+                    puts -nonewline $channel [string map [list \r\n \n] $X]
+                } elseif {$converter eq {}} {
                     puts -nonewline $channel $X
                 } else {
                     puts -nonewline $channel [$converter -mode encode -- $X]
                 }
             }
+            puts -nonewline $channel $cr
 
             if {$closeP} {
                 catch {close $state(fd)}
                 unset state(fd)
             }
@@ -2036,11 +2052,13 @@
             fconfigure $channel -buffersize $blocksize
 
             puts $channel {}
 
             #TODO: tests don't cover these paths
-            if {$converter eq {}} {
+            if {$crlfP} {
+                puts -nonewline $channel [string map [list \r\n \n] $state(string)]
+            } elseif {$converter eq {}} {
                 puts -nonewline $channel $state(string)
             } else {
                 puts -nonewline $channel [$converter -mode encode -- $state(string)]
             }
         }

Index: modules/mime/mime.test
==================================================================
--- modules/mime/mime.test
+++ modules/mime/mime.test
@@ -669,10 +669,54 @@
     set restore [mime::initialize -string $str]
 } -cleanup {
     mime::finalize $restore
     unset part whole saved stm str
 } -match glob -result "::mime::*"
+
+# -------------------------------------------------------------------------
+
+test mime-17.1 {ticket 67ace2b948: buildmessage keeps CRLF of a parsed body} -setup {
+    set token [mime::initialize -string [join {
+	{Subject: test}
+	{Content-Type: text/plain}
+	{}
+	{line1}
+	{line2}
+	{}
+    } \r\n]]
+} -body {
+    set msg [mime::buildmessage $token]
+    list [string first \r\r $msg] [string range $msg end-15 end]
+} -cleanup {
+    mime::finalize $token
+    unset token msg
+} -result [list -1 "\r\nline1\r\nline2\r\n"]
+
+test mime-17.2 {ticket 67ace2b948: buildmessage keeps CRLF of a canonical body} -setup {
+    set token [mime::initialize -canonical text/plain -encoding 8bit \
+		   -string "line1\r\nline2\nline3\r\n"]
+} -body {
+    set msg [mime::buildmessage $token]
+    list [string first \r\r $msg] [string range $msg end-24 end]
+} -cleanup {
+    mime::finalize $token
+    unset token msg
+} -result [list -1 "\r\n\r\nline1\r\nline2\r\nline3\r\n"]
+
+test mime-17.3 {ticket 67ace2b948: buildmessage keeps CRLF of a parsed file body} -setup {
+    set path [makeBinaryFile [join [list \
+	{Subject: test} {Content-Type: text/plain} {} \
+	[string repeat x 32765] line2 {}] \r\n] crlf.msg]
+    set token [mime::initialize -file $path]
+} -body {
+    set msg [mime::buildmessage $token]
+    list [string first \r\r $msg] [string range $msg end-9 end]
+} -cleanup {
+    mime::finalize $token
+    removeFile crlf.msg
+    unset token msg path
+} -result [list -1 "x\r\nline2\r\n"]
 
 # -------------------------------------------------------------------------
 
 testsuiteCleanup
 return

