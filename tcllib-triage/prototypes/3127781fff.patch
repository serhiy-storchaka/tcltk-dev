@@ -0,0 +1,80 @@
+# -*- tcl -*-
+# receive.test:  tests for term::receive and term::interact::menu
+#
+# This file contains a collection of tests for one or more of the Tcllib
+# procedures.  Sourcing this file into Tcl runs the tests and
+# generates output for errors.  No output means no errors were found.
+
+# -------------------------------------------------------------------------
+
+source [file join \
+	[file dirname [file dirname [file join [pwd] [info script]]]] \
+	devtools testutilities.tcl]
+
+testsNeedTcl     8.6
+testsNeedTcltest 2
+
+support {
+    use      snit/snit.tcl            snit
+    use      textutil/repeat.tcl      textutil::repeat
+    use      textutil/tabify.tcl      textutil::tabify
+    useLocal ansi/code.tcl            term::ansi::code
+    useLocal ansi/code/attr.tcl       term::ansi::code::attr
+    useLocal ansi/code/ctrl.tcl       term::ansi::code::ctrl
+    useLocal send.tcl                 term::send
+    useLocal ansi/send.tcl            term::ansi::send
+    useLocal receive.tcl              term::receive
+    useLocal bind.tcl                 term::receive::bind
+}
+testing {
+    useLocal imenu.tcl                term::interact::menu
+}
+
+# -------------------------------------------------------------------------
+
+# Ticket 3127781: listen/unlisten must not leave the channel non-blocking,
+# or later reads of stdin spin instead of waiting.
+
+test term-receive-1.0 {unlisten restores blocking mode} -setup {
+    lassign [chan pipe] r w
+} -body {
+    term::receive::listen {apply {args {}}} $r
+    set res [fconfigure $r -blocking]
+    term::receive::unlisten $r
+    lappend res [fconfigure $r -blocking]
+} -cleanup {
+    close $r
+    close $w
+} -result {0 1}
+
+test term-receive-1.1 {unlisten keeps non-blocking mode} -setup {
+    lassign [chan pipe] r w
+    fconfigure $r -blocking 0
+} -body {
+    term::receive::listen {apply {args {}}} $r
+    term::receive::unlisten $r
+    fconfigure $r -blocking
+} -cleanup {
+    close $r
+    close $w
+} -result 0
+
+test term-interact-menu-1.0 {interact restores blocking mode} -setup {
+    lassign [chan pipe] r w
+    fconfigure $w -buffering none
+    set null [open /dev/null w]
+    set m [term::interact::menu M {a A b B} -in $r -out $null]
+} -constraints unix -body {
+    after 10 [list puts -nonewline $w \n]
+    list [$m interact] [fconfigure $r -blocking]
+} -cleanup {
+    $m destroy
+    close $null
+    close $r
+    close $w
+    unset m null
+} -result {A 1}
+
+# -------------------------------------------------------------------------
+testsuiteCleanup
+return

