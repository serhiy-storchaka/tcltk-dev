--- modules/term/receive.tcl
+++ modules/term/receive.tcl
@@ -15,18 +15,28 @@
 proc ::term::receive::getch {{chan stdin}} {
     return [read $chan 1]
 }
 
 proc ::term::receive::listen {cmd {chan stdin}} {
+    variable blocking
+    if {![info exists blocking($chan)]} {
+	set blocking($chan) [fconfigure $chan -blocking]
+    }
     fconfigure $chan -blocking 0
     fileevent  $chan readable \
 	    [list ::term::receive::Foreach $chan $cmd]
     return
 }
 
 proc ::term::receive::unlisten {{chan stdin}} {
+    variable blocking
     fileevent $chan readable {}
+    # Restore the blocking mode the channel had before listening.
+    if {[info exists blocking($chan)]} {
+	fconfigure $chan -blocking $blocking($chan)
+	unset blocking($chan)
+    }
     return
 }
 
