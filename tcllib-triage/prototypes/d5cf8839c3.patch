+#############################################################################
+#
+# StartPut --
+#
+# Starts sending data over the data connection, once both the data
+# connection is open (InitDataConn) and the server has accepted the
+# STOR or APPE command (states put_sent, append_sent).
+#
+# Arguments:
+# s -		ftp connection handle
+
+proc ::ftp::StartPut {s} {
+    upvar ::ftp::ftp$s ftp
+
+    if {[info exists ftp(PutHandler)]} {
+        fileevent [lindex $ftp(PutHandler) end] writable $ftp(PutHandler)
+        unset ftp(PutHandler)
+    }
+    return
+}
 
