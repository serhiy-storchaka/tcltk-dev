 # ::ncgi::encode
 #
-#	This encodes data in www-url-encoded format.
+#	This encodes data in www-url-encoded format.  Characters are
+#	converted to UTF-8 first, then every non-alphanumeric byte is
+#	replaced by %HH.
 #
 # Arguments:
 #	A string
 #
 # Results:
@@ -292,15 +294,17 @@
 #	The encoded value
 
 proc ::ncgi::encode {string} {
     variable map
 
+    # 0 convert to UTF-8, so only byte values 0-255 remain
     # 1 leave alphanumerics characters alone
     # 2 Convert every other character to an array lookup
     # 3 Escape constructs that are "special" to the tcl parser
     # 4 "subst" the result, doing all the array substitutions
 
+    set string [encoding convertto utf-8 $string]
     regsub -all -- \[^a-zA-Z0-9\] $string {$map(&)} string
     # This quotes cases like $map([) or $map($) => $map(\[) ...
     regsub -all -- {[][{})\\]\)} $string {\\&} string
     set string [string map {$map(() $map(\\()} $string]
     return [subst -nocommand $string]

