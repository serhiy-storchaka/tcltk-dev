--- modules/websocket/websocket.test
+++ modules/websocket/websocket.test
@@ -1,8 +1,9 @@
 # websocket.test - Copyright (c) 2022 Keith Nash
 #
-# The tests use the WebSocket Echo Server hosted at ws.ifelse.io.
+# The tests use a local WebSocket echo server that mimics the one hosted at
+# ws.ifelse.io: it greets each connection and echoes text messages.
 # ------------------------------------------------------------------------------
 
 source [file join \
 	[file dirname [file dirname [file join [pwd] [info script]]]] \
 	devtools testutilities.tcl]
@@ -70,11 +71,43 @@
 set wsNum 0
 
 # Set the test URL.
 # The value of expectNum, and some of the result strings, depend on the
 # server configuration and therefore on the URL.
-set wsUrl ws://ws.ifelse.io
+proc wsSrvHandler {sock type msg} {
+    switch -- $type {
+        connect {::websocket::send $sock text "Request served by local"}
+        text    {::websocket::send $sock text $msg}
+    }
+}
+
+proc wsSrvRead {sock} {
+    upvar #0 ::wsSrvKey($sock) key
+    while {[gets $sock line] >= 0} {
+        if {[regexp -nocase {^Sec-WebSocket-Key:\s*(\S+)} $line -> k]} {
+            set key $k
+        } elseif {$line eq ""} {
+            fileevent $sock readable {}
+            puts $sock "HTTP/1.1 101 Switching Protocols\nUpgrade: websocket\nConnection: Upgrade\nSec-WebSocket-Accept: [::websocket::sec-websocket-accept $key]\n"
+            flush $sock
+            unset key
+            ::websocket::takeover $sock wsSrvHandler 1
+            return
+        }
+    }
+    if {[eof $sock]} {
+        close $sock
+        unset -nocomplain key
+    }
+}
+
+set wsSrv [socket -server [list apply {{sock addr port} {
+    set ::wsSrvKey($sock) ""
+    fconfigure $sock -translation crlf -blocking 0
+    fileevent $sock readable [list wsSrvRead $sock]
+}}] -myaddr 127.0.0.1 0]
+set wsUrl ws://127.0.0.1:[lindex [fconfigure $wsSrv -sockname] 2]
 set expectNum 2
 
 test example-1.1 "Open a websocket" -constraints {} -setup {
     wsResetSleep
     wsResetHandler
@@ -188,10 +221,14 @@
     wsResetSleep
     wsResetHandler
 } -match exact -result {SOCKET text {Hello this is message NUMBER}
 }
 
+close $wsSrv
+rename wsSrvHandler {}
+rename wsSrvRead {}
+
