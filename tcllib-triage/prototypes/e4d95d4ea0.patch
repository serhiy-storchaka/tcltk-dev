+######## Bug e4d95d4ea0: -default and -multiple: provided values replace the default ########
+
+   tepam::procedure Procedure_multiple_default_named {
+      -args {{-Arg -default Def -multiple}}
+   } {return $Arg}
+
+   tepam::procedure Procedure_multiple_default_unnamed {
+      -named_arguments_first 0
+      -args {{Arg -default Def -multiple}}
+   } {return $Arg}
+
+   test tepam-bug_fixes.bug-e4d95d4ea0.1 "Bug fixes, e4d95d4ea0, named, no value"  \
+      -body {Procedure_multiple_default_named} -result {Def}
+   test tepam-bug_fixes.bug-e4d95d4ea0.2 "Bug fixes, e4d95d4ea0, named, one value"  \
+      -body {Procedure_multiple_default_named -Arg a} -result {a}
+   test tepam-bug_fixes.bug-e4d95d4ea0.3 "Bug fixes, e4d95d4ea0, named, two values"  \
+      -body {Procedure_multiple_default_named -Arg a -Arg {b c}} -result {a {b c}}
+   test tepam-bug_fixes.bug-e4d95d4ea0.4 "Bug fixes, e4d95d4ea0, unnamed, no value"  \
+      -body {Procedure_multiple_default_unnamed} -result {Def}
+   test tepam-bug_fixes.bug-e4d95d4ea0.5 "Bug fixes, e4d95d4ea0, unnamed, two values"  \
+      -body {Procedure_multiple_default_unnamed a {b c}} -result {a {b c}}
+
 ######## That's all ########
 
