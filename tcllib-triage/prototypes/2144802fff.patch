+test from-1.3 {option names only at even positions, last one wins} -body {
+    type dog {
+        option -foo FOO
+        option -bar BAR
+        option -args
+
+        constructor {args} {
+            $self configure -bar [from args -bar xyzzy]
+            $self configure -foo [from args -foo]
+            $self configure -args $args
+        }
+    }
