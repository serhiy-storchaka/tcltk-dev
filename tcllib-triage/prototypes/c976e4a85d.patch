--- modules/zip/encode.test
+++ modules/zip/encode.test
@@ -40,10 +40,40 @@
 
 tcltest::removeDirectory foo
 
 set externalZipFile [file join [file dirname [info script]] zipFileForTests.zip]
 tcltest::testConstraint GotZipFile [file exists $externalZipFile]
+
+# -------------------------------------------------------------------------
+# Write a minimal zip archive (stored entries only) with full control
+# over the "version made by" and "external attributes" fields, to test
+# how zipfile::decode handles archives made by other tools.
+# entries = list of {name data vmb efattr}
+
+proc mkTestZip {path entries} {
+    set local {}
+    set central {}
+    foreach e $entries {
+        lassign $e name data vmb efattr
+        set crc [zlib crc32 $data]
+        set len [string length $data]
+        set offset [string length $local]
+        append local [binary format a4sssssiiiss PK\03\04 \
+                          20 0 0 0 0x21 $crc $len $len \
+                          [string length $name] 0] $name $data
+        append central [binary format a4ssssssiiisssssii PK\01\02 \
+                            $vmb 20 0 0 0 0x21 $crc $len $len \
+                            [string length $name] 0 0 0 0 $efattr $offset] $name
+    }
+    set n [llength $entries]
+    set ch [open $path wb]
+    puts -nonewline $ch $local$central
+    puts -nonewline $ch [binary format a4ssssiis PK\05\06 0 0 $n $n \
+                             [string length $central] [string length $local] 0]
+    close $ch
+    return
+}
 
