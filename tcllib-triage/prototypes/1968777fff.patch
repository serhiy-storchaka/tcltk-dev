Index: modules/doctools/checker.tcl
==================================================================
--- modules/doctools/checker.tcl
+++ modules/doctools/checker.tcl
@@ -22,10 +22,22 @@
 } else {
     foreach path [dt_search] {
 	::msgcat::mcload $path
     }
 }
+
+# Use the C messages as the root locale catalog, the fallback for
+# locales without a catalog of their own, or with an incomplete one.
+# Note: [file] is a formatting command here, avoid it.
+foreach path [dt_search] {
+    if {[catch {open $path/c.msg} chan]} continue
+    fconfigure $chan -encoding utf-8
+    set msgs [read $chan]
+    close $chan
+    uplevel #0 [string map {{mcset c } {mcset {} }} $msgs]
+}
+unset -nocomplain path chan msgs
 
