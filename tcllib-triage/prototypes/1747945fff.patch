+test profiler-12.0-tkt-1747945fff {profiler state does not grow with the number of calls} {
+    do {
+	proc ::foo {} {}
+	proc size {} {
+	    set n 0
+	    foreach v [info vars ::profiler::*] {
+		if {![array exists $v]} continue
+		foreach {k val} [array get $v] {incr n [llength $val]}
+	    }
+	    return $n
+	}
+	foo ; foo ; size ; # size is profiled too
+	set before [size]
+	for {set i 0} {$i < 100} {incr i} foo
+	expr {[size] - $before}
+    }
+} 0
+
+test profiler-12.1-tkt-1747945fff {statistics from sums match statistics from values} {
+    do {
+	set vals {3 5 8 13 21 34}
+	set sum 0 ; set sumsq 0
+	foreach v $vals {incr sum $v ; incr sumsq [expr {$v*$v}]}
+	list [profiler::stats {*}$vals] \
+	    [profiler::StatsFromSums [llength $vals] $sum $sumsq]
+    }
+} {{14 12 85.7} {14 12 85.7}}
 
