+
+# ::profiler::StatsFromSums --
+#
+#	Same as stats, but computed from the number of values, their sum
+#	and the sum of their squares, so the individual values need not
+#	be kept around.
+#
+# Arguments:
+#	N	Number of values.
+#	sum	Sum of the values.
+#	sumsq	Sum of the squares of the values.
+#
+# Results:
+#	A list with three elements:  the mean, the standard deviation, and the
+#	covariance.
+
+proc ::profiler::StatsFromSums {N sum sumsq} {
+    set mean  0
+    set sigma 0
+    set cov   0
+    if { $N > 1 && $sum > 0 } {
+	set mean [ expr { $sum/$N } ]
+	# sum((v-mean)^2) = sumsq - 2*mean*sum + N*mean^2
+	set sigma_sq [ expr { double($sumsq - 2*$mean*$sum + $N*$mean*$mean)/($N-1) } ]
+	set sigma [ expr { round(sqrt($sigma_sq)) } ]
+	if { $mean != 0 } {
+	    set cov [ expr { (($sigma*1.0)/$mean)*100 } ]
+	    set cov [ expr { round($cov*10)/10.0 } ]
+	}
+    }
+    return [ list $mean $sigma $cov ]
+}
 
