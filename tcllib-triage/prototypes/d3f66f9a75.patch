+test mime-18.1 {ticket d3f66f9a75: trailing encoded space in Q encoded word} {
+    mime::field_decode [join {
+	=?UTF-8?Q?Neuer_SPD-Generalsekret=C3=A4r_?=
+	=?UTF-8?Q?Kl=C3=BCssendorf_warnt_Union_vor_?=
+	=?UTF-8?Q?Konflikt_bei_Migration?=
+    } "\r\n "]
+} "Neuer SPD-Generalsekret\u00e4r Kl\u00fcssendorf warnt Union vor Konflikt bei Migration"
+
+test mime-18.2 {ticket d3f66f9a75: trailing encoded space in Q encoded word} {
+    list [mime::word_decode =?US-ASCII?Q?a_?=] \
+	[mime::field_decode "=?US-ASCII?Q?a__?= =?US-ASCII?Q?b?="]
+} {{ascii quoted-printable {a }} {a  b}}
 
