--- modules/snit/snit.test
+++ modules/snit/snit.test
@@ -4115,10 +4115,29 @@
     dog create spot -foo quux -baz frobnitz -bar frobozz
     list [spot cget -foo] [spot cget -bar] [spot cget -args]
 } -cleanup {
     dog destroy
 } -result {quux frobozz {-baz frobnitz}}
+
+test option-default-1.1 {definition can't see caller's variables} -body {
+    set ::snitTestDefault 1234
+    type dog {
+        option -foo -default $::snitTestDefault
+    }
+} -cleanup {
+    unset ::snitTestDefault
+} -returnCodes error -result {can't read "::snitTestDefault": no such variable}
+
+test option-default-1.2 {caller's variables substituted into definition} -body {
+    set ::snitTestDefault 1234
+    type dog [list option -foo -default $::snitTestDefault]
+    dog create spot
+    spot cget -foo
+} -cleanup {
+    dog destroy
+    unset ::snitTestDefault
+} -result 1234
 
