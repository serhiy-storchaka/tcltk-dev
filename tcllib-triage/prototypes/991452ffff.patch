Index: modules/ftp/ftp.test
==================================================================
--- /dev/null
+++ modules/ftp/ftp.test
@@ -0,0 +1,61 @@
+# -*- tcl -*-
+# ftp.test:  tests for the ftp client.
+#
+# The server side of the control connection is a programmed dialog
+# running in a separate process (devtools/dialog.tcl).
+
+# -------------------------------------------------------------------------
+
+source [file join \
+	[file dirname [file dirname [file join [pwd] [info script]]]] \
+	devtools testutilities.tcl]
+
+testsNeedTcl     8.5
+testsNeedTcltest 1.0
+
+support {
+    use           log/log.tcl   log
+    useTcllibFile devtools/coserv.tcl ; # loads comm, snit too!
+    useTcllibFile devtools/dialog.tcl
+}
+testing {
+    useLocal ftp.tcl ftp
+}
+
+# -------------------------------------------------------------------------
+# Server processes. Programmed dialogs, server side.
+
+dialog::setup server {Ftp Fake Server}
+
+# Silence the error messages of the package.
+proc ::ftp::DisplayMsg {s msg {state ""}} {}
+
+proc login {} {
+    dialog::crlf.
+    dialog::send.    {220 localhost fake FTP server ready.}
+    dialog::respond. {331 Password required.}
+    dialog::respond. {230 Logged in.}
+    dialog::respond. {200 Type set to I.}
+}
+
+proc ftpopen {args} {
+    ftp::Open 127.0.0.1 user pass -port [dialog::listener] {*}$args
+}
+
+# -------------------------------------------------------------------------
+
+test ftp-quote-1.0 {Quote sends arguments joined by spaces, ticket 991452} -body {
+    dialog::dialog_set {
+	login
+	dialog::respond. {200 SITE command okay.}
+	dialog::respond. {221 Goodbye.}
+    }
+    set h [ftpopen]
+    set res [ftp::Quote $h SITE {CHMOD 644} {my file}]
+    ftp::Close $h
+    list $res [lsearch -inline -glob [dialog::waitdone] {<< *SITE*}]
+} -result {{200 SITE command okay.} {<< {SITE CHMOD 644 my file}}}
+
+# -------------------------------------------------------------------------
+dialog::shutdown
+testsuiteCleanup

