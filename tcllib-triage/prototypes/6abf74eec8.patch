Index: modules/md5crypt/md5crypt.test
--- modules/md5crypt/md5crypt.test
+++ modules/md5crypt/md5crypt.test
@@ -140,6 +140,27 @@
 }
 
 # -------------------------------------------------------------------------
+## Non-ASCII passwords are hashed as UTF-8 (results from openssl passwd).
+
+foreach {n magic passwd expected} [list \
+    1 {$1$}    "\u043f\u0430\u0440\u043e\u043b\u044c" {$1$abcdefgh$QfFdDZYjOC5k44ZZ.ueGu0} \
+    2 {$apr1$} "\u043f\u0430\u0440\u043e\u043b\u044c" {$apr1$abcdefgh$bGw12bsJudNfTmc4FpOJo.} \
+    3 {$1$}    "p\u00e4ssw\u00f6rd"                     {$1$abcdefgh$xYuxUFvxUOR4Pd6a7EeUS0} \
+] {
+    test md5passwd-8.${n} {md5crypt non-ASCII passwd} {
+        if {$magic eq {$1$}} {
+            ::md5crypt::md5crypt $passwd abcdefgh
+        } else {
+            ::md5crypt::aprcrypt $passwd abcdefgh
+        }
+    } $expected
+
+    test md5passwd-9.${n}_tcl {md5crypt (pure-Tcl) non-ASCII passwd} {md5crypt_c} {
+        ::md5crypt::md5crypt_tcl $magic $passwd abcdefgh
+    } $expected
+}
+
+# -------------------------------------------------------------------------
 # -------------------------------------------------------------------------
 ## Non-standard salt, out of ASCII.
