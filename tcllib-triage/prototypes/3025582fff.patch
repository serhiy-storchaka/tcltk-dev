--- modules/inifile/inifile.test
+++ modules/inifile/inifile.test
@@ -232,10 +232,55 @@
 test inifile-5.4 {ini::revert} {
     set res [ini::open $testini r]
     ini::revert $res
     ini::close $res
 } {}
+
+#---------------------------------------------------------------------
+
+test inifile-6.0 {bug 3025582 - commit keeps order and comments} -setup {
+    set f [makeFile {; top comment
+
+[zeta]
+a=1
+; after zeta
+
+[alpha]
+z=1
+b=2
+[mid]
+x=1
+; trailing comment} order.ini]
+} -body {
+    set fh [ini::open $f]
+    ini::set $fh alpha a 3
+    ini::set $fh new k v
+    ini::commit $fh
+    ini::close $fh
+    viewFile $f
+} -cleanup {
+    removeFile order.ini
+    unset f fh
+} -result {; top comment
+
+[zeta]
+a=1
+
+; after zeta
+
+[alpha]
+z=1
+b=2
+a=3
+
+[mid]
+x=1
+
+[new]
+k=v
+
+; trailing comment}
 
 #---------------------------------------------------------------------
