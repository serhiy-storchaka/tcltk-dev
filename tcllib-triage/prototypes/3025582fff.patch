+
+# internal commands to record sections and keys in creation order
+
+proc ::ini::_addsection {fh sec} {
+    variable ::ini::${fh}::sections
+    variable ::ini::${fh}::seq
+    if { ![info exists sections($sec)] } {
+	::set sections($sec) [incr seq]
+    }
+}
+
+proc ::ini::_addkey {fh sec key value} {
+    variable ::ini::${fh}::data
+    variable ::ini::${fh}::order
+    variable ::ini::${fh}::seq
+    if { ![info exists order($sec\000$key)] } {
+	::set order($sec\000$key) [incr seq]
+    }
+    ::set data($sec\000$key) $value
+}
+
+# internal command, returns the names of a name/ordinal list, sorted by ordinal
+
+proc ::ini::_ordered {pairs} {
+    ::set l {}
+    foreach {name n} $pairs { lappend l [list $n $name] }
+    ::set r {}
+    foreach p [lsort -integer -index 0 $l] { lappend r [lindex $p 1] }
+    return $r
+}
 
 # internal command to escape glob special characters
 
 proc ::ini::_globescape {string} {
     return [string map {* \\* ? \\? \\ \\\\ \[ \\\[ \] \\\]} $string]
