Index: modules/snit/snit.test
==================================================================
--- modules/snit/snit.test
+++ modules/snit/snit.test
@@ -9104,10 +9104,31 @@
 
     mywidget .mylabel
 } -cleanup {
     destroy .mylabel
 } -result {.mylabel}
+
+test bug-5.1 {Ticket 1397543fff: mymethod keeps all return options} -constraints {
+    snit2
+} -body {
+    type dog {
+        method fail {} {
+            return -code error -errorcode {DOG FAIL} -custom yes failed
+        }
+        method brk {} { return -code break }
+        method five {} { return -code 5 five }
+        method cb {name} { mymethod $name }
+    }
+    dog spot
+    set rc [catch {{*}[spot cb fail]} msg opts]
+    set result [list $rc $msg [dict get $opts -errorcode] [dict get $opts -custom]]
+    set n 0
+    while 1 { incr n; {*}[spot cb brk]; set n bad }
+    lappend result $n [catch {{*}[spot cb five]} msg] $msg
+} -cleanup {
+    dog destroy
+} -result {1 failed {DOG FAIL} yes 1 5 five}
 
 
