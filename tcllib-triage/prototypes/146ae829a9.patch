+
+# Ticket [146ae829a9]: [parse file] used "-encoding binary", rejected by Tcl 9.
+
+TestFilesProcess $mytestdir ok in out -> n label input data expected {
+    test doctools-tcl-parse-${stkimpl}-${setimpl}-${impl}-13.$n "doctools::tcl::parse file, $label, ok" -setup {
+	struct::tree myresult
+    } -body {
+	doctools::tcl::parse file myresult $input
+	set res {}
+	myresult walk root tok {
+	    lappend res "[string repeat {....} [myresult depth $tok]]$tok ([dictsort [myresult getall $tok]])"
+	}
+	join $res \n
+    } -cleanup {
+	myresult destroy
+    } -result $expected
+}
 
