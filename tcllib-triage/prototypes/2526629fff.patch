     } [list 0 $check]
 }
+
+# -------------------------------------------------------------------------
+# SPF record lookup. The DNS query is emulated by replacing Resolve.
+
+proc ::spf::TestResolve {args} {
+    set result {}
+    foreach txt $args {
+        lappend result [list name email.example.com type TXT class IN \
+                            ttl 60 rdlength [string length $txt] rdata $txt]
+    }
+    rename ::spf::Resolve ::spf::tmp_Resolve
+    proc ::spf::Resolve {domain type resultproc} [list return $result]
+}
+proc ::spf::TestResolveCleanup {} {
+    rename ::spf::Resolve {}
+    rename ::spf::tmp_Resolve ::spf::Resolve
+}
+
+test spf-7.1 {SPF record lookup} -setup {
+    ::spf::TestResolve "v=spf1 ip4:192.0.2.0/24 -all"
+} -body {
+    ::spf::tmp_SPF email.example.com
+} -cleanup {
+    ::spf::TestResolveCleanup
+} -result {v=spf1 ip4:192.0.2.0/24 -all}
+
+test spf-7.2 {SPF record lookup: other TXT records are ignored} -setup {
+    ::spf::TestResolve "google-site-verification=abc" \
+        "v=spf1 ip4:192.0.2.0/24 -all" "v=spf10 -all"
+} -body {
+    ::spf::tmp_SPF email.example.com
+} -cleanup {
+    ::spf::TestResolveCleanup
+} -result {v=spf1 ip4:192.0.2.0/24 -all}
+
+test spf-7.3 {SPF record lookup: no SPF record} -setup {
+    ::spf::TestResolve "google-site-verification=abc"
+} -body {
+    ::spf::tmp_SPF email.example.com
+} -cleanup {
+    ::spf::TestResolveCleanup
+} -result none
+
+test spf-7.4 {SPF record lookup: multiple SPF records} -setup {
+    ::spf::TestResolve "v=spf1 -all" "v=spf1 +all"
+} -body {
+    ::spf::tmp_SPF email.example.com
+} -cleanup {
+    ::spf::TestResolveCleanup
+} -returnCodes error -result {multiple SPF records for "email.example.com"}
 
