 # 3.4: Record lookup
 proc ::spf::SPF {domain} {
+    variable log
     set txt ""
     if {[catch {Resolve $domain SPF ::dns::result} spf]} {
         set code $::errorCode
-        ${log}::debug "error fetching SPF record: $r"
+        ${log}::debug "error fetching SPF record: $spf"
         switch -exact -- $code {
             3 { return -code return [list - "Domain Does Not Exist"] }
             2 { return -code error -errorcode temporary $spf }
         }
         set txt none
     } else {
+        # 4.5: Discard the TXT records which are not SPF records.
+        set records {}
         foreach res $spf {
             set ndx [lsearch $res rdata]
             incr ndx
             if {$ndx != 0} {
-                append txt [string range [lindex $res $ndx] 1 end]
+                set rdata [lindex $res $ndx]
+                if {[regexp -nocase {^v=spf1( |$)} $rdata]} {
+                    lappend records $rdata
+                }
+            }
+        }
+        switch -exact -- [llength $records] {
+            0 { set txt none }
+            1 { set txt [lindex $records 0] }
+            default {
+                return -code error -errorcode permanent \
+                    "multiple SPF records for \"$domain\""
             }
         }
     }
     return $txt
 }

