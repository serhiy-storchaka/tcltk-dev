@@ -554,11 +554,18 @@
     set f [open "|[list $::tcltest::tcltest test1]" r+]
     set res [read $f]
     close $f
     removeFile test1
     set res
-} "Content-Type: text/html\nSet-Cookie: Name=The+Value ;\n\n"
+} "Content-Type: text/html\nSet-Cookie: Name=The+Value\n\n"
+
+test ncgi-12.5 {ncgi::setCookie, attribute syntax, tkt 2440373} {
+    ncgi::reset
