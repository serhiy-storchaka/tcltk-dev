+# -*- tcl -*-
+# coro_auto.test - Tests for coroutine::auto
+
+# -------------------------------------------------------------------------
+
+source [file join \
+	[file dirname [file dirname [file join [pwd] [info script]]]] \
+	devtools testutilities.tcl]
+
+testsNeedTcl     8.6
+testsNeedTcltest 2
+
+testing {
+    useLocal coroutine.tcl coroutine
+    useLocal coro_auto.tcl coroutine::auto
+}
+
+# -------------------------------------------------------------------------
+
+test coro-auto-global-1.0 {global of Tcl-owned variables in a coroutine, ticket cd4fe2d047} -setup {
+    proc t1 {} {
+	yield
+	apply {{} {
+	    global env auto_path tcl_platform
+	    list [info exists env] [info exists auto_path] [info exists tcl_platform(os)]
+	}}
+    }
+    coroutine cor_foo t1
+} -body {
+    cor_foo
+} -cleanup {
+    rename t1 {}
+} -result {1 1 1}
+
+test coro-auto-global-1.1 {global of qualified name in a coroutine, ticket cd4fe2d047} -setup {
+    set ::coro_auto_test_var X
+    proc t1 {} {
+	yield
+	apply {{} {
+	    global ::coro_auto_test_var
+	    set coro_auto_test_var
+	}}
+    }
+    coroutine cor_foo t1
+} -body {
+    cor_foo
+} -cleanup {
+    rename t1 {}
+    unset -nocomplain ::coro_auto_test_var
+} -result X
+
+test coro-auto-global-1.2 {other globals stay coroutine-local} -setup {
+    unset -nocomplain ::coro_auto_test_var
+    proc t1 {} {
+	set coro_auto_test_var [info coroutine]
+	yield
+	apply {{} {
+	    global coro_auto_test_var
+	    set coro_auto_test_var
+	}}
+    }
+    coroutine cor_a t1
+    coroutine cor_b t1
+} -body {
+    list [cor_a] [cor_b] [info exists ::coro_auto_test_var]
+} -cleanup {
+    rename t1 {}
+} -result {::cor_a ::cor_b 0}
+
+test coro-auto-global-1.3 {auto_load works in a coroutine, ticket cd4fe2d047} -setup {
+    set dir [makeDirectory coroautolib]
+    set f [open [file join $dir tclIndex] w]
+    puts $f "# Tcl autoload index file, version 2.0"
+    puts $f "set auto_index(coro_auto_test_cmd) \[list proc coro_auto_test_cmd {} {return ok}\]"
+    close $f
+    set saved $::auto_path
+    lappend ::auto_path $dir
+    auto_reset
+    proc t1 {} {
+	yield
+	coro_auto_test_cmd
+    }
+    coroutine cor_foo t1
+} -body {
+    cor_foo
+} -cleanup {
+    rename t1 {}
+    catch {rename coro_auto_test_cmd {}}
+    set ::auto_path $saved
+    auto_reset
+    removeDirectory coroautolib
+    unset dir f saved
+} -result ok
+
+# -------------------------------------------------------------------------
+testsuiteCleanup
+return

