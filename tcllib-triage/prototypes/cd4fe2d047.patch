Index: modules/coroutine/coro_auto.tcl
==================================================================
--- modules/coroutine/coro_auto.tcl
+++ modules/coroutine/coro_auto.tcl
@@ -35,11 +35,32 @@
 proc ::coroutine::auto::wrap_global args {
     if {[info coroutine] eq {}} {
 	tailcall ::coroutine::auto::core_global {*}$args
     }
 
-    tailcall ::coroutine::util::global {*}$args
+    # Qualified names and the variables owned by Tcl itself (env,
+    # auto_path, auto_index, tcl_platform, ...) always refer to the
+    # true globals. Redirecting them to the coroutine frame breaks
+    # the library code using them, like auto_load or msgcat
+    # (Ticket [cd4fe2d047]).
+    set real {}
+    set coro {}
+    foreach var $args {
+	if {[string match *::* $var] ||
+	    [regexp {^(env|errorInfo|errorCode|argc|argv|argv0|(auto|tcl|tk)_.*)$} $var]} {
+	    lappend real $var
+	} else {
+	    lappend coro $var
+	}
+    }
+    if {[llength $real]} {
+	uplevel 1 [list ::coroutine::auto::core_global {*}$real]
+    }
+    if {[llength $coro]} {
+	tailcall ::coroutine::util::global {*}$coro
+    }
+    return
 }
 
