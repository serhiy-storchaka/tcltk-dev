--- modules/fileutil/fileutil.tcl
+++ modules/fileutil/fileutil.tcl
@@ -494,12 +494,17 @@
     } else {
 	# The path is relative, consider it as outside
 	# implicitly. Normalize it lexically! to prevent escapes, then
 	# put the jail in front, use PWD to ensure absoluteness.
 
-	return [eval [linsert [file split [lexnormalize $filename]] 0 \
-		file join [pwd] $jail]]
+	# Leading ..'s are kept by lexnormalize, drop them.
+
+	set np [file split [lexnormalize $filename]]
+	while {[string equal [lindex $np 0] ".."]} {
+	    set np [lrange $np 1 end]
+	}
+	return [eval [linsert $np 0 file join [pwd] $jail]]
     }
 }
 
 
