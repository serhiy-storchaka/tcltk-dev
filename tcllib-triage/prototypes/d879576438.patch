--- modules/nettool/build/core.tcl
+++ modules/nettool/build/core.tcl
@@ -44,10 +44,30 @@
 
 
 set here [file dirname [file normalize [info script]]]
 
 ::namespace eval ::nettool {}
+
+###
+# Run a system tool which may live in an sbin directory that is
+# not in the PATH of ordinary users (ifconfig, arp).
+###
+proc ::nettool::sbin_exec {cmd args} {
+  set path [auto_execok $cmd]
+  if {$path eq {}} {
+    foreach dir {/sbin /usr/sbin /usr/local/sbin} {
+      if {[file executable [file join $dir $cmd]]} {
+        set path [list [file join $dir $cmd]]
+        break
+      }
+    }
+  }
+  if {$path eq {}} {
+    set path [list $cmd]
+  }
+  return [exec {*}$path {*}$args]
+}
 
 set genus [lindex [split [::platform::generic] -] 0]
