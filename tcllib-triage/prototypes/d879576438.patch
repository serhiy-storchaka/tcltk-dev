Index: modules/nettool/nettool.test
==================================================================
--- modules/nettool/nettool.test
+++ modules/nettool/nettool.test
@@ -93,9 +93,31 @@
     [list ::nettool::allocate_port 7790] 7791
 
 ::tcltest::test port-allocate-0006 \
     "Test allocate port returns the next address of an claimed spot and claims it" \
     [list ::nettool::allocate_port 7790] 7792
+
+# Ticket d879576438: ifconfig lives in /sbin or /usr/sbin, which is not
+# in the PATH of ordinary users on many systems.
+::tcltest::testConstraint sbinIfconfig [expr {
+    $::tcl_platform(os) eq "Linux"
+    && ([file executable /sbin/ifconfig] || [file executable /usr/sbin/ifconfig])
+    && ![file executable /usr/bin/ifconfig]
+}]
+
+::tcltest::test dump-sbin-path {dump finds ifconfig outside of PATH} \
+    -constraints sbinIfconfig -setup {
+	set savedpath $::env(PATH)
+	set ::env(PATH) /usr/bin:/bin
+	array unset ::auto_execs ifconfig
+    } -body {
+	catch {::nettool::dump} msg
+	string match {*couldn't execute*} $msg
+    } -cleanup {
+	set ::env(PATH) $savedpath
+	array unset ::auto_execs ifconfig
+	unset savedpath msg
+    } -result 0
 
 
 testsuiteCleanup
 return

