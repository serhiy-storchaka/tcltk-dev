--- modules/pluginmgr/pluginmgr.tcl
+++ modules/pluginmgr/pluginmgr.tcl
@@ -127,15 +127,19 @@
 		\[ \\\[ \] \\\]   \
 		(  \\(  )  \\)    \
 		. \\. \*  {(.*)} \
 		] $options(-pattern)]
 
+	# Force a scan of the package database. Derive the name of the
+	# bogus package from the pattern, so that Tcl modules living in
+	# the subdirectories the pattern refers to are found too.
 	# @mdgen NODEP: bogus-package
-	$sip eval {catch {package require bogus-package}}
+	set bogus [string map {* bogus-package} $options(-pattern)]
+	$sip eval [list catch [list package require $bogus]]
 	foreach p [$sip eval {package names}] {
-	    if {![regexp $pattern $p -> plugin]} continue
-	    lappend result $plugin
+	    if {![regexp $pattern $p -> name]} continue
+	    lappend result $name
 	}
 
 	interp delete $sip
 	set sip $save
 	return $result

