Index: modules/snit/snit.test
==================================================================
--- modules/snit/snit.test
+++ modules/snit/snit.test
@@ -6392,10 +6392,52 @@
 
     list $result [string match "*bogusInfo*" $errorInfo] $errorCode
 } -cleanup {
     dog destroy
 } -result {{Error in constructor: bogusError} 1 bogusCode}
+
+test error-1.3a {destructor error does not hide constructor error} -body {
+    type dog {
+        constructor {} {
+            error bogusError bogusInfo bogusCode
+        }
+        destructor {
+            error dtorError
+        }
+    }
+
+    catch {dog fido} result
+
+    global errorInfo errorCode
+
+    list $result [string match "*bogusInfo*dtorError*" $errorInfo] $errorCode \
+        [info commands ::fido] [dog info instances]
+} -cleanup {
+    dog destroy
+} -result {{Error in constructor: bogusError} 1 bogusCode {} {}}
+
+test error-1.3b {destructor error does not hide widget constructor error} -constraints {
+    tk
+} -body {
+    widget dog {
+        constructor {args} {
+            error bogusError bogusInfo bogusCode
+        }
+        destructor {
+            error dtorError
+        }
+    }
+
+    catch {dog .fido} result
+
+    global errorInfo errorCode
+
+    list $result [string match "*bogusInfo*dtorError*" $errorInfo] $errorCode \
+        [winfo exists .fido] [info commands .fido] [dog info instances]
+} -cleanup {
+    dog destroy
+} -result {{Error in constructor: bogusError} 1 bogusCode 0 {} {}}
 
