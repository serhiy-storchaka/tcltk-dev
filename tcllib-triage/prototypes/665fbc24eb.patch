--- modules/snit/main1.tcl
+++ modules/snit/main1.tcl
@@ -2088,11 +2088,16 @@
         global errorInfo
         global errorCode
 
         set theInfo $errorInfo
         set theCode $errorCode
-        ::snit::RT.DestroyObject $type $selfns $name
+        # An error in the destructor must not hide the error in
+        # the constructor; add it to the error info instead.
+        if {[catch {::snit::RT.DestroyObject $type $selfns $name} dresult]} {
+            append theInfo "\n    (while destroying the object\n" \
+                "    after the error in the constructor):\n" $::errorInfo
+        }
         error "Error in constructor: $result" $theInfo $theCode
     }
 
     # NEXT, return the object's name.
     return $name
@@ -2190,11 +2195,16 @@
