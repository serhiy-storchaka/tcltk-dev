Index: modules/snit/snit.test
==================================================================
--- modules/snit/snit.test
+++ modules/snit/snit.test
@@ -9104,10 +9104,30 @@
 
     mywidget .mylabel
 } -cleanup {
     destroy .mylabel
 } -result {.mylabel}
+
+test bug-4.1 {Ticket 1390477fff: cache misses do not clobber errorInfo} -body {
+    type dog {
+        option -name rex
+        method bark {} { return woof }
+        typemethod tm {} { return 1 }
+    }
+    set result {}
+    foreach cmd {
+        {dog create spot} {spot bark} {spot cget -name}
+        {spot configure -name x} {dog tm} {spot destroy}
+    } {
+        catch {error original}
+        eval $cmd
+        lappend result [lindex [split $::errorInfo \n] 0]
+    }
+    lsort -unique $result
+} -cleanup {
+    dog destroy
+} -result {original}
 
 
