 #
 proc ::math::decimal::fromstr {string} {
     variable extended
 
     set string [string trim $string "'\""]
+
+    # Accept decimal notation only, with optional underscores between
+    # digits (TIP 551).
+    set re [string map [list D {\d(?:_*\d)*}] \
+		{^[-+]?(?:Inf|NaN|(?:D(?:\.(?:D)?)?|\.D)(?:[eE][-+]?D)?)$}]
+    if { ![regexp $re $string] } {
+	return -code error "expected a decimal number but got \"$string\""
+    }
+    set string [string map {_ ""} $string]
 
     if { [string range $string 0 0] == "-" } {
 	set sign 1
 	set string [string trimleft $string -]
 	incr pos -1
