--- modules/math/decimal.test
+++ modules/math/decimal.test
@@ -42,10 +42,30 @@
 # math::decimal::fromstr reports an error when the exponential part has leading zeros.
 test decimal-fromstr-1.1 "Correct conversion" {
     list [math::decimal::tostr [math::decimal::fromstr 1E-09]] \
          [math::decimal::tostr [math::decimal::fromstr 1E-009]]
 } {1E-9 1E-9}
+
+#
+# Ticket a316389e99: underscores in numbers (TIP 551) and invalid input.
+test decimal-fromstr-2.1 "Underscores between digits" {
+    list [math::decimal::compare [math::decimal::fromstr 1.000001] \
+	      [math::decimal::fromstr 1.000_001]] \
+	[math::decimal::tostr [math::decimal::fromstr 1_000]] \
+	[math::decimal::tostr [math::decimal::fromstr 1.5E1_0]]
+} {0 1000 1.5E+10}
+
+test decimal-fromstr-2.2 "Leading zeros are not octal" {
+    math::decimal::tostr [math::decimal::+ \
+	[math::decimal::fromstr 09] [math::decimal::fromstr 1]]
+} 10
+
+foreach {n str} {1 abc 2 0x10 3 1.2.3 4 12a 5 _1 6 1_ 7 1._5 8 {}} {
+    test decimal-fromstr-2.3.$n "Invalid input: \"$str\"" -body {
+	math::decimal::fromstr $str
+    } -returnCodes error -result "expected a decimal number but got \"$str\""
+}
 
