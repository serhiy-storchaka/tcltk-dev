+
+test counter-maxPer-1.0 {-maxPerMinute on non-timehist counter, ticket 1011096} {
+    counter::init hist -hist 20
+    list [catch {counter::get hist -maxPerMinute} msg] $msg
+} {1 {The -maxPerMinute option is only supported for -timehist counters.}}
+
+test counter-maxPer-1.1 {-maxPer* on timehist counter, ticket 1011096} {
+    counter::init hits -timehist 4
+    list [counter::get hits -maxPerMinute] [counter::get hits -maxPerHour] \
+	[counter::get hits -maxPerDay]
+} {0 0 0}
 
