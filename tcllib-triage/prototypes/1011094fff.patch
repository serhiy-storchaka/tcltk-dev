 #
 # Side Effects:
 #   Initializes state about a counter.
 
 proc ::counter::init {tag args} {
+    # The tag is used as part of variable names.
+    if {[string first :: $tag] >= 0 || [string match *(*) $tag]} {
+    return -code error "Invalid counter name \"$tag\":\
+        must not contain \"::\" or end with \"(...)\""
+    }
     upvar #0 counter::T-$tag counter
     if {[info exists counter]} {
     unset counter
     }
     set counter(N) 0    ;# Number of samples

