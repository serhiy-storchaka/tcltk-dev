+    regexp {package provide doctools::toc (\S+)} $data -> pv
+    expr {$pv eq $v}
+} -cleanup {
+    interp delete $i
+    unset -nocomplain i v f c data pv
+} -result 1
 
 #----------------------------------------------------------------------
 TestAccelExit struct::tree
 testsuiteCleanup
 return

