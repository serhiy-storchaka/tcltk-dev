     source [localPath tests/container_main]
 }
+
+test doctools-toc-pkgindex-1.0 {pkgIndex.tcl matches package provide, ticket 523f7e0556} -setup {
+    set i [interp create]
+} -body {
+    $i eval [list set dir [localDirectory]]
+    $i eval {source [file join $dir pkgIndex.tcl]}
+    set v [$i eval {package versions doctools::toc}]
+    set f [lindex [$i eval [list package ifneeded doctools::toc $v]] end]
+    set c [open $f]
