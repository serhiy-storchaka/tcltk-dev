--- modules/log/logger.test
+++ modules/log/logger.test
@@ -436,10 +436,44 @@
     ${log}::error "second error"
     ${log}::delete 
     rename errorlogproc ""
     list $msg $::INFO
 } {errorlogproc {{Error Message: error} {Error Message: second error}}}
+
+test logger-8.2.1 {logproc with command prefix, ticket 751707e0ae} -setup {
+    set ::INFO ""
+    set log [logger::init global]
+    proc errorlogproc {prefix txt} {
+        lappend ::INFO "$prefix: $txt"
+    }
+} -body {
+    ${log}::logproc error [list errorlogproc "Error Message"]
+    ${log}::error "error"
+    ${log}::error "second error"
+    list [${log}::logproc error] $::INFO
+} -cleanup {
+    ${log}::delete
+    rename errorlogproc ""
+    unset -nocomplain log ::INFO
+} -result {{errorlogproc {Error Message}} {{Error Message: error} {Error Message: second error}}}
+
+test logger-8.2.2 {logproc command inherited by child service} -setup {
+    set ::INFO ""
+    set log [logger::init global]
+    proc errorlogproc {txt} {
+        lappend ::INFO $txt
+    }
+    ${log}::logproc error errorlogproc
+    set child [logger::init global::child]
+} -body {
+    ${child}::error "child error"
+    set ::INFO
+} -cleanup {
+    ${log}::delete
+    rename errorlogproc ""
+    unset -nocomplain log child ::INFO
+} -result {{child error}}
 
