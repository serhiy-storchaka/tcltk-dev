 test yaml-21.2 "explicit_tags float" -body {
     set y {!!float 123=0}
     yaml::yaml2dict $y
 } -returnCodes error -result {expected floating-point number but got "123=0"}
 
+
+test yaml-30.1 "plain multi-line scalar longer than 5 lines, ticket a23348be0b" -body {
+    yaml::yaml2dict "my_thing:\n  one\n  two\n  three\n  four\n  five\n  six\n  seven\nnext: x\n"
+} -result {my_thing {one two three four five six seven} next x}
+
+test yaml-30.2 "very long plain multi-line scalar, ticket a23348be0b" -body {
+    set y "k:\n"
+    for {set i 0} {$i < 1500} {incr i} {append y "  w$i\n"}
+    set v [dict get [yaml::yaml2dict $y] k]
+    list [llength $v] [lindex $v end]
+} -result {1500 w1499}
+
+test yaml-30.3 "plain multi-line scalar with empty line" -body {
+    yaml::yaml2dict "k:\n  one\n  two\n\n  three\n  four\nnext: x\n"
+} -result {k {one two
+three four} next x}
 
