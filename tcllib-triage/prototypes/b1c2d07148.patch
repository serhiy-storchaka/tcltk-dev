 proc ::ip::version {ip} {
     set version -1
     if {[string equal $ip {}]} { return $version}
-    foreach {addr mask} [split $ip /] break
+    set parts [split $ip /]
+    if {[llength $parts] > 2} { return $version }
+    foreach {addr mask} $parts break
     if {[IPv4? $addr]} {
         set version 4
+        set maxbits 32
     } elseif {[IPv6? $addr]} {
         set version 6
+        set maxbits 128
+    } else {
+        return $version
+    }
+    # Validate the mask, if any: a number of bits or an address mask
+    if {[llength $parts] == 2} {
+        if {[string is digit -strict $mask]} {
+            if {[scan $mask %d bits] != 1 || $bits > $maxbits} {
+                return -1
+            }
+        } elseif {![IPv${version}? $mask]} {
+            return -1
+        }
     }
     return $version
 }
 
