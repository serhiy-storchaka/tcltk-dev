--- /dev/null
+++ modules/coroutine/coroutine.test
@@ -0,0 +1,130 @@
+# -*- tcl -*-
+# Tests for the coroutine module.
+#
+# Sourcing this file into Tcl runs the tests and generates output for
+# errors.  No output means no errors were found.
+
+source [file join \
+    [file dirname [file dirname [file join [pwd] [info script]]]] \
+    devtools testutilities.tcl]
+
+testsNeedTcl     8.6
+testsNeedTcltest 2.0
+
+testing {
+    useLocal coroutine.tcl coroutine
+}
+
+# -------------------------------------------------------------------------
+## Helpers. Run a script in a coroutine, wait for it to complete, and
+## return its outcome as a list of return code and result.
+
+proc runco {script} {
+    set ::outcome {}
+    coroutine::util create apply [list {script} {
+	set code [catch {uplevel #0 $script} result]
+	set ::outcome [list $code $result]
+    }] $script
+    set guard [after 5000 {set ::outcome hang}]
+    if {![llength $::outcome]} {vwait ::outcome}
+    after cancel $guard
+    return $::outcome
+}
+
+proc mkpipe {data} {
+    lassign [chan pipe] r w
+    chan configure $w -translation binary
+    chan configure $r -translation binary
+    puts -nonewline $w $data
+    flush $w
+    return [list $r $w]
+}
+
+# -------------------------------------------------------------------------
+## gets_safety. Ticket d638a04e5c.
+
+test coroutine-gets_safety-1.0 {short line, ensemble} -setup {
+    lassign [mkpipe "abc\n"] r w
+} -body {
+    runco [list coroutine::util gets_safety $r 10 ::line]
+} -cleanup {
+    close $r ; close $w
+} -result {0 3}
+
+test coroutine-gets_safety-1.1 {short line, variable} -setup {
+    lassign [mkpipe "abc\n"] r w
+} -body {
+    runco [list coroutine::util::gets_safety $r 10 ::line]
+    set ::line
+} -cleanup {
+    close $r ; close $w
+} -result abc
+
+test coroutine-gets_safety-1.2 {short line followed by much data} -setup {
+    lassign [mkpipe "abc\n[string repeat A 20000]\n"] r w
+} -body {
+    list [runco [list coroutine::util::gets_safety $r 10 ::line]] $::line
+} -cleanup {
+    close $r ; close $w
+} -result {{0 3} abc}
+
+test coroutine-gets_safety-1.3 {complete line too long} -setup {
+    lassign [mkpipe "[string repeat A 20000]\n"] r w
+} -body {
+    runco [list coroutine::util::gets_safety $r 10 ::line]
+} -cleanup {
+    close $r ; close $w
+} -result {1 {Too many notes, Mozart. Too many notes}}
+
+test coroutine-gets_safety-1.4 {incomplete line too long} -setup {
+    lassign [mkpipe [string repeat A 20000]] r w
+} -body {
+    runco [list coroutine::util::gets_safety $r 10 ::line]
+} -cleanup {
+    close $r ; close $w
+} -result {1 {Too many notes, Mozart. Too many notes}}
+
+test coroutine-gets_safety-1.5 {line at limit} -setup {
+    lassign [mkpipe "[string repeat A 10]\n"] r w
+} -body {
+    runco [list coroutine::util::gets_safety $r 10 ::line]
+} -cleanup {
+    close $r ; close $w
+} -result {0 10}
+
+test coroutine-gets_safety-1.6 {line split over writes} -setup {
+    lassign [mkpipe "ab"] r w
+    after 50 [list puts $w "c"]
+    after 60 [list flush $w]
+} -body {
+    list [runco [list coroutine::util::gets_safety $r 10 ::line]] $::line
+} -cleanup {
+    close $r ; close $w
+} -result {{0 3} abc}
+
+test coroutine-gets_safety-1.7 {timeout} -setup {
+    lassign [mkpipe ""] r w
+} -body {
+    runco [list coroutine::util::gets_safety $r 10 ::line 50]
+} -cleanup {
+    close $r ; close $w
+} -result {1 {Connection Timed Out}}
+
+test coroutine-gets_safety-1.8 {error codes} -setup {
+    lassign [mkpipe "[string repeat A 100]\n"] r w
+} -body {
+    runco [list apply {{r} {
+	catch {coroutine::util::gets_safety $r 10 ::line} m o
+	dict get $o -errorcode
+    }} $r]
+} -cleanup {
+    close $r ; close $w
+} -result {0 {COROUTINE GETS_SAFETY LIMIT}}
+
+# -------------------------------------------------------------------------
+
+rename runco {}
+rename mkpipe {}
+unset -nocomplain ::outcome ::line
+testsuiteCleanup
+return

