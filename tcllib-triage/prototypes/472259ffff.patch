--- modules/cmdline/cmdline.test
+++ modules/cmdline/cmdline.test
@@ -559,7 +559,25 @@
  --                   Forcibly stop option processing
  -help                Print this message
  -?                   Print this message
 " {}]
 
+test cmdline-8.1 {cmdline::getoptions, help vs invalid option, ticket 472259} {
+    set res {}
+    foreach argList {{-?} {-help} {-bogus} {-foo}} {
+	catch {cmdline::getoptions argList {{foo.arg blat} a}} msg opts
+	lappend res [dict get $opts -errorcode]
+    }
+    set res
+} {{CMDLINE USAGE} {CMDLINE USAGE} {CMDLINE USAGE INVALID {Illegal option "-bogus"}} {CMDLINE USAGE INVALID {Option "foo" requires an argument}}}
+
+test cmdline-8.2 {cmdline::getKnownOptions, help vs invalid option, ticket 472259} {
+    set res {}
+    foreach argList {{-?} {-help} {-x -foo}} {
+	catch {cmdline::getKnownOptions argList {{foo.arg blat} a}} msg opts
+	lappend res [dict get $opts -errorcode] $argList
+    }
+    set res
+} {{CMDLINE USAGE} {} {CMDLINE USAGE} {} {CMDLINE USAGE INVALID {Option "foo" requires an argument}} -x}
+
 testsuiteCleanup
 return

