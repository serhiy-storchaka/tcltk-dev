+
+# Run a script in a child interpreter with a command limit, to catch
+# infinite loops.
+proc yamlLimited {script} {
+    set i [interp create]
+    try {
+	$i eval [list set auto_path $::auto_path]
+	$i eval {package require cmdline}
+	$i eval [list source [localPath huddle.tcl]]
+	$i eval [list source [localPath yaml.tcl]]
+	interp limit $i commands -value [expr {[$i eval info cmdcount] + 100000}]
+	$i eval $script
+    } finally {
+	interp delete $i
+    }
+}
+
+test yaml-40.1 "block scalar without final newline, ticket 3434579fff" -body {
+    yamlLimited {yaml::yaml2dict "a: |\n  x\n  y"}
+} -result {a {x
+y
+}}
+
+test yaml-40.2 "trailing comment without final newline, ticket 3434579fff" -body {
+    yamlLimited {yaml::yaml2dict "a: x # c"}
+} -result {a x}
 
