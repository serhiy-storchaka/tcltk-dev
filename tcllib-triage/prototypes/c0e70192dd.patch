+::DEBUG puts httpd-client-0010
+test httpd-client-0010 {Serve an index file from a subdirectory, ticket c0e70192dd} -setup {
+    set docs [makeDirectory httpd-docs]
+    file mkdir [file join $docs sub]
+    set f [open [file join $docs sub index.md] w]
+    puts -nonewline $f {sub index}
+    close $f
+    TESTAPP uri add * /docs* [list mixin {reply ::httpd::content.file} path $docs]
+} -body {
+    set r [::httpd::test::send 10001 {GET /docs/sub/index.md HTTP/1.0} {} {}]
+    list [string match {*<p>sub index</p>*} $r] [string match {*Listing*} $r]
+} -cleanup {
+    removeDirectory httpd-docs
+    unset -nocomplain docs f r
+} -result {1 0}
