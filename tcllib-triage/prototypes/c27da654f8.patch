+
+# Keepalive timers must not outlive the connection (ticket [c27da654f8]).
+# These tests use a local socket pair, not the external server.
+
+proc wsKeepaliveRun {double reconfigure} {
+    set ::wsKaErrors {}
+    set ::wsKaReconfigure $reconfigure
+    set ::wsKaDouble $double
+    set ::wsKaSrv {}
+    set oldbgerror [interp bgerror {}]
+    interp bgerror {} [list apply {{msg opts} {lappend ::wsKaErrors $msg}}]
+    set ls [socket -server [list apply {{sock addr port} {
+        ::websocket::takeover $sock wsKaHandler 1
+        ::websocket::configure $sock -keepalive 1
+        if {$::wsKaDouble} {
+            ::websocket::takeover $sock wsKaHandler 1
+            ::websocket::configure $sock -keepalive 1
+        }
+        set ::wsKaSrv $sock
+    }}] -myaddr 127.0.0.1 0]
+    set c [socket 127.0.0.1 [lindex [fconfigure $ls -sockname] 2]]
+    vwait ::wsKaSrv
+    close $c
+    after 2000 {set ::wsKaDone 1}
+    vwait ::wsKaDone
+    close $ls
+    interp bgerror {} $oldbgerror
+    return $::wsKaErrors
+}
+
+proc wsKaHandler {sock type msg} {
+    if {$type eq "disconnect" && $::wsKaReconfigure} {
+        catch {::websocket::configure $sock -keepalive 1}
+    }
+}
+
+test websocket-keepalive-1.0 {no keepalive ping after disconnect} -body {
+    wsKeepaliveRun 0 0
+} -result {}
+
+test websocket-keepalive-1.1 {no orphan ping after repeated takeover} -body {
+    wsKeepaliveRun 1 0
+} -result {}
+
+test websocket-keepalive-1.2 {no ping scheduled from disconnect handler} -body {
+    wsKeepaliveRun 0 1
+} -result {}
+
+rename wsKeepaliveRun {}
+rename wsKaHandler {}
 
