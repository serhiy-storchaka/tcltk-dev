--- modules/httpd/httpd.test
+++ modules/httpd/httpd.test
@@ -373,10 +373,37 @@
 
 ::DEBUG puts httpd-client-0008
 test httpd-client-0008 {Pull a constant string} -body {
     ::httpd::test::send 10001 {GET /string HTTP/1.0} {} {}
 } -match glob -result [200 apple]
+::DEBUG puts httpd-client-0009
+test httpd-client-0009 {Timeout while reading the request line, ticket d470bac96c} -setup {
+    set sock [socket localhost 10001]
+    chan configure $sock -blocking 0 -translation binary
+    # Send an incomplete request line, then stall
+    puts -nonewline $sock "GET /echo"
+    flush $sock
+    set timeoutscript {}
+    for {set i 0} {$i < 50 && $timeoutscript eq {}} {incr i} {
+        after 20 {set ::httpd::test::tick 1}
+        vwait ::httpd::test::tick
+        foreach id [after info] {
+            set script [lindex [after info $id] 0]
+            if {[string match {::httpd::coro::* timeout} $script]} {
+                after cancel $id
+                set timeoutscript $script
+            }
+        }
+    }
+} -body {
+    # Simulate the expiry of the read timeout
+    list [catch {uplevel #0 $timeoutscript} msg] $msg [string length $timeoutscript]
+} -cleanup {
+    close $sock
+    unset -nocomplain sock timeoutscript i id script msg
+} -match glob -result {0 {} [1-9]*}
+
