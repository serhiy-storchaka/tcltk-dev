Index: modules/http/autoproxy.test
==================================================================
--- modules/http/autoproxy.test
+++ modules/http/autoproxy.test
@@ -156,10 +156,23 @@
     autoproxy::configure -basic -user test -password secret -realm tcllib
 } -body {
     autoproxy::configure -basic
     autoproxy::cget -basic
 } -result {}
+
+test autoproxy-1.2.3.1 "autoproxy::configure -basic long credentials not wrapped" -setup {
+    packageReset
+} -body {
+    set user [string repeat u 40]
+    set pass [string repeat p 40]
+    autoproxy::configure -basic -user $user -password $pass
+    set header [lindex [autoproxy::cget -basic] 1]
+    list [string match "Basic *" $header] [string first \n $header] \
+        [expr {[base64::decode [lindex $header 1]] eq "$user:$pass"}]
+} -cleanup {
+    unset -nocomplain user pass header
+} -result {1 -1 1}
 
