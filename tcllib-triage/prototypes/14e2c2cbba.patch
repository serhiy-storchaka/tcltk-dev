 [example {
-set p [aycock::parser {
+proc lex {expression} {
+    set tokens {}
+    set values {}
+    while {$expression ne {}} {
+        if {[regexp {^([+*()])(.*)} $expression -> token rest]} {
+            # Operators and parentheses
+            lappend tokens $token
+            lappend values {}
+        } elseif {[regexp {^([[:digit:]]+)(.*)} $expression -> token rest]} {
+            # Numbers
+            lappend tokens NUMBER
+            lappend values $token
+        } elseif {[regexp {^[[:space:]]+(.*)} $expression -> rest]} {
+            # Whitespace is skipped
+        } else {
+            return -code error "invalid character \"[string index $expression 0]\""
+        }
+        set expression $rest
+    }
+    return [list $tokens $values]
+}
+
+set p [grammar::aycock::parser {
     start ::= E {}
     E ::= E + T {expr {[lindex $_ 0] + [lindex $_ 2]}}
     E ::= T {}
     T ::= T * F {expr {[lindex $_ 0] * [lindex $_ 2]}}
     T ::= F {}
     F ::= NUMBER {}
     F ::= ( E ) {lindex $_ 1}
 }]
-puts [$p parse {(  NUMBER +  NUMBER )  *  ( NUMBER +  NUMBER ) } \
-	       {{} 2      {} 3      {} {} {} 7     {} 1      {}}]
+lassign [lex {(2 + 3) * (7 + 1)}] tokens values
+puts [$p parse $tokens $values]
 $p destroy
 }]
 
 The example, when run, prints [const 40].
 
