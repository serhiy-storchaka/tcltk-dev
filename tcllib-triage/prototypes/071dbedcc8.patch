Index: modules/bibtex/bibtex.test
==================================================================
--- modules/bibtex/bibtex.test
+++ modules/bibtex/bibtex.test
@@ -231,10 +231,26 @@
 # -------------------------------------------------------------------------
 
 test bibtex-5.0 {Tkt 8bec717add, parse} {
     bibtex::parse [viewFile [asset epj.bib]]
 } {{article refId0 {author {Santonocito, Domenico and Blumenfeld, Yorick} title {The hot GDR revisited} doi 10.1140/epja/s10050-020-00279-6 url https://doi.org/10.1140/epja/s10050-020-00279-6 journal {Eur. Phys. J. A} year 2020 volume 56 number 11 pages 279}}}
+
+test bibtex-6.0 {Tkt 071dbedcc8, 2979481, word "string" inside a field} {
+    bibtex::parse "@article{k2,\n  title = {A string {theory} test},\n  year = 2000\n}\n"
+} {{article k2 {title {A string theory test} year 2000}}}
+
+test bibtex-6.1 {Tkt 071dbedcc8, string macros are case-insensitive by default} {
+    bibtex::parse "@string{jfoo = {Lower Foo}}\n@string{JFoo = {Upper Foo}}\n@article{k1,\n  journal = jfoo,\n  note = JFoo\n}\n"
+} {{article k1 {journal {Lower Foo} note {Lower Foo}}}}
+
+test bibtex-6.2 {Tkt 071dbedcc8, -casesensitivestrings} {
+    bibtex::parse -casesensitivestrings 1 "@string{jfoo = {Lower Foo}}\n@string{JFoo = {Upper Foo}}\n@article{k1,\n  journal = jfoo,\n  note = JFoo\n}\n"
+} {{article k1 {journal {Lower Foo} note {Upper Foo}}}}
+
+test bibtex-6.3 {Tkt 071dbedcc8, -casesensitivestrings, quoted macro value} {
+    bibtex::parse -casesensitivestrings 1 "@string{jfoo = \"Journal of Foo\"}\n@article{k1,\n  journal = jfoo\n}\n"
+} {{article k1 {journal {Journal of Foo}}}}
 
 # ... Tests of addStrings ...
 #     (Requires introspection of parser state)
 # -------------------------------------------------------------------------
 testsuiteCleanup

