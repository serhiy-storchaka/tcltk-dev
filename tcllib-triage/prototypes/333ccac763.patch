Index: modules/yaml/huddle.tcl
==================================================================
--- modules/yaml/huddle.tcl
+++ modules/yaml/huddle.tcl
@@ -224,12 +224,27 @@
     } else {
         return [list $default_tag $src]
     }
 }
 
-proc ::huddle::wrap { node } {
-    return [list HUDDLE $node]
+proc ::huddle::wrap {args} {
+    switch -- [llength $args] {
+        1 {
+            return [list HUDDLE [lindex $args 0]]
+        }
+        2 {
+            # Form "wrap tag src" of huddle 0.1
+            lassign $args tag src
+            if {$tag eq ""} {
+                return [list HUDDLE $src]
+            }
+            return [list HUDDLE [list $tag $src]]
+        }
+        default {
+            return -code error {wrong # args: should be "huddle wrap node" or "huddle wrap tag src"}
+        }
+    }
 }
 
 proc ::huddle::unwrap { huddle_object } {
     return [lindex $huddle_object 1]
 }

