--- modules/websocket/websocket.test
+++ modules/websocket/websocket.test
@@ -188,15 +188,41 @@
     wsResetSleep
     wsResetHandler
 } -match exact -result {SOCKET text {Hello this is message NUMBER}
 }
 
+# Local tests, no network needed.
+
+proc wsLocalPair {} {
+    set ::wsSrvSock {}
+    set listen [socket -server {apply {{s a p} {set ::wsSrvSock $s}}} \
+                    -myaddr 127.0.0.1 0]
+    set cli [socket 127.0.0.1 [lindex [fconfigure $listen -sockname] 2]]
+    vwait ::wsSrvSock
+    close $listen
+    fconfigure $cli -translation binary
+    return [list $::wsSrvSock $cli]
+}
+
+test websocket-close-1.0 {close sends a close frame [13d8e3ca06]} -setup {
+    lassign [wsLocalPair] srv cli
+    ::websocket::takeover $srv {apply {args {}}} 1
+} -body {
+    ::websocket::close $srv 1000
+    # The server side is closed now, so this reads up to EOF.
+    binary scan [read $cli] H* hex
+    set hex
+} -cleanup {
+    close $cli
+    unset -nocomplain srv cli hex ::wsSrvSock
+} -result 881003e8[binary encode hex "Normal closure"]
+
 testsuiteCleanup
 unset -nocomplain wsNum wsMsgCounter wsOutput wsMsgMax wsWAITER wsUrl expectNum ws1 ws2 newMessage
 foreach pr {
     wsResetHandler wsExpectHandler wsOutputHandler
-    wsSleep wsResetSleep wsStopSleep
+    wsSleep wsResetSleep wsStopSleep wsLocalPair
 } {
     rename $pr {}
 }
 
 

