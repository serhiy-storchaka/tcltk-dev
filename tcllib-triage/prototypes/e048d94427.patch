+# -*- tcl -*-
+# ctrlunix.test:  tests for term::ansi::ctrl::unix
+#
+# This file contains a collection of tests for one or more of the Tcllib
+# procedures.  Sourcing this file into Tcl runs the tests and
+# generates output for errors.  No output means no errors were found.
+
+# -------------------------------------------------------------------------
+
+source [file join \
+	[file dirname [file dirname [file join [pwd] [info script]]]] \
+	devtools testutilities.tcl]
+
+testsNeedTcl     8.5
+testsNeedTcltest 2
+
+testing {
+    useLocal ansi/ctrlunix.tcl term::ansi::ctrl::unix
+}
+
+# -------------------------------------------------------------------------
+
+# The terminal size is only known when talking to a real terminal. Use
+# util-linux script(1) to create a pseudo terminal of a known size.
+
+tcltest::testConstraint scriptpty [expr {
+    $tcl_platform(os) eq "Linux" &&
+    [llength [auto_execok script]] &&
+    [llength [auto_execok stty]] &&
+    [llength [auto_execok tput]]
+}]
+
+proc ttysize {stdin} {
+    set dir [file dirname [file dirname [file join [pwd] [info script]]]]
+    set f [tcltest::makeFile [string map [list @DIR@ [list $dir]] {
+	set auto_path [linsert $auto_path 0 @DIR@]
+	package require term::ansi::ctrl::unix
+	puts [list [term::ansi::ctrl::unix::columns] [term::ansi::ctrl::unix::rows]]
+    }] ttysize.tcl]
+    set cmd "stty cols 123 rows 45; [list [info nameofexecutable]] [list $f] < $stdin"
+    set res [exec script -qec $cmd /dev/null < /dev/null 2>@1]
+    tcltest::removeFile ttysize.tcl
+    string trim $res
+}
+
+# Ticket e048d94427
+test term-ctrl-unix-1.0 {terminal size, stdin is the terminal} -constraints scriptpty -body {
+    ttysize /dev/tty
+} -result {123 45}
+
+test term-ctrl-unix-1.1 {terminal size, stdin is not a terminal} -constraints scriptpty -body {
+    ttysize /dev/null
+} -result {123 45}
+
+# -------------------------------------------------------------------------
+rename ttysize {}
+testsuiteCleanup
+return

