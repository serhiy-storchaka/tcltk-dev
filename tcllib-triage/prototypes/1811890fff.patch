Index: modules/inifile/inifile.test
==================================================================
--- modules/inifile/inifile.test
+++ modules/inifile/inifile.test
@@ -233,10 +233,34 @@
     set res [ini::open $testini r]
     ini::revert $res
     ini::close $res
 } {}
 
+#---------------------------------------------------------------------
+
+test inifile-6.1 {bug 1811890 - keys without assignment} -setup {
+    set f [makeFile {[suffixes]
+.txt
+.tcl
+a=
+b=1} solo.ini]
+} -body {
+    set fh [ini::open $f]
+    set res [list [lsort [ini::keys $fh suffixes]] \
+		 [ini::exists $fh suffixes .tcl] \
+		 [ini::value $fh suffixes .tcl] \
+		 [ini::value $fh suffixes .tcl dflt] \
+		 [ini::value $fh suffixes a dflt]]
+    ini::set $fh suffixes .txt x
+    ini::commit $fh
+    ini::close $fh
+    lappend res [lsort [split [string trim [viewFile $f]] \n]]
+} -cleanup {
+    removeFile solo.ini
+    unset f fh
+} -result {{.tcl .txt a b} 1 {} dflt {} {.tcl .txt=x {[suffixes]} a= b=1}}
+
 #---------------------------------------------------------------------
 # Clean up
 unset res
 testsuiteCleanup
 return

