+
+source [file join \
+	[file dirname [file dirname [file join [pwd] [info script]]]] \
+	devtools testutilities.tcl]
+
+testsNeedTcl     8.5
+testsNeedTcltest 2.0
+
+support {
+    use json/json.tcl     json
+    use base64/base64.tcl base64
+    # tdom is only needed for XML results, which these tests do not use.
+    if {[catch {package require tdom}]} {package provide tdom 0}
+}
+testing {
+    useLocal rest.tcl rest
+}
+
+# -------------------------------------------------------------------------
+# A minimal local HTTP server. It records the request header lines of
+# the last request in ::lastRequest and answers with a fixed JSON body.
+
+proc httpServer {} {
+    set ::lastRequest {}
+    set srv [socket -server httpAccept -myaddr 127.0.0.1 0]
+    return [list $srv [lindex [fconfigure $srv -sockname] 2]]
+}
+
+proc httpAccept {sock addr port} {
+    fconfigure $sock -translation crlf -blocking 0
+    set ::req($sock) {}
+    fileevent $sock readable [list httpRead $sock]
+}
+
+proc httpRead {sock} {
+    while {[gets $sock line] >= 0} {
+	if {$line ne ""} {lappend ::req($sock) $line ; continue}
+	# End of the request header, answer.
+	set ::lastRequest $::req($sock)
+	unset ::req($sock)
+	set body {{"a": 1}}
+	puts $sock "HTTP/1.0 200 OK"
+	puts $sock "Content-Type: application/json"
+	puts $sock "Content-Length: [string length $body]"
+	puts $sock ""
+	fconfigure $sock -translation binary -blocking 1
+	puts -nonewline $sock $body
+	close $sock
+	return
+    }
+    if {[eof $sock]} {close $sock ; unset -nocomplain ::req($sock)}
+}
+
+proc requestHeader {name} {
+    foreach line $::lastRequest {
+	if {[string match -nocase "$name: *" $line]} {
+	    return [string range $line [string length "$name: "] end]
+	}
+    }
+    return {}
+}
+
+# -------------------------------------------------------------------------
+test rest-2.0-tkt-cd5c074840 {create_interface, bearer authentication} -setup {
+    lassign [httpServer] srv port
+    set ::bearertest(call) [list url http://127.0.0.1:$port/ \
+				auth {bearer s3cr\$t\[x\]} result raw]
+    rest::create_interface ::bearertest
+} -body {
+    ::bearertest::call
+    requestHeader Authorization
+} -cleanup {
+    close $srv
+    namespace delete ::bearertest
+    unset -nocomplain srv port ::bearertest
+} -result {Bearer s3cr$t[x]}
+
+# -------------------------------------------------------------------------
+testsuiteCleanup
+return
