 ###
 # topic: aa8eda4fb59296a1a34d8d600ca54e28
 # description: Dump interfaces
 ###
 proc ::nettool::dump {} {
-  set data [exec ifconfig]
+  return [ifconfig_parse [exec ifconfig]]
+}
+
+###
+# description: Parse the output of ifconfig (both the old and the new
+# net-tools formats). The new format is normalized to the old keys.
+###
+proc ::nettool::ifconfig_parse {data} {
   set iface {}
   set result {}
   foreach line [split $data \n] {
+    if {[string trim $line] eq {}} continue
     if {[string index $line 0] in {" " "\t"} } {
       # Indented line appends the prior iface
       switch [lindex $line 0] {
         inet {
+          if {![string match *:* [lindex $line 1]]} {
+            # New format: inet ADDR netmask MASK broadcast BCAST
+            dict set result $iface ipv4 addr: [lindex $line 1]
+            foreach {field value} [lrange $line 2 end] {
+              switch $field {
+                netmask     {dict set result $iface ipv4 Mask: $value}
+                broadcast   {dict set result $iface ipv4 Bcast: $value}
+                destination {dict set result $iface ipv4 P-t-P: $value}
+              }
+            }
+            continue
+          }
           foreach tuple [lrange $line 1 end] {
 	    set idx [string first : $tuple]
             set field [string trim [string range $tuple 0 $idx]]
             set value [string trim [string range $tuple $idx+1 end]]
             dict set result $iface ipv4 [string trim $field] [string trim $value]
           }
         }
         inet6 {
+          if {[lindex $line 1] ne "addr:"} {
+            # New format: inet6 ADDR prefixlen N scopeid ID
+            dict set result $iface ipv6 addr: [lindex $line 1]
+            foreach {field value} [lrange $line 2 end] {
+              dict set result $iface ipv6 $field: $value
+            }
+            continue
+          }
           dict set result $iface ipv6 addr: [lindex $line 2]
           foreach tuple [lrange $line 3 end] {
 	    set idx [string first : $tuple]
             set field [string trim [string range $tuple 0 $idx]]
             set value [string trim [string range $tuple $idx+1 end]]
             dict set result $iface ipv6 [string trim $field] [string trim $value]
           }
 	}
+        ether {
+          dict set result $iface ether: [lindex $line 1]
+        }
       }
     } else {
       # Non-intended line - new iface
-      set iface [lindex $line 0]
+      set iface [string trimright [lindex $line 0] :]
       set idx [lsearch $line HWaddr]
       if {$idx >= 0 } {
         dict set result $iface ether: [lindex $line $idx+1]
       }
     }

