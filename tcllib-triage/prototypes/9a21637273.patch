     [list ::nettool::allocate_port 7790] 7791
 
 ::tcltest::test port-allocate-0006 \
     "Test allocate port returns the next address of an claimed spot and claims it" \
     [list ::nettool::allocate_port 7790] 7792
+
+::tcltest::testConstraint linux \
+    [expr {$::tcl_platform(os) eq "Linux"}]
+
+# Ticket 9a21637273: old and new net-tools ifconfig output formats
+::tcltest::test ifconfig-parse-old {Parse old ifconfig output format} \
+    -constraints linux -body {
+	::nettool::ifconfig_parse {eth0      Link encap:Ethernet  HWaddr 00:11:22:33:44:55  
+          inet addr:192.168.1.5  Bcast:192.168.1.255  Mask:255.255.255.0
+          inet6 addr: fe80::211:22ff:fe33:4455/64 Scope:Link
+          UP BROADCAST RUNNING MULTICAST  MTU:1500  Metric:1
+
+lo        Link encap:Local Loopback  
+          inet addr:127.0.0.1  Mask:255.0.0.0
+          inet6 addr: ::1/128 Scope:Host
+}
+    } -result {eth0 {ether: 00:11:22:33:44:55 ipv4 {addr: 192.168.1.5 Bcast: 192.168.1.255 Mask: 255.255.255.0} ipv6 {addr: fe80::211:22ff:fe33:4455/64 Scope: Link}} lo {ipv4 {addr: 127.0.0.1 Mask: 255.0.0.0} ipv6 {addr: ::1/128 Scope: Host}}}
+
+::tcltest::test ifconfig-parse-new {Parse new ifconfig output format} \
+    -constraints linux -body {
+	::nettool::ifconfig_parse {eth0: flags=4163<UP,BROADCAST,RUNNING,MULTICAST>  mtu 1500
+        inet 192.168.1.5  netmask 255.255.255.0  broadcast 192.168.1.255
+        inet6 fe80::211:22ff:fe33:4455  prefixlen 64  scopeid 0x20<link>
+        ether 00:11:22:33:44:55  txqueuelen 1000  (Ethernet)
+
+lo: flags=73<UP,LOOPBACK,RUNNING>  mtu 65536
+        inet 127.0.0.1  netmask 255.0.0.0
+        inet6 ::1  prefixlen 128  scopeid 0x10<host>
+        loop  txqueuelen 1000  (Local Loopback)
+}
+    } -result {eth0 {ipv4 {addr: 192.168.1.5 Mask: 255.255.255.0 Bcast: 192.168.1.255} ipv6 {addr: fe80::211:22ff:fe33:4455 prefixlen: 64 scopeid: 0x20<link>} ether: 00:11:22:33:44:55} lo {ipv4 {addr: 127.0.0.1 Mask: 255.0.0.0} ipv6 {addr: ::1 prefixlen: 128 scopeid: 0x10<host>}}}
+
+::tcltest::test ip-list-ldelete {ip_list drops the loopback address} \
