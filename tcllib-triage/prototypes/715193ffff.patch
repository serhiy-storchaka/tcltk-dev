Index: modules/htmlparse/htmlparse.tree_testsuite
==================================================================
--- modules/htmlparse/htmlparse.tree_testsuite
+++ modules/htmlparse/htmlparse.tree_testsuite
@@ -49,5 +49,19 @@
     set tx
 } [list \
 	{0 root} {1 head} {2 title} {3 PCDATA} \
 	{1 body} {2 h2} {3 PCDATA} \
 	{2 p} {3 PCDATA} {2 p}]
+
+test htmlparse-${impl}-5.3 {conversion to tree, whitespace in PCDATA is kept} {
+    struct::tree t
+    ::htmlparse::2tree {<p>foo <b>BB</b> RR <b>BB</b> <i>II</i><pre>  x  </pre></p>} t
+
+    set tx [list]
+    t walk root n {
+	if {[t get $n type] eq "PCDATA"} {
+	    lappend tx [t get $n data]
+	}
+    }
+    t destroy
+    set tx
+} [list {foo } BB { RR } BB { } II {  x  }]

