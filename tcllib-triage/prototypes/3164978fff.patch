Index: modules/nmea/nmea.test
==================================================================
--- /dev/null
+++ modules/nmea/nmea.test
@@ -0,0 +1,53 @@
+# -*- tcl -*-
+# nmea.test:  tests for the nmea package.
+
+source [file join \
+    [file dirname [file dirname [file join [pwd] [info script]]]] \
+    devtools testutilities.tcl]
+
+testsNeedTcl     8.5
+testsNeedTcltest 2.0
+
+testing {
+    useLocal nmea.tcl nmea
+}
+
+# -------------------------------------------------------------------------
+
+proc nmeaTestHandler {args} {
+    lappend ::nmeaLines $args
+}
+
+test nmea-1.0 {checksum} -body {
+    nmea::checksum GPGSA,A,3,04,05,,09,12,,,24,,,,,2.5,1.3,2.1
+} -result 39
+
+test nmea-2.0 {open_file, do_line, close_file (ticket 3164978fff)} -setup {
+    set f [makeFile "GPGGA,1,2\nGPGGA,3,4\n" nmea.txt]
+    set ::nmeaLines {}
+    nmea::event GPGGA nmeaTestHandler
+} -body {
+    nmea::open_file $f
+    nmea::do_line
+    nmea::close_file
+    list $::nmeaLines [catch nmea::do_line msg] $msg
+} -cleanup {
+    nmea::close
+    nmea::event GPGGA {}
+    removeFile nmea.txt
+    unset -nocomplain f msg ::nmeaLines
+} -result {{{{1 2}}} 1 {there is no currently open file}}
+
+test nmea-2.1 {close_port without an open port} -body {
+    nmea::close_port
+} -result {}
+
+test nmea-3.0 {rate without an open file} -body {
+    list [nmea::rate] [nmea::rate 100] [nmea::rate] [nmea::rate 0]
+} -cleanup {
+    nmea::configure rate 0
+} -result {0 100 100 0}
+
+# -------------------------------------------------------------------------
+testsuiteCleanup
+return

