+# Documented names for closing the port or the file.
+proc ::nmea::close_port {} { ::nmea::close }
+proc ::nmea::close_file {} { ::nmea::close }
+
+proc ::nmea::rate {{val {}}} {
+    return [::nmea::configure rate $val]
