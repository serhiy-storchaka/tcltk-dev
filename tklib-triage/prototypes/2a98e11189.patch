--- /dev/null
+++ modules/widget/calendar.test
@@ -0,0 +1,50 @@
+# -*- tcl -*-
+# Test cases of the widget::calendar package
+
+if {![package vsatisfies [package provide Tcl] 8.5-]} {
+    puts "    Aborting the tests found in \"[file tail [info script]]\"."
+    puts "    Requiring Tcl 8.5, have [package present Tcl]"
+    return
+}
+
+if {[catch { package require Tk 8.5- } msg]} {
+    puts "    Aborting the tests found in \"[file tail [info script]]\"."
+    puts "    Requiring Tk 8.5, $msg"
+    return
+}
+
+package require tcltest 2.2
+namespace import ::tcltest::*
+
+package require snit
+source [file join [file dirname [info script]] widget.tcl]
+source [file join [file dirname [info script]] calendar.tcl]
+
+# -------------------------------------------------------------------------
+
+proc weekdayLabels {w} {
+    # The weekday labels are the white "title" items.
+    set res {}
+    foreach id [$w find withtag title] {
+	if {[$w itemcget $id -fill] eq "white"} {
+	    lappend res [$w itemcget $id -text]
+	}
+    }
+    return $res
+}
+
+test calendar-language-1.1 {Russian weekday abbreviations} -setup {
+    widget::calendar .c -language ru -firstday monday
+    pack .c
+    update
+} -body {
+    weekdayLabels .c
+} -cleanup {
+    destroy .c
+} -result [list Пн Вт Ср Чт Пт Сб Вс]
+
+# -------------------------------------------------------------------------
+
+rename weekdayLabels {}
+cleanupTests
+return

