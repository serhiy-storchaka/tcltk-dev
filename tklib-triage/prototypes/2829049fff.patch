==================================================================
--- /dev/null
+++ modules/getstring/getstring.test
@@ -0,0 +1,64 @@
+# -*- tcl -*-
+# Test cases of the getstring package
+
+if {![package vsatisfies [package provide Tcl] 8.5-]} {
+    puts "    Aborting the tests found in \"[file tail [info script]]\"."
+    puts "    Requiring Tcl 8.5, have [package present Tcl]"
+    return
+}
+
+if {[catch { package require Tk 8.5- } msg]} {
+    puts "    Aborting the tests found in \"[file tail [info script]]\"."
+    puts "    Requiring Tk 8.5, $msg"
+    return
+}
+
+package require tcltest 2.2
+namespace import ::tcltest::*
+
+source [file join [file dirname [info script]] tk_getString.tcl]
+
+# -------------------------------------------------------------------------
+
+test getstring-initial-1.1 {existing variable value is the initial entry contents} -setup {
+    set ::gsvalue "initial text"
+    set ::gsseen {}
+} -body {
+    after 50 {
+	set ::gsseen [list [.gs.entry get] [.gs.ok cget -state]]
+	set ::getstring::result 1
+    }
+    list [::getstring::tk_getString .gs ::gsvalue "Prompt:"] $::gsvalue $::gsseen
+} -cleanup {
+    unset -nocomplain ::gsvalue ::gsseen
+} -result {1 {initial text} {{initial text} normal}}
+
+test getstring-initial-1.2 {nonexistent variable gives an empty entry} -setup {
+    unset -nocomplain ::gsvalue
+    set ::gsseen {}
+} -body {
+    after 50 {
+	set ::gsseen [list [.gs.entry get] [.gs.ok cget -state]]
+	set ::getstring::result 0
+    }
+    list [::getstring::tk_getString .gs ::gsvalue "Prompt:"] $::gsvalue $::gsseen
+} -cleanup {
+    unset -nocomplain ::gsvalue ::gsseen
+} -result {0 {} {{} disabled}}
+
+test getstring-initial-1.3 {edited initial value is returned} -setup {
+    set ::gsvalue "abc"
+} -body {
+    after 50 {
+	.gs.entry insert end def
+	set ::getstring::result 1
+    }
+    list [::getstring::tk_getString .gs ::gsvalue "Prompt:"] $::gsvalue
+} -cleanup {
+    unset -nocomplain ::gsvalue
+} -result {1 abcdef}
+
+# -------------------------------------------------------------------------
+
+cleanupTests
+return

