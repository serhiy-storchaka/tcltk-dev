+
+# ClipToRange --
+#    Clip a value to the given range
+# Arguments:
+#    value       Value to clip
+#    min         Lower bound
+#    max         Upper bound
+# Result:
+#    The value, clipped to the range [min,max]
+#
+proc ::Plotchart::ClipToRange { value min max } {
+   if { $min > $max } {
+       foreach {min max} [list $max $min] {break}
+   }
+   if { $value < $min } {
+       return $min
+   } elseif { $value > $max } {
+       return $max
+   } else {
+       return $value
+   }
+}
 
