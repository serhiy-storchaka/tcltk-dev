--- /dev/null
+++ modules/ico/ico.test
@@ -0,0 +1,55 @@
+# -*- tcl -*-
+# Test cases of the ico package
+
+if {![package vsatisfies [package provide Tcl] 8.5-]} {
+    puts "    Aborting the tests found in \"[file tail [info script]]\"."
+    puts "    Requiring Tcl 8.5, have [package present Tcl]"
+    return
+}
+
+if {[catch { package require Tk 8.5- } msg]} {
+    puts "    Aborting the tests found in \"[file tail [info script]]\"."
+    puts "    Requiring Tk 8.5, $msg"
+    return
+}
+
+package require tcltest 2.2
+namespace import ::tcltest::*
+
+source [file join [file dirname [info script]] ico.tcl]
+
+# -------------------------------------------------------------------------
+
+# A square color list of the given size, with some transparent pixels.
+proc makeColors {size} {
+    set data {}
+    for {set y 0} {$y < $size} {incr y} {
+	set row {}
+	for {set x 0} {$x < $size} {incr x} {
+	    lappend row [expr {($x + $y) % 3 ? "#FF0000" : ""}]
+	}
+	lappend data $row
+    }
+    return $data
+}
+
+test ico-members-1.1 {icon sizes of 256 and above 127 in ICO files} -setup {
+    set file [makeFile {} ico-members.ico]
+    file delete $file
+} -body {
+    foreach size {16 200 256} {
+	::ico::writeIcon $file $size 24 [makeColors $size]
+    }
+    set fh [open $file rb]
+    set ico [read $fh]
+    close $fh
+    list [::ico::iconMembers $file 0] [::ico::getIconMembersICODATA $ico] \
+	[llength [::ico::getIcon $file 0 -format colors -res 16]] \
+	[llength [::ico::getIcon $file 0 -format colors -res 256]]
+} -cleanup {
+    ::ico::clearCache
+    removeFile ico-members.ico
+} -result {{{0 16 16 24} {1 200 200 24} {2 256 256 24}} {{0 16 16 24} {1 200 200 24} {2 256 256 24}} 16 256}
+
+# -------------------------------------------------------------------------
+::tcltest::cleanupTests

