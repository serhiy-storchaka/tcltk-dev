--- /dev/null
+++ modules/ctext/ctext.test
@@ -0,0 +1,53 @@
+# -*- tcl -*-
+# Test cases of the ctext package
+
+if {![package vsatisfies [package provide Tcl] 8.5-]} {
+    puts "    Aborting the tests found in \"[file tail [info script]]\"."
+    puts "    Requiring Tcl 8.5, have [package present Tcl]"
+    return
+}
+
+if {[catch { package require Tk 8.5- } msg]} {
+    puts "    Aborting the tests found in \"[file tail [info script]]\"."
+    puts "    Requiring Tk 8.5, $msg"
+    return
+}
+
+package require tcltest 2.2
+namespace import ::tcltest::*
+
+source [file join [file dirname [info script]] ctext.tcl]
+
+# -------------------------------------------------------------------------
+
+test ctext-modified-1.1 {<<Modified>> is sent only when the flag changes} -setup {
+    ctext .t
+    set ::events 0
+    bind .t <<Modified>> {incr ::events}
+} -body {
+    .t insert end a
+    .t insert end b
+    .t delete 1.0
+    list $::events [.t edit modified]
+} -cleanup {
+    destroy .t
+    unset ::events
+} -result {1 1}
+
+test ctext-modified-1.2 {edit modified sends <<Modified>> on change} -setup {
+    ctext .t
+    .t insert end a
+    set ::events 0
+    bind .t <<Modified>> {incr ::events}
+} -body {
+    .t edit modified 0
+    .t edit modified 0
+    .t edit modified 1
+    list $::events [.t edit modified]
+} -cleanup {
+    destroy .t
+    unset ::events
+} -result {2 1}
+
+# -------------------------------------------------------------------------
+::tcltest::cleanupTests

