Index: modules/widget/dateentry.test
==================================================================
--- /dev/null
+++ modules/widget/dateentry.test
@@ -0,0 +1,76 @@
+# -*- tcl -*-
+# Test cases of the widget::dateentry package
+
+if {![package vsatisfies [package provide Tcl] 8.5-]} {
+    puts "    Aborting the tests found in \"[file tail [info script]]\"."
+    puts "    Requiring Tcl 8.5, have [package present Tcl]"
+    return
+}
+
+if {[catch { package require Tk 8.5- } msg]} {
+    puts "    Aborting the tests found in \"[file tail [info script]]\"."
+    puts "    Requiring Tk 8.5, $msg"
+    return
+}
+
+package require tcltest 2.2
+namespace import ::tcltest::*
+
+package require snit
+source [file join [file dirname [info script]] widget.tcl]
+source [file join [file dirname [info script]] calendar.tcl]
+source [file join [file dirname [info script]] dateentry.tcl]
+
+# -------------------------------------------------------------------------
+
+test dateentry-textvariable-1.1 {array element textvariable is initialized} -setup {
+    unset -nocomplain ::dtest
+    set ::dtest(other) 1
+} -body {
+    widget::dateentry .d -textvariable ::dtest(date) -dateformat %Y-%m-%d
+    list [info exists ::dtest(date)] [expr {$::dtest(date) eq [.d get]}]
+} -cleanup {
+    destroy .d
+    unset -nocomplain ::dtest
+} -result {1 1}
+
+test dateentry-textvariable-1.2 {existing variable value is shown} -setup {
+    set ::dtest 2020-01-02
+} -body {
+    widget::dateentry .d -textvariable ::dtest -dateformat %Y-%m-%d
+    list $::dtest [.d get]
+} -cleanup {
+    destroy .d
+    unset -nocomplain ::dtest
+} -result {2020-01-02 2020-01-02}
+
+test dateentry-textvariable-1.3 {unqualified textvariable name is global} -setup {
+    unset -nocomplain ::dtest
+} -body {
+    widget::dateentry .d -textvariable dtest(date) -dateformat %Y-%m-%d
+    set r [info exists ::dtest(date)]
+    set ::dtest(date) 2020-01-02
+    lappend r [.d get]
+    .d set 2021-03-04
+    .d DateChosen
+    lappend r $::dtest(date)
+} -cleanup {
+    destroy .d
+    unset -nocomplain ::dtest
+} -result {1 2020-01-02 2021-03-04}
+
+test dateentry-textvariable-1.4 {textvariable configured after creation} -setup {
+    unset -nocomplain ::dtest
+    widget::dateentry .d -dateformat %Y-%m-%d
+} -body {
+    .d configure -textvariable ::dtest
+    expr {$::dtest eq [.d get]}
+} -cleanup {
+    destroy .d
+    unset -nocomplain ::dtest
+} -result 1
+
+# -------------------------------------------------------------------------
+
+cleanupTests
+return

