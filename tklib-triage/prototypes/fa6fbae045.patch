@@ -146,10 +147,12 @@
 	# Initialize entry to current date, midnight
 	set rawDate       [expr {([clock seconds] / 86400) * 86400}]
 	set formattedDate [clock format $rawDate -format $options(-dateformat)]
 
 	$self UpdateEntry
+	$self InitTextvariable
