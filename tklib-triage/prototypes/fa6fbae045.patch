 	set rawDate [clock scan $formattedDate -format $options(-dateformat)]
 	
 	# Export to linked variable
-	upvar 0  $options(-textvariable) date
-	set date $formattedDate
+	if {$options(-textvariable) ne {}} {
+	    upvar \#0 $options(-textvariable) date
+	    set date $formattedDate
+	}
 
