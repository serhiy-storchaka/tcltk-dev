+test switch-20.1 {switch options without --: compiled [Bug b198d6560a]} -body {
+    apply {a {
+	switch -exact $a {foo - bar {string cat ok} default {string cat no}}
+    }} bar
+} -result ok
+test switch-20.2 {switch options without --: compiled [Bug b198d6560a]} -body {
+    string match *jumpTable* [::tcl::unsupported::disassemble script {
+	switch -exact $a {foo - bar {string cat ok} default {string cat no}}
+    }]
+} -result 1
+test switch-20.3 {switch options without --: value looks like option} -body {
+    apply {a {
+	list [switch -exact $a {-exact {string cat ok} default {string cat no}}] \
+	    [switch -glob $a {-gl* {string cat ok} default {string cat no}}] \
+	    [switch -nocase $a {-GLOB {string cat ok} default {string cat no}}]
+    }} -glob
+} -result {no ok ok}
