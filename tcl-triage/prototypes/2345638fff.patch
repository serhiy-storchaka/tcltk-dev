+/*
+ *----------------------------------------------------------------------
+ *
+ * TestmemoryinfoCmd --
+ *
+ *	This procedure implements the "testmemoryinfo" command. It returns
+ *	the statistics of the threaded memory allocator, as produced by
+ *	Tcl_GetMemoryInfo.
+ *
+ * Results:
+ *	A standard Tcl result.
+ *
+ * Side effects:
+ *	None.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static int
+TestmemoryinfoCmd(
+    TCL_UNUSED(void *),
+    Tcl_Interp *interp,		/* Current interpreter. */
+    Tcl_Size objc,		/* Number of arguments. */
+    Tcl_Obj *const *objv)	/* The argument objects. */
+{
+    Tcl_DString ds;
+
+    if (objc != 1) {
+	Tcl_WrongNumArgs(interp, 1, objv, NULL);
+	return TCL_ERROR;
+    }
+    Tcl_DStringInit(&ds);
+
+    /*
+     * Tcl_GetMemoryInfo is not in the stubs table, and the stub macro refuses
+     * to work in a stub-enabled module. The tcltest executable is linked
+     * against the Tcl library, so call the function directly.
+     */
+
+    (Tcl_GetMemoryInfo)(&ds);
+    Tcl_DStringResult(interp, &ds);
+    return TCL_OK;
+}
+
