 /*
  *----------------------------------------------------------------------
  *
  * Tcl_GetMemoryInfo --
  *
- *	Return a list-of-lists of memory stats.
+ *	Return a list-of-lists of memory stats. Without the threaded memory
+ *	allocator (e.g. in TCL_MEM_DEBUG or PURIFY builds) there are no
+ *	per-thread caches, so the list is empty. [Bug 2345638]
  *
  * Results:
  *	None.
  *
  * Side effects:
- *	List appended to given dstring.
+ *	None.
  *
  *----------------------------------------------------------------------
  */
 
 void
 Tcl_GetMemoryInfo(
     TCL_UNUSED(Tcl_DString *))
 {
-    Tcl_Panic("Tcl_GetMemoryInfo called when threaded memory allocator not in use");
+    /* Nothing to report: append no elements. */
 }
 
