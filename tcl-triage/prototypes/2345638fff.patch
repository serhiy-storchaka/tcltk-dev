--- tests/thread.test
+++ tests/thread.test
@@ -26,10 +26,12 @@
 catch [list package require -exact tcl::test [info patchlevel]]
 
 # Some tests require the testthread command
 
 testConstraint testthread [expr {[info commands testthread] ne {}}]
+testConstraint testmemoryinfo [llength [info commands testmemoryinfo]]
+testConstraint memory [llength [info commands memory]]
 
 
 set threadSuperKillScript {
     rename catch ""
     rename while ""
@@ -1460,9 +1462,30 @@
 	thread::join $::thread
     }
 } -cleanup {
     unset -nocomplain ::threadCount ::execCount ::threads ::thread
 } -result {}
+
+test thread-9.1 {Tcl_GetMemoryInfo: list of per-cache statistics, no panic [2345638fff]} -constraints {
+    testmemoryinfo
+} -body {
+    set info [testmemoryinfo]
+    set bad {}
+    foreach cache $info {
+	if {![regexp {^(shared|thread.+)$} [lindex $cache 0]]
+		|| [llength $cache] < 2} {
+	    lappend bad $cache
+	}
+    }
+    list [expr {[llength $info] == 0 || "shared" in [lmap c $info {lindex $c 0}]}] $bad
+} -cleanup {
+    unset -nocomplain info bad cache
+} -result {1 {}}
+test thread-9.2 {Tcl_GetMemoryInfo: empty when the threaded allocator is not used [2345638fff]} -constraints {
+    testmemoryinfo memory
+} -body {
+    testmemoryinfo
+} -result {}
 
 # cleanup
 ::tcltest::cleanupTests
 return

