+test dict-22.26 {dict with keeps string rep if nothing changed: bug 941d52a3e5} {
+    set d "\n\tone 1\n\ttwo 2\n"
+    set r [apply {d {dict with d {}; return $d}} $d]
+    dict with d {}
+    list [expr {$r eq $d}] [expr {$d eq "\n\tone 1\n\ttwo 2\n"}]
+} {1 1}
