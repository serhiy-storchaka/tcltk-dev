Index: tests/unixFCmd.test
==================================================================
--- tests/unixFCmd.test
+++ tests/unixFCmd.test
@@ -437,10 +437,26 @@
 test unixFCmd-20.2 {SetReadOnlyAttribute} -setup {
     catch {file delete -force -- foo.test}
 } -constraints {unix notRoot readonlyAttr} -returnCodes error -body {
     file attributes foo.test -readonly 1
 } -result {could not read "foo.test": no such file or directory}
+
+testConstraint defaultAcl [expr {[testConstraint unix] && ![catch {
+    file mkdir aclTest.dir
+    exec setfacl -d -m u::rwx,g::rwx,o::rwx aclTest.dir
+}]}]
+file delete -force aclTest.dir
+test unixFCmd-21.1 {file mkdir honours default ACL (Bug 623585)} -setup {
+    file delete -force aclTest.dir
+    file mkdir aclTest.dir
+    exec setfacl -d -m u::rwx,g::rwx,o::rwx aclTest.dir
+} -constraints {unix defaultAcl} -body {
+    file mkdir aclTest.dir/sub
+    file attributes aclTest.dir/sub -permissions
+} -cleanup {
+    file delete -force aclTest.dir
+} -result 0o40777
 
 # cleanup
 cleanup
 cd $oldcwd
 ::tcltest::cleanupTests

