+/*
+ *----------------------------------------------------------------------
+ *
+ * ResetImportCompileProcs --
+ *
+ *	An imported command copies the compileProc of its target when it is
+ *	created. When the target is redefined and the import is relinked to
+ *	the new command, update that copy (recursively for imports of the
+ *	import), so that callers are not compiled with the old one, e.g. the
+ *	no-op of an empty proc. [Bug 3017879]
+ *
+ *----------------------------------------------------------------------
+ */
+
+static void
+ResetImportCompileProcs(
+    Command *cmdPtr,		/* Imported command. */
+    CompileProc *compileProc)	/* compileProc of its new target. */
+{
+    ImportRef *refPtr;
+
+    cmdPtr->compileProc = compileProc;
+    for (refPtr = cmdPtr->importRefPtr; refPtr != NULL;
+	    refPtr = refPtr->nextPtr) {
+	ResetImportCompileProcs(refPtr->importedCmdPtr, compileProc);
+    }
+}
