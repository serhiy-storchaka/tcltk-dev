Index: tests/var.test
==================================================================
--- tests/var.test
+++ tests/var.test
@@ -584,10 +584,40 @@
 test var-7.17 {Tcl_VariableObjCmd, no args (TIP 323)} {
     namespace eval test_ns_var {
 	variable
     }
 } {}
+
+test var-7.18 {unset of a declared-only namespace variable removes the declaration [bd2656d8e3]} -setup {
+    namespace eval test_ns_var {variable declonly}
+} -body {
+    list [info vars test_ns_var::declonly] [info exists test_ns_var::declonly] \
+	[catch {unset test_ns_var::declonly} msg] $msg \
+	[info vars test_ns_var::declonly] \
+	[namespace which -variable test_ns_var::declonly]
+} -cleanup {
+    namespace delete test_ns_var
+} -result {::test_ns_var::declonly 0 1 {can't unset "test_ns_var::declonly": no such variable} {} {}}
+test var-7.19 {unset -nocomplain of a declared-only variable in a proc removes the declaration [bd2656d8e3]} -setup {
+    namespace eval test_ns_var {variable declonly}
+    proc p {} {
+	variable ::test_ns_var::declonly
+	list [catch {unset declonly} msg] $msg [info vars ::test_ns_var::*]
+    }
+    proc q {} {
+	variable ::test_ns_var::declonly
+	unset -nocomplain declonly
+    }
+} -body {
+    set r [p]
+    namespace eval test_ns_var {variable declonly}
+    lappend r [q] [info vars ::test_ns_var::*]
+} -cleanup {
+    namespace delete test_ns_var
+    rename p {}
+    rename q {}
+} -result {1 {can't unset "declonly": no such variable} {} {} {}}
 
