 # Note that this test may fail in future versions
+test format-19.5 {%A with sign, padding and Inf} {
+    # explicit precision: without it MSVC prints all 13 hex digits
+    list [format %.1A 1.5] [format %.1A -1.5] [format %+.0A 1.0] \
+	    [format "% .0A" 1.0] [format %10.1A 1.5] [format %-10.0A| -2.0] \
+	    [format %A Inf] [format %A -Inf]
+} {0x1.8p+0 -0x1.8p+0 +0x1p+0 { 0x1p+0} {  0x1.8p+0} {-0x1p+1   |} INF -INF}
