     if (value == NULL
 	    || Tcl_GetIntFromObj(NULL, value, &prec) != TCL_OK
 	    || prec < 0 || prec > TCL_MAX_PREC) {
 	return (char *) "improper value for precision";
     }
+    if (prec != *precisionPtr) {
+	/*
+	 * Constant expressions are folded into literals at compile time with
+	 * the old precision; force a recompile. [Bug 2859027]
+	 */
+
+	((Interp *) interp)->compileEpoch++;
+    }
     *precisionPtr = prec;
     return NULL;
 }
 
