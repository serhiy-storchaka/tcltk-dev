+test http-4.11.1.$ThreadLevel {http::reset while waiting for socket thread} -setup {
+    set oldbgerror [interp bgerror {}]
+    set ::bgerrors {}
+    interp bgerror {} {apply {{msg opts} {lappend ::bgerrors $msg}}}
+} -body {
+    set token [http::geturl $url -keepalive 0 -command \#]
+    after idle [list http::reset $token]
+    after 500 {set ::done 1}
+    vwait ::done
+    list [http::status $token] $::bgerrors
+} -cleanup {
+    catch {http::cleanup $token}
+    interp bgerror {} $oldbgerror
+    unset -nocomplain token oldbgerror ::bgerrors ::done
+} -result {reset {}}
 
