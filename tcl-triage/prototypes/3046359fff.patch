+/*
+ *----------------------------------------------------------------------
+ *
+ * TestNewNativePathCmd --
+ *
+ *	Implements the "testnewnativepath path" command: calls
+ *	Tcl_FSNewNativePath for a minimal filesystem whose
+ *	internalToNormalizedProc caches its own internal representation in
+ *	the path it returns. The result is the native representation kept in
+ *	the new path and the number of native representations freed once the
+ *	path is released (2 means none leaked). [Bug 3046359]
+ *
+ *----------------------------------------------------------------------
+ */
+
+static int nativePathFreed;
+
+static int
+NativePathInFilesystem(
+    Tcl_Obj *pathPtr,
+    TCL_UNUSED(void **))
+{
+    return strncmp(TclGetString(pathPtr), "nnp:", 4) ? -1 : TCL_OK;
+}
+
+static void *
+NativePathMakeRep(
+    const char *prefix,
+    const char *path)
+{
+    char *rep = (char *)Tcl_Alloc(strlen(prefix) + strlen(path) + 1);
+
+    strcpy(rep, prefix);
+    strcat(rep, path);
+    return rep;
+}
+
+static void *
+NativePathCreateInternalRep(
+    Tcl_Obj *pathPtr)
+{
+    return NativePathMakeRep("cached:", TclGetString(pathPtr) + 4);
+}
+
+static void *
+NativePathDupInternalRep(
+    void *clientData)
+{
+    return NativePathMakeRep("", (const char *)clientData);
+}
+
+static void
+NativePathFreeInternalRep(
+    void *clientData)
+{
+    nativePathFreed++;
+    Tcl_Free(clientData);
+}
+
+static const Tcl_Filesystem nativePathFilesystem;
+
+static Tcl_Obj *
+NativePathInternalToNormalized(
+    void *clientData)
+{
+    Tcl_Obj *pathPtr = Tcl_ObjPrintf("nnp:%s",
+	    strchr((const char *)clientData, ':') + 1);
+
+    Tcl_IncrRefCount(pathPtr);
+    Tcl_FSGetInternalRep(pathPtr, &nativePathFilesystem);
+    pathPtr->refCount--;
+    return pathPtr;
+}
+
+static const Tcl_Filesystem nativePathFilesystem = {
+    "nativepath", sizeof(Tcl_Filesystem), TCL_FILESYSTEM_VERSION_1,
+    NativePathInFilesystem, NativePathDupInternalRep,
+    NativePathFreeInternalRep, NativePathInternalToNormalized,
+    NativePathCreateInternalRep, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
+    NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
+    NULL, NULL, NULL, NULL
+};
+
+static int
+TestNewNativePathCmd(
+    TCL_UNUSED(void *),
+    Tcl_Interp *interp,
+    Tcl_Size objc,
+    Tcl_Obj *const *objv)
+{
+    Tcl_Obj *pathPtr, *resultPtr;
+    const char *rep;
+
+    if (objc != 2) {
+	Tcl_WrongNumArgs(interp, 1, objv, "path");
+	return TCL_ERROR;
+    }
+    if (Tcl_FSRegister(NULL, &nativePathFilesystem) != TCL_OK) {
+	return TCL_ERROR;
+    }
+    nativePathFreed = 0;
+    pathPtr = Tcl_FSNewNativePath(&nativePathFilesystem,
+	    NativePathMakeRep("native:", TclGetString(objv[1])));
+    Tcl_IncrRefCount(pathPtr);
+    rep = (const char *)Tcl_FSGetInternalRep(pathPtr, &nativePathFilesystem);
+    resultPtr = Tcl_NewListObj(0, NULL);
+    Tcl_ListObjAppendElement(NULL, resultPtr,
+	    Tcl_NewStringObj(rep ? rep : "NULL", -1));
+    Tcl_DecrRefCount(pathPtr);
+    Tcl_ListObjAppendElement(NULL, resultPtr, Tcl_NewWideIntObj(nativePathFreed));
+    Tcl_FSUnregister(&nativePathFilesystem);
+    Tcl_SetObjResult(interp, resultPtr);
+    return TCL_OK;
+}
+
