+
+    /*
+     * POSIX allows EISDIR only when the source is not a directory, but some
+     * NFS servers return it for a directory onto a non-empty directory.
+     * [Bug 2003130]
+     */
+
+    if (errno == EISDIR) {
+	Tcl_StatBuf srcStatBuf;
+
+	if (TclOSstat(src, &srcStatBuf) == 0 && S_ISDIR(srcStatBuf.st_mode)) {
+	    errno = EEXIST;
+	} else {
+	    errno = EISDIR;
+	}
+    }
 
