Index: tests/oo.test
==================================================================
--- tests/oo.test
+++ tests/oo.test
@@ -897,10 +897,29 @@
     oo::objdefine $o mixin Cls
     $o mthd
 } -cleanup {
     Super destroy
 } -result ok
+test oo-3.13 {Bug 29aa1c7b13: destructors of object mixins} -setup {
+    oo::class create Mix {
+	destructor {lappend ::result mix; next}
+    }
+    oo::class create Cls {
+	destructor {lappend ::result cls}
+    }
+    set result {}
+} -body {
+    Cls create obj
+    oo::objdefine obj mixin Mix
+    obj destroy
+    Cls create obj
+    obj destroy
+    return $result
+} -cleanup {
+    Mix destroy
+    Cls destroy
+} -result {mix cls cls}
 
 test oo-4.1 {basic test of OO functionality: export} {
     set o [oo::object new]
     set result {}
     oo::objdefine $o method Foo {} {lappend ::result Foo; return}

