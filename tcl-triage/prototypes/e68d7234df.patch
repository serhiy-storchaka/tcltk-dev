-	    return result;
-	}
+    TclNRAddCallback(interp, TimeLoopCallback, statePtr, objv[1], NULL, NULL);
+    return TCL_OK;
+}
+
+static int
+TimeLoopCallback(
+    void *data[],
+    Tcl_Interp *interp,
+    int result)
+{
+    TimeState *statePtr = (TimeState *)data[0];
+    Tcl_Obj *objPtr = (Tcl_Obj *)data[1];
+    Tcl_Obj *objs[4];
+    long long count = statePtr->count, start = statePtr->start, stop;
+    double totalMicroSec;
+
+    if (result == TCL_OK && statePtr->left-- > 0) {
+	TclNRAddCallback(interp, TimeLoopCallback, statePtr, objPtr,
+		NULL, NULL);
+	return TclNREvalObjEx(interp, objPtr, 0, NULL, 0);
+    }
+    Tcl_Free(statePtr);
+    Tcl_DecrRefCount(objPtr);
+    if (result != TCL_OK) {
+	return result;
