+    statePtr = (TimeState *)Tcl_Alloc(sizeof(TimeState));
+    statePtr->count = count;
+    statePtr->left = count;
+    Tcl_IncrRefCount(objv[1]);
 #ifndef TCL_WIDE_CLICKS
-    start = Tcl_GetMonotonicTime();
+    statePtr->start = Tcl_GetMonotonicTime();
 #else
-    start = TclpGetWideClicks();
