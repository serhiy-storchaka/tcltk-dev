Index: tests/http11.test
==================================================================
--- tests/http11.test
+++ tests/http11.test
@@ -355,10 +355,19 @@
     set log [list $current $total]
     after 100 set ::WaitHere 0
     vwait ::WaitHere
     return
 }
+
+# As progressPause, but with a short pause, for many small chunks.
+proc progressPauseShort {var token total current} {
+    upvar #0 $var log
+    set log [list $current $total]
+    after 1 set ::WaitHere 0
+    vwait ::WaitHere
+    return
+}
 
