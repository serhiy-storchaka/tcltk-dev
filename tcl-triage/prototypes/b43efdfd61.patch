--- tests/fCmd.test
+++ tests/fCmd.test
@@ -2053,10 +2053,26 @@
     }
     file delete -force tfa
 } -cleanup {
     while {[catch {file delete -force tfa}]} {}
 } -result {}
+
+test fCmd-20.3 {TraverseUnixTree: delete -force with read-only subdirectories: Bugs 38a31dffdf, b43efdfd61} -setup {
+    catch {file delete -force -- tfa}
+} -constraints {unix notRoot} -body {
+    file mkdir tfa/a/b
+    close [open tfa/a/b/f w]
+    file attributes tfa/a/b -permissions 0o500
+    file attributes tfa/a -permissions 0o500
+    file attributes tfa -permissions 0o500
+    list [catch {file delete -force tfa} msg] $msg [file exists tfa]
+} -cleanup {
+    catch {file attributes tfa -permissions 0o777}
+    catch {file attributes tfa/a -permissions 0o777}
+    catch {file attributes tfa/a/b -permissions 0o777}
+    catch {file delete -force -- tfa}
+} -result {0 {} 0}
 
