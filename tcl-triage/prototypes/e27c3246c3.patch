+/*
+ *----------------------------------------------------------------------
+ *
+ * TestUtfToChar16Cmd --
+ *
+ *	Returns the UTF-16 units produced by Tcl_UtfToChar16DString, as a
+ *	list of hexadecimal numbers.
+ *
+ *	testutftochar16 $bytes
+ *
+ *----------------------------------------------------------------------
+ */
+static int
+TestUtfToChar16Cmd(
+    TCL_UNUSED(void *),
+    Tcl_Interp *interp,
+    Tcl_Size objc,
+    Tcl_Obj *const *objv)
+{
+    Tcl_Size numBytes;
+    const char *bytes;
+    const unsigned short *p;
+    Tcl_DString ds;
+    Tcl_Obj *resultPtr;
+
+    if (objc != 2) {
+	Tcl_WrongNumArgs(interp, 1, objv, "bytes");
+	return TCL_ERROR;
+    }
+    bytes = Tcl_GetStringFromObj(objv[1], &numBytes);
+    Tcl_DStringInit(&ds);
+    p = Tcl_UtfToChar16DString(bytes, numBytes, &ds);
+    resultPtr = Tcl_NewObj();
+    for (; *p; p++) {
+	Tcl_ListObjAppendElement(NULL, resultPtr,
+		Tcl_ObjPrintf("%04X", (unsigned) *p));
+    }
+    Tcl_DStringFree(&ds);
+    Tcl_SetObjResult(interp, resultPtr);
+    return TCL_OK;
+}
