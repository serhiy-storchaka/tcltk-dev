+/*
+ *----------------------------------------------------------------------
+ *
+ * NativeIsDevice --
+ *
+ *	Is the native path a device: a \\.\ device namespace path or a
+ *	reserved name like com1 (see WinIsReserved)?
+ *
+ *----------------------------------------------------------------------
+ */
+
+static int
+NativeIsDevice(
+    const WCHAR *path)
+{
+    char buf[6];
+    int i;
+
+    if ((path[0] == '\\' || path[0] == '/')
+	    && (path[1] == '\\' || path[1] == '/') && path[2] == '.'
+	    && (path[3] == '\\' || path[3] == '/')) {
+	/*
+	 * Opening a named pipe would connect to its server.
+	 */
+
+	return _wcsnicmp(path + 4, L"pipe", 4) != 0
+		|| (path[8] != '\\' && path[8] != '/');
+    }
+    for (i = 0; path[i] != 0; i++) {
+	if (i >= 5 || path[i] > 0x7F) {
+	    return 0;
+	}
+	buf[i] = (char) path[i];
+    }
+    buf[i] = '\0';
+    return WinIsReserved(buf) != 0;
+}
