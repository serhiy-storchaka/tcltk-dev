Index: tests/winFile.test
==================================================================
--- tests/winFile.test	
+++ tests/winFile.test	
@@ -213,9 +213,27 @@
 } -result {}
 
 if {[testConstraint win]} {
     file delete $fname
 }
+
+test winFile-5.1 {file exists/readable of a device path [Bug aa9f3ef820]} -constraints {
+    win
+} -body {
+    list [file exists {\\.\nul}] [file readable {\\.\nul}] \
+	[file writable //./nul] [file executable //./nul]
+} -result {1 1 1 0}
+test winFile-5.2 {file exists of reserved names agrees with file type [Bug aa9f3ef820]} -constraints {
+    win
+} -body {
+    set res {}
+    foreach name {com1 com9 lpt1 lpt9 nul} {
+	if {[file exists $name] == [catch {file type $name}]} {
+	    lappend res $name
+	}
+    }
+    set res
+} -result {}
 
 # cleanup
 cleanupTests
 return

