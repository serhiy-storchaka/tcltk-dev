Index: tests/thread.test
==================================================================
--- tests/thread.test
+++ tests/thread.test
@@ -1460,9 +1460,34 @@
 	thread::join $::thread
     }
 } -cleanup {
     unset -nocomplain ::threadCount ::execCount ::threads ::thread
 } -result {}
+
+test thread-9.1 {system encoding changed while used in another thread, bug f2ff05fc84} -constraints {thread} -setup {
+    set origEnc [encoding system]
+    catch {tsv::unset bugf2ff}
+} -body {
+    set t [thread::create -joinable {
+	set long [string repeat a/ 100000]
+	set n 0
+	while {![tsv::exists bugf2ff stop]} {
+	    file exists [string cat $long [incr n]]
+	}
+    }]
+    set t0 [clock milliseconds]
+    set k 0
+    set encs {koi8-r koi8-u cp1251 cp1252}
+    while {[clock milliseconds] - $t0 < 1000} {
+	encoding system [lindex $encs [expr {[incr k] % 4}]]
+    }
+    tsv::set bugf2ff stop 1
+    thread::join $t
+} -cleanup {
+    encoding system $origEnc
+    catch {tsv::unset bugf2ff}
+    unset -nocomplain origEnc t t0 k encs
+} -result 0
 
 # cleanup
 ::tcltest::cleanupTests
 return

