 }
+
+test tcltest-6.7.1 {tcltest::outputChannel, errorChannel - open channel, bug 1528500} {
+    -setup {
+	set of [outputChannel]
+	set ef [errorChannel]
+	set ::tcltest::outputChannel stdout
+	set ::tcltest::errorChannel stderr
+	set f [file tempfile]
+	set pwdFiles [glob -nocomplain -tails -directory [pwd] *]
+    }
+    -body {
+	list [expr {[outputChannel $f] eq $f}] [expr {[outputChannel] eq $f}] \
+	    [expr {[errorChannel $f] eq $f}] [expr {[errorChannel] eq $f}] \
+	    [file exists [file join [pwd] $f]] \
+	    [expr {[glob -nocomplain -tails -directory [pwd] *] eq $pwdFiles}]
+    }
+    -result {1 1 1 1 0 1}
+    -cleanup {
+	set ::tcltest::outputChannel $of
+	set ::tcltest::errorChannel $ef
+	close $f
+    }
+}
 
