 test string-11.55.$noComp {string match, invalid binary optimization} {
     [format string] match \u0141 [binary format c 65]
 } 0
+test string-11.56.$noComp {string match, "]" first in a set (bug [3556218fff])} {
+    set rb \]
+    list [run {string match {[]a]} $rb}] [run {string match {[]a]} a}] \
+	[run {string match {[]a]} b}] [run {string match {x[]]y} x]y}] \
+	[run {string match {[a]]} a]}] [run {string match -nocase {[]A]} a}]
+} {1 1 0 1 1 1}
+test string-11.57.$noComp {string match, "]" first in a set, binary and unicode} {
+    list [run {string match [binary format a* {[]a]}] [binary format a* \]]}] \
+	[run {string match "\[\]ф\]" ф}] [run {string match "\[\]ф\]" \]}]
+} {1 1 1}
 
