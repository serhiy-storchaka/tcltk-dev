+
+test filesystem-1.55 {[Bug 3577801] - .. after link with .. in target} -setup {
+    set home [makeDirectory 3577801]
+    makeDirectory x $home
+    makeDirectory d $home
+} -constraints {unix hasLinks} -body {
+    exec ln -s ../x $home/d/l
+    exec ln -s ./../x/ $home/d/ls
+    exec ln -s l $home/d/ll
+    set home [file normalize $home]
+    set res {}
+    lappend res [expr {[file normalize $home/d/l/../..] eq [file dirname $home]}]
+    foreach p {l/.. l/../y ls/.. ls/../y ll/.. ll/../y} {
+	lappend res [string map [list $home H] [file normalize $home/d/$p]]
+    }
+    set res
+} -cleanup {
+    unset -nocomplain res
+    removeDirectory 3577801
+} -result {1 H H/y H H/y H H/y}
+test filesystem-1.56 {[Bug 3570244] - cd .. from link with .. in target} -setup {
+    set save [pwd]
+    set home [file normalize [makeDirectory 3570244]]
+    makeDirectory x $home
+    makeDirectory d $home
+} -constraints {unix hasLinks} -body {
+    exec ln -s ../x/ $home/d/l
+    cd $home/d/l
+    cd ..
+    string map [list $home H] [pwd]
+} -cleanup {
+    cd $save
+    removeDirectory 3570244
+} -result H
 
