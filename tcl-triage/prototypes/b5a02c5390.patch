Index: library/http/http.tcl
==================================================================
--- library/http/http.tcl
+++ library/http/http.tcl
@@ -3357,10 +3357,19 @@
 #	Unsets the state array.
 
 proc http::cleanup {token} {
     variable $token
     upvar 0 $token state
+    if {    [info exists state(status)] && ($state(status) eq "")
+	 && [info exists state(sock)]
+    } {
+	# The transaction is still in progress.  Stop it, so that no event
+	# handler uses the token after it has been cleaned up, and the socket
+	# is closed or released.  Do not call the -command callback.
+	unset -nocomplain state(-command)
+	catch {reset $token}
+    }
     if {[info commands ${token}--EventCoroutine] ne {}} {
 	rename ${token}--EventCoroutine {}
     }
     if {[info commands ${token}--SocketCoroutine] ne {}} {
 	rename ${token}--SocketCoroutine {}

