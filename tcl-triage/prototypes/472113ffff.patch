--- generic/tclNamesp.c
+++ generic/tclNamesp.c
@@ -4758,12 +4758,41 @@
 	    Tcl_GetCommandFullName(interp, cmd, resultPtr);
 	}
 	break;
     }
     case OPT_VARIABLE: {
-	Tcl_Var var = Tcl_FindNamespaceVar(interp,
-		TclGetString(objv[objc-1]), NULL, /*flags*/ 0);
+	Tcl_Size len;
+	const char *name = TclGetStringFromObj(objv[objc-1], &len);
+	const char *open = NULL;
+	Tcl_Var var;
+
+	if (len > 0 && name[len-1] == ')') {
+	    open = strchr(name, '(');
+	}
+	if (open != NULL) {
+	    /*
+	     * Array element: resolve the array part and append the index,
+	     * whether or not the element exists. [Bug 472113]
+	     */
+
+	    Tcl_DString ds;
+	    Var *varPtr;
+
+	    Tcl_DStringInit(&ds);
+	    Tcl_DStringAppend(&ds, name, open - name);
+	    var = Tcl_FindNamespaceVar(interp, Tcl_DStringValue(&ds), NULL,
+		    /*flags*/ 0);
+	    Tcl_DStringFree(&ds);
+	    varPtr = (Var *) var;
+	    if (varPtr != NULL && !(TclIsVarScalar(varPtr)
+		    && !TclIsVarUndefined(varPtr))) {
+		Tcl_GetVariableFullName(interp, var, resultPtr);
+		Tcl_AppendToObj(resultPtr, open, name + len - open);
+	    }
+	    break;
+	}
+	var = Tcl_FindNamespaceVar(interp, name, NULL, /*flags*/ 0);
 
 	if (var != NULL) {
 	    Tcl_GetVariableFullName(interp, var, resultPtr);
 	}
 	break;

