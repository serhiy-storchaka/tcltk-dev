+/*
+ *---------------------------------------------------------------------------
+ *
+ * CopyFileOrLink --
+ *
+ *	Copy a file, but copy a symbolic link as a link, like on Unix [Bug
+ *	972c35d41d]. Without the privilege to create symbolic links, copy the
+ *	target as before.
+ *
+ *---------------------------------------------------------------------------
+ */
+
+#ifndef COPY_FILE_COPY_SYMLINK
+#   define COPY_FILE_COPY_SYMLINK 0x00000800
+#endif
+
+static BOOL
+CopyFileOrLink(
+    const WCHAR *nativeSrc,
+    const WCHAR *nativeDst)
+{
+    if (CopyFileExW(nativeSrc, nativeDst, NULL, NULL, NULL,
+	    COPY_FILE_COPY_SYMLINK)) {
+	return TRUE;
+    }
+    if (GetLastError() != ERROR_PRIVILEGE_NOT_HELD) {
+	return FALSE;
+    }
+    return CopyFileW(nativeSrc, nativeDst, 0);
+}
