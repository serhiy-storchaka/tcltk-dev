 		reqPtr, INT2PTR(reqc), reqv, NULL);
 	return TCL_OK;
     }
+
+    if (reqPtr->pkgPtr->clientData == unknownInProgress) {
+	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
+		"circular package dependency:"
+		" attempt to find %s requires %s", name, name));
+	AddRequirementsToResult(interp, reqc, reqv);
+	Tcl_AppendResult(interp, " (\"package require\" in an index script?)",
