 } Package;
 
+/*
+ * Marker stored in Package.clientData while the "package unknown" script is
+ * running for that package, to detect [package require] of the same package
+ * from an index script.
+ */
+
+static const char unknownInProgress[] = "";
+
 typedef struct Require {
     void *clientDataPtr;
