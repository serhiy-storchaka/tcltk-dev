+	Tcl_SetErrorCode(interp, "TCL", "PACKAGE", "CIRCULARITY", (char *)NULL);
+	return TCL_ERROR;
+    }
 
     /*
      * Invoke the "package unknown" script synchronously.
      */
 
+    if (reqPtr->pkgPtr->clientData == NULL) {
