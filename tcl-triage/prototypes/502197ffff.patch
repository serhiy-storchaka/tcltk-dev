+
+/*
+ *----------------------------------------------------------------------
+ *
+ * TestwinsetenvCmd --
+ *
+ *	Sets (or with no value, removes) a variable in the process
+ *	environment block with SetEnvironmentVariableW, bypassing the C
+ *	runtime, as an embedder or extension might do. [Bug 502197]
+ *
+ * Usage:
+ *	testwinsetenv name ?value?
+ *
+ *----------------------------------------------------------------------
+ */
+
+static int
+TestwinsetenvCmd(
+    TCL_UNUSED(void *),
+    Tcl_Interp *interp,		/* Tcl interpreter */
+    Tcl_Size objc,		/* Parameter count */
+    Tcl_Obj *const * objv)	/* Parameter vector */
+{
+    Tcl_DString nameDs, valueDs;
+    BOOL ok;
+
+    if (objc < 2 || objc > 3) {
+	Tcl_WrongNumArgs(interp, 1, objv, "name ?value?");
+	return TCL_ERROR;
+    }
+    Tcl_DStringInit(&nameDs);
+    Tcl_DStringInit(&valueDs);
+    Tcl_UtfToWCharDString(Tcl_GetString(objv[1]), -1, &nameDs);
+    if (objc == 3) {
+	Tcl_UtfToWCharDString(Tcl_GetString(objv[2]), -1, &valueDs);
+    }
+    ok = SetEnvironmentVariableW((WCHAR *)Tcl_DStringValue(&nameDs),
+	    (objc == 3) ? (WCHAR *)Tcl_DStringValue(&valueDs) : NULL);
+    Tcl_DStringFree(&nameDs);
+    Tcl_DStringFree(&valueDs);
+    if (!ok) {
+	Tcl_WinConvertError(GetLastError());
+	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
+		"SetEnvironmentVariable failed: %s", Tcl_PosixError(interp)));
+	return TCL_ERROR;
+    }
+    return TCL_OK;
+}
 
