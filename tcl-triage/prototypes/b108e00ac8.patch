 	return TCL_ERROR;
     }
 
     /*
-     * If already exists, either a constant (no problem) or an error.
+     * If already exists, either a constant with the same value (no problem)
+     * or an error.
      */
     if (!TclIsVarUndefined(varPtr)) {
 	if (TclIsVarConstant(varPtr)) {
+	    if (TclConstValueDiffers(varPtr, objv[2])) {
+		TclObjVarErrMsg(interp, part1Ptr, NULL, "make constant",
+			CONSTDIFF, -1);
+		Tcl_SetErrorCode(interp, "TCL", "LOOKUP", "CONST", (char *)NULL);
+		return TCL_ERROR;
+	    }
 	    return TCL_OK;
 	}
 	TclObjVarErrMsg(interp, part1Ptr, NULL, "make constant", EXISTS, -1);
 	Tcl_SetErrorCode(interp, "TCL", "LOOKUP", "CONST", (char *)NULL);
 	return TCL_ERROR;

