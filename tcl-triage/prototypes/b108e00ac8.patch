+static const char CONSTDIFF[] =		"constant has a different value";
 
 /*
  * A test to see if we are in a call frame that has local variables. This is
  * true if we are inside a procedure body.
  */
@@ -4874,10 +4875,34 @@
 }
 
 /*
  *----------------------------------------------------------------------
  *
+ * TclConstValueDiffers --
+ *
+ *	Checks whether redefining the constant in varPtr with valuePtr would
+ *	change its value (string comparison).
+ *
+ *----------------------------------------------------------------------
+ */
+
+int
+TclConstValueDiffers(
+    Var *varPtr,		/* An existing constant. */
+    Tcl_Obj *valuePtr)		/* The new value. */
+{
+    Tcl_Obj *oldPtr = varPtr->value.objPtr;
+
+    if (oldPtr == valuePtr) {
+	return 0;
+    }
+    return TclStringCmp(oldPtr, valuePtr, 1, 0, -1) != 0;
+}
+
+/*
+ *----------------------------------------------------------------------
+ *
  * Tcl_ConstObjCmd --
  *
  *	This function is invoked to process the "const" Tcl command.
  *	See the user documentation for details on what it does.
  *
@@ -4924,14 +4949,21 @@
