Index: generic/tclCompExpr.c
==================================================================
--- generic/tclCompExpr.c
+++ generic/tclCompExpr.c
@@ -2390,14 +2390,21 @@
 	    Tcl_Size target;
 	    Tcl_BytecodeLabel pc1, pc2;
 
 	    switch (nodePtr->lexeme) {
 	    case START:
-	    case QUESTION:
 		if (convert && (nodePtr == rootPtr)) {
 		    OP(		TRY_CVT_TO_NUMERIC);
 		}
+		break;
+	    case QUESTION:
+		/*
+		 * A QUESTION node is the root only when a constant subexpression
+		 * is precomputed. Leave its value alone, as in the non-constant
+		 * case; the enclosing START converts it if needed. [3107983]
+		 */
+
 		break;
 	    case OPEN_PAREN:
 
 		/* do nothing */
 		break;
@@ -2563,11 +2570,17 @@
 		    TclEmitPush(idx, envPtr);
 		} else {
 		    TclCompileSyntaxError(interp, envPtr);
 		}
 		Tcl_RestoreInterpState(interp, save);
-		convert = false;
+
+		/*
+		 * The precomputed value may be a string from a ?: branch, so let
+		 * the root convert it, as it would for a literal.
+		 */
+
+		convert = true;
 	    } else {
 		nodePtr = nodes + next;
 	    }
 	}
     }

