--- tests/compExpr.test
+++ tests/compExpr.test
@@ -404,10 +404,25 @@
 	# + $def\\
 	+ $ghi
     }}]
 } -result {loadStk loadStk add}
 
+test compExpr-9.1 {constant ?: as function argument is not converted, bug 3107983} -setup {
+    proc tcl::mathfunc::compExprFoo x {return <$x>}
+    proc compExprP {} {
+	set x 1
+	list [expr {compExprFoo($x ? " 0x42 " : " 0x41 ")}] \
+	    [expr {compExprFoo(1 ? " 0x42 " : " 0x41 ")}] \
+	    [expr {1 ? " 0x42 " : " 0x41 "}] [expr {(1 ? " 0x42 " : "a") + 1}]
+    }
+} -body {
+    compExprP
+} -cleanup {
+    rename compExprP {}
+    rename tcl::mathfunc::compExprFoo {}
+} -result {{< 0x42 >} {< 0x42 >} 66 67}
+
 # cleanup
 catch {unset a}
 catch {unset b}
 catch {rename extract ""}
