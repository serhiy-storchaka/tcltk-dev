+test package-bug-209fd9adce {
+	Bug 209fd9adce - package files lists pkgIndex.tcl sourced by package unknown
+} -setup {
+	set dir [makeDirectory pkg209fd9adce]
+	foreach sub {a b} {
+	    file mkdir [file join $dir $sub]
+	}
+	makeFile {
+	    foreach sub {a b} {
+		set dir [file join [file dirname [info script]] $sub]
+		source [file join $dir pkgIndex.tcl]
+	    }
+	} pkgIndex.tcl $dir
+	makeFile {package ifneeded aa 1.0 [list source [file join $dir aa.tcl]]} \
+		pkgIndex.tcl [file join $dir a]
+	makeFile {catch {package require nonexistent209fd9adce}; package provide aa 1.0} \
+		aa.tcl [file join $dir a]
+	makeFile {package ifneeded bb 1.0 {package provide bb 1.0}} \
+		pkgIndex.tcl [file join $dir b]
+	set ip [interp create]
+	$ip eval [list lappend auto_path $dir]
+} -cleanup {
+	interp delete $ip
+	removeDirectory pkg209fd9adce
+	unset -nocomplain ip dir sub
+} -body {
+	$ip eval {package require aa}
+	lmap f [$ip eval {package files aa}] {
+	    file join [file tail [file dirname $f]] [file tail $f]
+	}
+} -result {a/pkgIndex.tcl a/aa.tcl}
+
 rename prefer {}
 
 set auto_path $oldPath
 package unknown $oldPkgUnknown
 

