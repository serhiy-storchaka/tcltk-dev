Index: unix/tclEpollNotfy.c
==================================================================
--- unix/tclEpollNotfy.c
+++ unix/tclEpollNotfy.c
@@ -407,11 +407,18 @@
     }
     if (eventPtr->events & EPOLLOUT) {
 	mask |= TCL_WRITABLE;
     }
     if (eventPtr->events & EPOLLERR) {
-	mask |= TCL_EXCEPTION;
+	/*
+	 * An error condition (e.g. the reading end of a pipe was closed)
+	 * makes reads and writes return immediately, as select() reports.
+	 * Otherwise a handler waiting for TCL_WRITABLE never fires and the
+	 * level-triggered EPOLLERR makes the notifier spin.
+	 */
+
+	mask |= TCL_READABLE | TCL_WRITABLE | TCL_EXCEPTION;
     }
     return mask;
 }
 
