+test interp-31.2 {alias to parent does not leak stale errorstack [Bug 77f0dbc0f8]} -setup {
+    interp create child
+    interp alias child foo {} interpBug77f0
+    proc interpBug77f0 {arg} {}
+} -body {
+    catch {error "caught error"}
+    catch {interp eval child foo} msg opts
+    dict get $opts -errorstack
+} -cleanup {
+    interp delete child
+    rename interpBug77f0 {}
+} -match glob -result {INNER {invokeStk foo}*}
 
