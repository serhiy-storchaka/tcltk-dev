Index: tests/info.test
==================================================================
--- tests/info.test
+++ tests/info.test
@@ -2639,10 +2639,26 @@
 } -cleanup {
     interp delete child
 } -body {
     child invokehidden info frame
 } -result 1
+
+testConstraint testevalex [llength [info commands testevalex]]
+test info-42.1 {Bug 3156499: line of a command with a dynamic command word} -setup {
+    proc ::info42 {} {lappend ::info42res [dict get [info frame -1] line]}
+    set ::info42res {}
+} -constraints testevalex -body {
+    testevalex {set cmd42 info42
+$cmd42
+[string cat info42]
+{*}[list info42]
+info42}
+    set ::info42res
+} -cleanup {
+    rename ::info42 {}
+    unset -nocomplain ::info42res ::cmd42
+} -result {2 3 4 5}
 
 # cleanup
 catch {namespace delete test_ns_info1 test_ns_info2}
 ::tcltest::cleanupTests
 return

