Index: generic/tclBasic.c
==================================================================
--- generic/tclBasic.c
+++ generic/tclBasic.c
@@ -4907,11 +4907,20 @@
     Namespace *currNsPtr = NULL;/* Used to check for and invoke any registered
 				 * unknown command handler for the current
 				 * namespace (TIP 181). */
     Namespace *savedNsPtr = NULL;
 
-    currNsPtr = varFramePtr->nsPtr;
+    /*
+     * Prefer the handler of the namespace the command was looked up in, if
+     * that was given explicitly (e.g. by [tailcall], [Bug f7afd3dbef]).
+     */
+
+    if ((lookupNsPtr != NULL) && (lookupNsPtr->unknownHandlerPtr != NULL)) {
+	currNsPtr = lookupNsPtr;
+    } else {
+	currNsPtr = varFramePtr->nsPtr;
+    }
     if ((currNsPtr == NULL) || (currNsPtr->unknownHandlerPtr == NULL)) {
 	currNsPtr = iPtr->globalNsPtr;
 	if (currNsPtr == NULL) {
 	    Tcl_Panic("TEOV_NotFound: NULL global namespace pointer");
 	}

