--- tests/unixFCmd.test
+++ tests/unixFCmd.test
@@ -16,10 +16,11 @@
 
 ::tcltest::loadTestedCommands
 catch [list package require -exact tcl::test [info patchlevel]]
 
 testConstraint testchmod [llength [info commands testchmod]]
+testConstraint testthread [llength [info commands testthread]]
 # File permissions broken on wsl without some "exotic" wsl configuration
 testConstraint notWsl [expr {[llength [array names ::env *WSL*]] == 0}]
 
 # These tests really need to be run from a writable directory, which
 # it is assumed [temporaryDirectory] is.
@@ -244,10 +245,51 @@
 test unixFCmd-4.1 {TclpDeleteFile not done} {emptyTest unix notRoot} {
 } {}
 
 test unixFCmd-5.1 {TclpCreateDirectory not done} {emptyTest unix notRoot} {
 } {}
+test unixFCmd-5.2 {TclpCreateDirectory: umask and u+rwx} -setup {
+    cleanup
+    set script [makeFile {
+	file mkdir td1
+	puts [format %o [expr {[file attributes td1 -permissions] & 0o777}]]
+    } umask.tcl]
+} -constraints {unix notRoot notWsl} -body {
+    list [exec /bin/sh -c "umask 027; exec [list [interpreter]] $script"] \
+	[file delete td1] \
+	[exec /bin/sh -c "umask 0777; exec [list [interpreter]] $script"]
+} -cleanup {
+    removeFile umask.tcl
+    file delete td1
+    unset -nocomplain script
+} -result {750 {} 700}
+test unixFCmd-5.3 {TclpCreateDirectory: umask not changed by threads, bug cd609219f5} -setup {
+    cleanup
+    set script [makeFile {
+	catch [list package require -exact tcl::test [info patchlevel]]
+	file mkdir td1
+	set ids {}
+	for {set i 0} {$i < 4} {incr i} {
+	    lappend ids [testthread create [list apply {{i} {
+		for {set j 0} {$j < 500} {incr j} {
+		    file mkdir td1/t$i-$j
+		}
+	    }} $i]]
+	}
+	while {[llength [testthread names]] > 1} {
+	    after 10
+	}
+	close [open td1/f w]
+	puts [format %o [expr {[file attributes td1/f -permissions] & 0o777}]]
+    } umask.tcl]
+} -constraints {unix notRoot notWsl testthread} -body {
+    exec /bin/sh -c "umask 022; exec [list [interpreter]] $script"
+} -cleanup {
+    removeFile umask.tcl
+    file delete -force td1
+    unset -nocomplain script
+} -result 644
 
