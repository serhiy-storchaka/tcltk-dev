Index: unix/tclUnixFCmd.c
==================================================================
--- unix/tclUnixFCmd.c
+++ unix/tclUnixFCmd.c
@@ -686,24 +686,26 @@
 
 static int
 DoCreateDirectory(
     const char *path)		/* Pathname of directory to create (native). */
 {
-    mode_t mode;
-
-    mode = umask(0);
-    umask(mode);
+    Tcl_StatBuf statBuf;
 
     /*
-     * umask return value is actually the inverse of the permissions.
+     * Let mkdir() apply the umask, then add u+rwx if the umask removed any
+     * of these bits. Don't query the umask with umask(0) + umask(mode): that
+     * temporarily changes it for the whole process, and concurrent calls from
+     * several threads can leave it at 0. [Bug cd609219f5]
      */
 
-    mode = (0777 & ~mode) | S_IRUSR | S_IWUSR | S_IXUSR;
-
-    if (mkdir(path, mode) != 0) {			/* INTL: Native. */
+    if (mkdir(path, 0777) != 0) {			/* INTL: Native. */
 	return TCL_ERROR;
     }
+    if (TclOSstat(path, &statBuf) == 0				/* INTL: Native. */
+	    && (statBuf.st_mode & S_IRWXU) != S_IRWXU) {
+	chmod(path, (statBuf.st_mode & 07777) | S_IRWXU);	/* INTL: Native. */
+    }
     return TCL_OK;
 }
 
