+/*
+ *----------------------------------------------------------------------
+ *
+ * SetReadFileError --
+ *
+ *	Closes the channel and sets the interpreter result to the error
+ *	message for a failed read of a script file. For an encoding error,
+ *	the line number of the invalid byte sequence is reported.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static void
+SetReadFileError(
+    Tcl_Interp *interp,
+    Tcl_Channel chan,
+    Tcl_Obj *pathPtr,
+    Tcl_Obj *objPtr)		/* Data read before the error. */
+{
+    int code = Tcl_GetErrno();
+    Tcl_Size length, i, line = 1;
+    const char *data;
+
+    Tcl_CloseEx(interp, chan, 0);
+    Tcl_SetErrno(code);
+    if (code == EILSEQ) {
+	data = TclGetStringFromObj(objPtr, &length);
+	for (i = 0; i < length; i++) {
+	    if (data[i] == '\n') {
+		line++;
+	    }
+	}
+	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
+		"couldn't read file \"%s\": %s at line %" TCL_SIZE_MODIFIER "d",
+		TclGetString(pathPtr), Tcl_PosixError(interp), line));
+    } else {
+	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
+		"couldn't read file \"%s\": %s",
+		TclGetString(pathPtr), Tcl_PosixError(interp)));
+    }
+}
 
