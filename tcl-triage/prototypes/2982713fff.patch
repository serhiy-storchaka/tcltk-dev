 # Tests specific to Windows which has more varied application types and
 # search mechanism.
 

Index: unix/tclUnixInit.c
==================================================================
--- unix/tclUnixInit.c
+++ unix/tclUnixInit.c
@@ -365,10 +365,27 @@
 
 #ifdef SIGPIPE
     (void) signal(SIGPIPE, SIG_IGN);
 #endif /* SIGPIPE */
 
+    /*
+     * If SIGCHLD is ignored (inherited from the parent process), terminated
+     * children are reaped automatically and [exec] cannot get their exit
+     * status. Restore the default handling in that case only.
+     */
+
+#ifdef SIGCHLD
+    {
+	struct sigaction sa;
+
+	if (sigaction(SIGCHLD, NULL, &sa) == 0 && !(sa.sa_flags & SA_SIGINFO)
+		&& sa.sa_handler == SIG_IGN) {
+	    (void) signal(SIGCHLD, SIG_DFL);
+	}
+    }
+#endif /* SIGCHLD */
+
     /*
      * Ignore SIGXFSZ too, so that writing a file beyond the file size limit
      * (ulimit -f) fails with an error instead of killing the process.
      */
 

