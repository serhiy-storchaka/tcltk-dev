+test filesystem-1.55 {Bug 953284: normalized path cache outdated by file link} -setup {
+    set w [makeDirectory wrong]
+    makeFile wrong file $w
+    set r [makeDirectory right]
+    makeFile right file $r
+    set link [file join [file dirname $w] link953284]
+    file link $link $w
+} -constraints hasLinks -body {
+    set p1 [file join $link file]
+    set p2 [file join $link file]
+    file normalize $p1
+    file delete $link
+    file link $link $r
+    list [file tail [file dirname [file normalize $p1]]] \
+	    [file tail [file dirname [file normalize $p2]]]
+} -cleanup {
+    file delete $link
+    removeFile file $r
+    removeDirectory right
+    removeFile file $w
+    removeDirectory wrong
+} -result {right right}
 
