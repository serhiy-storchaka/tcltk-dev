+	    if (bytes) {
+		/*
+		 * Counting newlines in the source misses the continuation
+		 * lines (backslash-newline) that were already substituted
+		 * there. Use the TIP #280 line information if we have it.
+		 * [Bug 7cc2239087]
+		 */
+
+		Tcl_HashEntry *hePtr =
+			Tcl_FindHashEntry(iPtr->lineBCPtr, codePtr);
+
+		if (hePtr) {
+		    ExtCmdLoc *eclPtr = (ExtCmdLoc *)Tcl_GetHashValue(hePtr);
+		    Tcl_Size i, srcOffset = bytes - codePtr->source;
+
+		    for (i = 0; i < eclPtr->nuloc; i++) {
+			if (eclPtr->loc[i].srcOffset == srcOffset) {
+			    if (eclPtr->start > 0
+				    && eclPtr->loc[i].line[0] >= eclPtr->start) {
+				iPtr->errorLine = (int) (eclPtr->loc[i].line[0]
+					- eclPtr->start + 1);
+			    }
+			    break;
+			}
+		    }
+		}
+	    }
 	}
