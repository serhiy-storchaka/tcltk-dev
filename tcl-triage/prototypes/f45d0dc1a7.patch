+/*
+ *----------------------------------------------------------------------
+ *
+ * TestUniCharAtIndexCmd --
+ *
+ *	Used to check correct operation of Tcl_UniCharAtIndex
+ *	    testunicharatindex STRING INDEX
+ *
+ *----------------------------------------------------------------------
+ */
+static int
+TestUniCharAtIndexCmd(
+    TCL_UNUSED(void *),
+    Tcl_Interp *interp,		/* Current interpreter */
+    Tcl_Size objc,
+    Tcl_Obj *const *objv)	/* Argument strings */
+{
+    Tcl_WideInt index;
+
+    if (objc != 3) {
+	Tcl_WrongNumArgs(interp, 1, objv, "STRING INDEX");
+	return TCL_ERROR;
+    }
+    if (Tcl_GetWideIntFromObj(interp, objv[2], &index) != TCL_OK) {
+	return TCL_ERROR;
+    }
+    Tcl_SetObjResult(interp, Tcl_NewIntObj(
+	    Tcl_UniCharAtIndex(Tcl_GetString(objv[1]), (Tcl_Size)index)));
+    return TCL_OK;
+}
