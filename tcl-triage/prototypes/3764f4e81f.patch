@@ -748,10 +748,25 @@
 
     if {[catch {eof $sock} res] || $res} {
 	# The server has half-closed the socket.
 	# If a new write has started, its transaction will fail and
 	# will then be error-handled.
+	variable socketMapping
+	variable socketCoEvent
+	set map [array get socketMapping]
+	set ndx [lsearch -exact $map $sock]
+	if {    ($ndx > 0)
+	     && [info exists socketCoEvent([lindex $map $ndx-1])]
+	     && [dict size $socketCoEvent([lindex $map $ndx-1])]
+	} {
+	    # A request has already been scheduled (by an idle-time
+	    # OpenSocket) to reuse this socket.  Leave the socket to that
+	    # request, which will detect eof and replay itself on a new
+	    # socket [Bug 3764f4e81f].
+	    catch {fileevent $sock readable {}}
+	    return
+	}
 	CloseSocket $sock
     }
     return
 }
 
