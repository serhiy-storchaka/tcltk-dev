+
+/*
+ *----------------------------------------------------------------------
+ *
+ * ChildNameKey --
+ *
+ *	Returns the key under which a child interpreter name is stored in the
+ *	childTable. The interpreter command is always created relative to the
+ *	global namespace, so "foo" and "::foo" name the same command and must
+ *	name the same interpreter. [Bug 66c2e8c974]
+ *
+ *----------------------------------------------------------------------
+ */
+
+static const char *
+ChildNameKey(
+    const char *name)
+{
+    if (name[0] == ':' && name[1] == ':') {
+	while (*name == ':') {
+	    name++;
+	}
+    }
+    return name;
+}
 
