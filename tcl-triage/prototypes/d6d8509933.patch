+
+    case BIGNUM_FROMDOUBLE: {
+	void *ptr;
+	int type;
+
+	if (objc != 4) {
+	    Tcl_WrongNumArgs(interp, 2, objv, "varIndex double");
+	    return TCL_ERROR;
+	}
+
+	/*
+	 * Unlike Tcl_GetDoubleFromObj, this lets NaN through, so that
+	 * Tcl_InitBignumFromDouble can be tested with it. [Bug d6d8509933]
+	 */
+
+	if (Tcl_GetNumberFromObj(interp, objv[3], &ptr, &type) != TCL_OK) {
+	    return TCL_ERROR;
+	}
+	if (type != TCL_NUMBER_DOUBLE && type != TCL_NUMBER_NAN) {
+	    Tcl_SetObjResult(interp, Tcl_NewStringObj(
+		    "expected floating-point value", -1));
+	    return TCL_ERROR;
+	}
+	if (Tcl_InitBignumFromDouble(interp, *(double *)ptr,
+		&bignumValue) != TCL_OK) {
+	    return TCL_ERROR;
+	}
+	if ((varPtr[varIndex] != NULL) && !Tcl_IsShared(varPtr[varIndex])) {
+	    Tcl_SetBignumObj(varPtr[varIndex], &bignumValue);
+	} else {
+	    SetVarToObj(varPtr, varIndex, Tcl_NewBignumObj(&bignumValue));
+	}
+	break;
+    }
     }
 
     Tcl_SetObjResult(interp, varPtr[varIndex]);
     return TCL_OK;
