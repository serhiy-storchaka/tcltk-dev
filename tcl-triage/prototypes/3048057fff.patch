 #ifndef PTHREAD_NULL
 #   define PTHREAD_NULL (pthread_t)0
 #endif
 
+/*
+ * Lazily created mutexes and condition variables are published with a
+ * double-checked locking scheme, and the owner of a reentrant mutex is read
+ * without holding the lock. Use atomic accesses for these, so that the
+ * pointer is never seen before the object it points to is initialized and
+ * thread checkers (e.g. ThreadSanitizer) see no data race. [Bug 3048057]
+ */
+
+#if defined(__GNUC__)
+#   define LoadAcquire(ptr)	__atomic_load_n((ptr), __ATOMIC_ACQUIRE)
+#   define StoreRelease(ptr, val) __atomic_store_n((ptr), (val), __ATOMIC_RELEASE)
+#   define LoadOwner(ptr, val)	__atomic_load((ptr), &(val), __ATOMIC_RELAXED)
+#   define StoreOwner(ptr, val)	do { \
+	pthread_t tmp_ = (val); __atomic_store((ptr), &tmp_, __ATOMIC_RELAXED); \
+    } while (0)
+#else
+#   define LoadAcquire(ptr)	(*(ptr))
+#   define StoreRelease(ptr, val) (*(ptr) = (val))
+#   define LoadOwner(ptr, val)	((val) = *(ptr))
+#   define StoreOwner(ptr, val)	(*(ptr) = (val))
+#endif
+
 typedef struct PMutex {
     pthread_mutex_t mutex;
     volatile pthread_t thread;
     int counter; // Number of additional locks in the same thread.
 } PMutex;
