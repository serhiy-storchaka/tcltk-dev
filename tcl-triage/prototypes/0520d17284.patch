+/*
+ *----------------------------------------------------------------------
+ *
+ * LinkAfterPtr, UnlinkAfterPtr --
+ *
+ *	Add an "after" command to the head of the doubly-linked list of those
+ *	pending for an interpreter, or remove it from that list in constant
+ *	time. [Bug 0520d17284]
+ *
+ *----------------------------------------------------------------------
+ */
+
+static void
+LinkAfterPtr(
+    AfterAssocData *assocPtr,
+    AfterInfo *afterPtr)
+{
+    afterPtr->prevPtr = NULL;
+    afterPtr->nextPtr = assocPtr->firstAfterPtr;
+    if (afterPtr->nextPtr != NULL) {
+	afterPtr->nextPtr->prevPtr = afterPtr;
+    }
+    assocPtr->firstAfterPtr = afterPtr;
+}
+
+static void
+UnlinkAfterPtr(
+    AfterInfo *afterPtr)
+{
+    if (afterPtr->prevPtr == NULL) {
+	afterPtr->assocPtr->firstAfterPtr = afterPtr->nextPtr;
+    } else {
+	afterPtr->prevPtr->nextPtr = afterPtr->nextPtr;
+    }
+    if (afterPtr->nextPtr != NULL) {
+	afterPtr->nextPtr->prevPtr = afterPtr->prevPtr;
+    }
+}
 
