  * Side Effects:
  *	May alter the Tcl_Obj's type. May set the interpreter result.
  *
  *----------------------------------------------------------------------
  */
+/*
+ * Convert a double to a wide integer, saturating instead of overflowing
+ * (casting an out-of-range double is undefined behaviour). [Bug 475db43843]
+ */
+static inline Tcl_WideInt
+DoubleToWide(
+    double d)
+{
+    if (d >= (double)WIDE_MAX) {	/* (double)WIDE_MAX is 2**63 */
+	return WIDE_MAX;
+    } else if (d <= (double)WIDE_MIN) {
+	return WIDE_MIN;
+    } else if (isnan(d)) {
+	return 0;
+    }
+    return (Tcl_WideInt)d;
+}
