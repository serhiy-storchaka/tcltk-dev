--- tests/interp.test
+++ tests/interp.test
@@ -2453,10 +2453,56 @@
 	interp hide {} bar
     }
     namespace delete foo
     list [catch {interp invokehidden {} foo::bar} msg] $msg
 } {1 {invalid hidden command name "foo"}}
+test interp-27.9 {interp alias: unqualified srcCmd is created in the global namespace [3047802fff]} -body {
+    namespace eval foo {
+	interp alias {} aliasBug3047 {} return
+    }
+    list [info commands ::aliasBug3047] [info commands ::foo::aliasBug3047] \
+	[namespace eval foo {aliasBug3047 -level 0 ok}]
+} -cleanup {
+    rename ::aliasBug3047 {}
+    namespace delete foo
+} -result {::aliasBug3047 {} ok}
+test interp-27.10 {interp alias: relative qualified srcCmd is relative to the current namespace [3047802fff]} -body {
+    namespace eval foo {
+	set tok [interp alias {} foo::aliasBug3047 {} return]
+	interp alias {} ::foo::aliasBug3047b {} return
+    }
+    list $foo::tok [info commands ::foo::foo::aliasBug3047] \
+	[info commands ::foo::aliasBug3047] [info commands ::foo::aliasBug3047b]
+} -cleanup {
+    namespace delete foo
+} -result {foo::aliasBug3047 ::foo::foo::aliasBug3047 {} ::foo::aliasBug3047b}
+test interp-27.11 {interp alias: unqualified targetCmd is resolved in the global namespace [3047802fff]} -setup {
+    proc aliasTarget3047 {} {return global}
+    namespace eval foo {
+	proc aliasTarget3047 {} {return foo}
+    }
+} -body {
+    namespace eval foo {
+	interp alias {} ::foo::aliasBug3047 {} aliasTarget3047
+	aliasBug3047
+    }
+} -cleanup {
+    namespace delete foo
+    rename aliasTarget3047 {}
+} -result global
+test interp-27.12 {child alias: unqualified srcCmd is created in the child's global namespace [3047802fff]} -setup {
+    set i [interp create]
+} -body {
+    $i eval {namespace eval foo {}}
+    namespace eval foo {
+	$::i alias aliasBug3047 return
+    }
+    list [$i eval {info commands ::aliasBug3047}] [$i eval {info commands ::foo::aliasBug3047}]
+} -cleanup {
+    interp delete $i
+    namespace delete foo
+} -result {::aliasBug3047 {}}
 
