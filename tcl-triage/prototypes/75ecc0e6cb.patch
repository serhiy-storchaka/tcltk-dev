+    interp delete [interp create]
+    list [lindex [encoding dirs] 0] \
+	    [expr {[file join $::tcl_library encoding] in [encoding dirs]}]
+} -cleanup {
+    encoding dirs $origPath
+} -result {slappy 1}
 
