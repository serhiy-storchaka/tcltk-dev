+		Tcl_FSJoinToPath(objPtr, 1, &encObj), TCL_SIZE_MAX);
+	TclListObjLength(NULL, searchPathObj, &newLen);
+	if (newLen > oldLen) {
+	    Tcl_SetEncodingSearchPath(searchPathObj);
+	}
+	Tcl_DecrRefCount(searchPathObj);
+	Tcl_DecrRefCount(encObj);
+    }
