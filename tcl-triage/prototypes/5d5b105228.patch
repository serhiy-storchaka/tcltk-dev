+test switch-20.1 {TIP 280: line numbers in nested non-compiled switch, bug 5d5b105228} -setup {
+    # Body not a literal: line numbers are relative to each script.
+    proc foo {sw s} [string trim {
+	$sw [string index $s 0] {
+	    a {
+		$sw -exact -nocase -- [string index $s 1] {
+		    a {
+			dict get [info frame 0] line
+		    }
+		    b {
+			dict get [info frame 0] line
+		    }
+		    c {
+			dict get [info frame 0] line
+		    }
+		}
+	    }
+	}
+    }]
+} -body {
+    set res [lmap s {aa ab ac} {foo switch $s}]
+    # Literal body: absolute line numbers in this file.
+    proc foo {sw s} {
+	$sw $s {
+	    a {
+		dict get [info frame 0] line
+	    }
+	    b {
+		dict get [info frame 0] line
+	    }
+	}
+    }
+    set l [dict get [info frame 0] line]
+    lappend res {*}[lmap s {a b} {expr {[foo switch $s] - $l}}]
+} -cleanup {
+    rename foo {}
+    unset -nocomplain res l
+} -result {2 2 2 -7 -4}
+
 # cleanup
 catch {rename foo {}}
