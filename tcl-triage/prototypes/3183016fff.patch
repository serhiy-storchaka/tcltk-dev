--- tests/winFile.test	
+++ tests/winFile.test	
@@ -213,9 +213,28 @@
 } -result {}
 
 if {[testConstraint win]} {
     file delete $fname
 }
+
+test winFile-5.1 {cd .. from a junction: pwd and relative paths agree [Bug 3183016]} -constraints {
+    win
+} -setup {
+    set savedir [pwd]
+    set base [makeDirectory winFile-5.1]
+    file mkdir $base/test1/test2
+    close [open $base/test1/test2/in_test2 w]
+    file link -symbolic $base/test1/test2/link $base/test1
+} -body {
+    cd $base/test1/test2/link
+    cd ..
+    list [expr {[pwd] eq [file normalize $base]}] [lsort [glob *]] \
+	[file isdirectory test1] [file exists in_test2]
+} -cleanup {
+    cd $savedir
+    file delete $base/test1/test2/link
+    removeDirectory winFile-5.1
+} -result {1 test1 1 0}
 
 # cleanup
 cleanupTests
 return

