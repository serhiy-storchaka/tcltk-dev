+/*
+ *----------------------------------------------------------------------
+ *
+ * RedirectedStreams --
+ *
+ *	Scans the arguments of a pipeline for redirections of the standard
+ *	input and output, without opening any file or creating any process.
+ *	Used by Tcl_OpenCommandChannel to reject a pipeline that conflicts
+ *	with the access mode before it is started.
+ *
+ * Results:
+ *	An OR-ed combination of TCL_STDIN and TCL_STDOUT.
+ *
+ * Side effects:
+ *	None.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static int
+RedirectedStreams(
+    Tcl_Size argc,		/* Number of entries in argv. */
+    const char **argv)		/* Pipeline arguments, as for
+				 * TclCreatePipeline. */
+{
+    Tcl_Size i;
+    int result = 0;
+
+    for (i = 0; i < argc; i++) {
+	const char *p = argv[i];
+
+	if (*p == '<') {
+	    result |= TCL_STDIN;
+	} else if (*p == '>') {
+	    result |= TCL_STDOUT;
+	} else if (p[0] == '2' && p[1] == '>') {
+	    p++;
+	} else {
+	    continue;
+	}
+
+	/*
+	 * A bare operator (e.g. ">" or "2>@") takes the next argument.
+	 */
+
+	if (p[strspn(p, "<>&@")] == '\0') {
+	    i++;
+	}
+    }
+    return result;
+}
+
