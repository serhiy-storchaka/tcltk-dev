Index: unix/tclUnixFile.c
==================================================================
--- unix/tclUnixFile.c
+++ unix/tclUnixFile.c
@@ -506,11 +506,13 @@
 	    ((types->perm & TCL_GLOB_PERM_R) &&
 		(access(nativeEntry, R_OK) != 0)) ||
 	    ((types->perm & TCL_GLOB_PERM_W) &&
 		(access(nativeEntry, W_OK) != 0)) ||
 	    ((types->perm & TCL_GLOB_PERM_X) &&
-		(access(nativeEntry, X_OK) != 0))
+		((access(nativeEntry, X_OK) != 0)
+		|| !(S_ISDIR(buf.st_mode)
+		|| (buf.st_mode & (S_IXUSR|S_IXGRP|S_IXOTH)))))
 #ifndef MAC_OSX_TCL
 	    || ((types->perm & TCL_GLOB_PERM_HIDDEN) &&
 		(*nativeName != '.'))
 #endif /* MAC_OSX_TCL */
 		) {
@@ -676,11 +678,28 @@
     const char *path = (const char *)Tcl_FSGetNativePath(pathPtr);
 
     if (path == NULL) {
 	return -1;
     }
-    return access(path, mode);
+    if (access(path, mode) != 0) {
+	return -1;
+    }
+    if ((mode & X_OK) && geteuid() == 0) {
+	/*
+	 * POSIX allows access() to grant X_OK to the superuser even if no
+	 * execute bit is set (Solaris does so). [Bug 219254]
+	 */
+
+	Tcl_StatBuf buf;
+
+	if (TclOSstat(path, &buf) == 0 && !S_ISDIR(buf.st_mode)
+		&& !(buf.st_mode & (S_IXUSR|S_IXGRP|S_IXOTH))) {
+	    errno = EACCES;
+	    return -1;
+	}
+    }
+    return 0;
 }
 
