-    after 5000
+    # The above four shell invocations take about 3 seconds to finish. Wait
+    # until all output has arrived, but no more than 30s (in case the machine
+    # is busy or process creation is slow, as on WSL); lost appends make the
+    # loop time out and the test fail.
+    set deadline [expr {[clock milliseconds] + 30000}]
+    while {[file size $tmpfile] < 26 && [clock milliseconds] < $deadline} {
+	after 100
+    }
+    # Give a little time for any excess output
+    after 500
     # Check that no bytes have got lost through mixups with overlapping
     # appends, which is only guaranteed to work when we set O_APPEND on the
     # file descriptor in the [exec >>...]
     file size $tmpfile
 } -cleanup {

