--- tests/fCmd.test
+++ tests/fCmd.test
@@ -2929,10 +2929,32 @@
 } -cleanup {
     set ::env(HOME) $oldHome
 } -constraints testfstildeexpand -body {
     string tolower [testfstildeexpand ~$::tcl_platform(user)]
 } -match glob -result [gethomedirglob $::tcl_platform(user)]
+
+test fCmd-33.1 {file operations when cwd no longer exists: Bug 469c5ea507} -setup {
+    set script [makeFile {
+	foreach cmd {{file delete spong} {file mkdir spong}} {
+	    catch $cmd msg
+	    puts $msg
+	}
+    } fCmd-33.1.tcl]
+    set script [file normalize $script]
+    set dir [pwd]
+    set tmp [file normalize [file join [temporaryDirectory] fCmd-33.1]]
+    file mkdir $tmp
+} -constraints {unix notRoot} -body {
+    cd $tmp
+    file delete $tmp
+    exec [interpreter] $script
+} -cleanup {
+    cd $dir
+    removeFile fCmd-33.1.tcl
+    catch {file delete -force $tmp}
+} -result {
+can't create directory "spong": no such file or directory}
 
 
 # cleanup
