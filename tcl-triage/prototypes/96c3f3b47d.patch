Index: generic/tclTimer.c
==================================================================
--- generic/tclTimer.c
+++ generic/tclTimer.c
@@ -871,15 +871,26 @@
 	 */
 
 	afterPtr->id = tsdPtr->afterId;
 	tsdPtr->afterId += 1;
 	Tcl_GetTime(&wakeup);
-	wakeup.sec += (long)(ms / 1000);
-	wakeup.usec += ((long)(ms % 1000)) * 1000;
-	if (wakeup.usec > 1000000) {
-	    wakeup.sec++;
-	    wakeup.usec -= 1000000;
+	if (ms / 1000 >= (Tcl_WideInt) (LONG_MAX - wakeup.sec)) {
+	    /*
+	     * Clamp a wakeup time that does not fit in Tcl_Time.sec (32-bit
+	     * long), otherwise it wraps around and blocks all later timers.
+	     * [Bug 96c3f3b47d]
+	     */
+
+	    wakeup.sec = LONG_MAX;
+	    wakeup.usec = 0;
+	} else {
+	    wakeup.sec += (long)(ms / 1000);
+	    wakeup.usec += ((long)(ms % 1000)) * 1000;
+	    if (wakeup.usec > 1000000) {
+		wakeup.sec++;
+		wakeup.usec -= 1000000;
+	    }
 	}
 	afterPtr->token = TclCreateAbsoluteTimerHandler(&wakeup,
 		AfterProc, afterPtr);
 	afterPtr->nextPtr = assocPtr->firstAfterPtr;
 	assocPtr->firstAfterPtr = afterPtr;

