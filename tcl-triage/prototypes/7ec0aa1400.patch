 test http-4.18.$ThreadLevel {reset while the socket command runs the event loop} -body {
     resetWhileOpening 0
 } -result {reset reset {} {}}
+
+test http-4.21.$ThreadLevel {-progress is not called without progress (bug [7ec0aa1400])} -setup {
+    # Chunked response; the chunk size lines, chunk data and the final chunk
+    # arrive in separate packets.
+    proc chunkServer {ch args} {
+	fconfigure $ch -blocking 0 -translation binary
+	fileevent $ch readable [list apply {{ch} {
+	    if {[catch {gets $ch line} n] || [eof $ch]} {
+		catch {close $ch}
+	    } elseif {$n >= 0 && [string trim $line] eq ""} {
+		fileevent $ch readable {}
+		set parts [list "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n"]
+		foreach data {abcde fghij} {
+		    lappend parts "5\r\n" "$data\r\n"
+		}
+		lappend parts "0\r\n" "\r\n"
+		set t 0
+		foreach part $parts {
+		    after [incr t 20] [list apply {{ch part} {
+			catch {puts -nonewline $ch $part; flush $ch}
+		    }} $ch $part]
+		}
+		after [incr t 20] [list catch [list close $ch]]
+	    }
+	}} $ch]
+    }
+    set srv [socket -server chunkServer -myaddr 127.0.0.1 0]
+    set srvurl http://127.0.0.1:[lindex [fconfigure $srv -sockname] 2]/
+    set calls {}
+} -body {
+    set token [http::geturl $srvurl -keepalive 0 -timeout 5000 \
+	    -progress {apply {{token total current} {lappend ::calls $current}}}]
+    list [http::status $token] [http::data $token] $calls
+} -cleanup {
+    http::cleanup $token
+    close $srv
+    rename chunkServer {}
+    unset -nocomplain srv srvurl calls token
+} -result {ok abcdefghij {5 10}}
 
