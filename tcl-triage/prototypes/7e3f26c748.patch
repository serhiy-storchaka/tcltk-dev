 #else /* TCL_MEM_DEBUG */
 MODULE_SCOPE void	TclDbInitNewObj(Tcl_Obj *objPtr, const char *file,
 			    int line);
 
+/*
+ * The value of a reference count in memory freed by Tcl_DbCkfree, which fills
+ * it with GUARD_VALUE (0x61) bytes: 0x61616161 or 0x6161616161616161,
+ * depending on the width of size_t. A real reference count never gets that
+ * high, since it would need that many pointers to the object.
+ */
+
+# define TCL_FREED_REFCOUNT ((size_t)-1 / 0xFF * 0x61)
+
 # define TclDbNewObj(objPtr, file, line) \
     do { \
 	TclIncrObjsAllocated();						\
 	(objPtr) = (Tcl_Obj *)						\
 		Tcl_DbCkalloc(sizeof(Tcl_Obj), (file), (line));		\

