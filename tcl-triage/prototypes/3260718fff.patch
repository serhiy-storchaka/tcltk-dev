+
+/*
+ * If the loop condition is a plain boolean constant such as "1", there is no
+ * need to compile it as an expression on every iteration. Doing so would also
+ * make a shared literal shimmer between its numeric and exprcode
+ * representations (bug [3260718]).
+ */
+
+int
+TclForConstCond(
+    Tcl_Obj *cond)
+{
+    int value;
+
+    if (Tcl_GetBooleanFromObj(NULL, cond, &value) != TCL_OK) {
+	return -1;
+    }
+    return value;
+}
 
