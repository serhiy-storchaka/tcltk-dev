+/*
+ *----------------------------------------------------------------------
+ *
+ * WaitForSignal --
+ *
+ *  Services the event loop until a worker signals this (poster) thread,
+ *  which must have been pushed on the waiter list. Bails out if the
+ *  script in the interpreter has been canceled or has exceeded its
+ *  limits; the waiter is then taken off the waiter list. Must be called
+ *  with the pool mutex unlocked.
+ *
+ * Results:
+ *  TCL_OK when signaled, TCL_ERROR if canceled or out of limits.
+ *
+ * Side effects:
+ *  Runs event handlers.
+ *
+ *----------------------------------------------------------------------
+ */
+static int
+WaitForSignal(
+    Tcl_Interp *interp,
+    ThreadPool *tpoolPtr
+) {
+    ThreadSpecificData *tsdPtr = TCL_TSD_INIT(&dataKey);
+    TpoolWaiter *waitPtr = tsdPtr->waitPtr;
+
+    tsdPtr->stop = -1;
+    while (tsdPtr->stop == -1) {
+	Tcl_DoOneEvent(TCL_ALL_EVENTS);
+	if (Tcl_Canceled(interp, TCL_LEAVE_ERR_MSG) == TCL_ERROR) {
+	    goto bailout;
+	}
+	if (Tcl_LimitExceeded(interp)) {
+	    Tcl_ResetResult(interp);
+	    Tcl_SetObjResult(interp, Tcl_NewStringObj("limit exceeded", TCL_INDEX_NONE));
+	    Tcl_SetErrorCode(interp, "TCL", "EVENT", "LIMIT", (char *)NULL);
+	    goto bailout;
+	}
+    }
+    return TCL_OK;
+
+  bailout:
+    Tcl_MutexLock(&tpoolPtr->mutex);
+    if (waitPtr->prevPtr || waitPtr->nextPtr || tpoolPtr->waitHead == waitPtr) {
+	if (tpoolPtr->waitTail == waitPtr) {
+	    tpoolPtr->waitTail = waitPtr->prevPtr;
+	}
+	SpliceOut(waitPtr, tpoolPtr->waitHead);
+	waitPtr->prevPtr = waitPtr->nextPtr = NULL;
+    }
+    Tcl_MutexUnlock(&tpoolPtr->mutex);
+    return TCL_ERROR;
+}
 
