--- /dev/null
+++ tests/tkt-3447273fff.test
@@ -0,0 +1,48 @@
+package require tcltest
+namespace import ::tcltest::*
+tcltest::loadTestedCommands
+package require thread
+
+# tpool::wait and tpool::post serviced the event loop without checking
+# for [interp cancel] and [interp limit]; the wait only ended when the
+# job was done.
+test tkt-3447273fff-1 {tpool::wait respects interp cancel} -setup {
+    set c [interp create]
+    $c eval {
+	package require thread
+	set p [tpool::create]
+	set j [tpool::post $p {after 2000}]
+    }
+} -body {
+    after 200 [list interp cancel -unwind $c]
+    set t0 [clock milliseconds]
+    set rc [catch {$c eval {tpool::wait $p $j}} msg]
+    set fast [expr {[clock milliseconds] - $t0 < 1000}]
+    # A later wait in the same thread must still work.
+    list $rc $msg $fast [$c eval {expr {[tpool::wait $p $j] eq $j}}]
+} -cleanup {
+    $c eval {tpool::release $p}
+    interp delete $c
+} -result {1 {eval unwound} 1 1}
+
+test tkt-3447273fff-2 {tpool::wait respects interp time limit} -setup {
+    set c [interp create]
+    $c eval {
+	package require thread
+	set p [tpool::create]
+	set j [tpool::post $p {after 2000}]
+    }
+} -body {
+    interp limit $c time -milliseconds [expr {[clock milliseconds] + 200}]
+    set t0 [clock milliseconds]
+    set rc [catch {$c eval {tpool::wait $p $j}} msg]
+    set fast [expr {[clock milliseconds] - $t0 < 1000}]
+    interp limit $c time -seconds {} -milliseconds {}
+    list $rc $msg $fast
+} -cleanup {
+    interp bgerror $c {apply {args {}}}
+    $c eval {tpool::wait $p $j; tpool::release $p}
+    interp delete $c
+} -result {1 {limit exceeded} 1}
+
+::tcltest::cleanupTests

