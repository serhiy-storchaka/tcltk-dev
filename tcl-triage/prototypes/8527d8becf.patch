+/*
+ *----------------------------------------------------------------------
+ *
+ * WinIsRemotePath --
+ *
+ *	Is the (UTF-8, absolute) path on a network drive or a UNC path?
+ *
+ *----------------------------------------------------------------------
+ */
+
+static int
+WinIsRemotePath(
+    const char *path)
+{
+    if ((path[0] == '/' || path[0] == '\\')
+	    && (path[1] == '/' || path[1] == '\\')) {
+	return path[2] != '?' && path[2] != '.';
+    }
+    if (path[0] != '\0' && path[1] == ':') {
+	WCHAR root[4];
+
+	root[0] = (unsigned char) path[0];
+	root[1] = ':';
+	root[2] = '\\';
+	root[3] = '\0';
+	return GetDriveTypeW(root) == DRIVE_REMOTE;
+    }
+    return 0;
+}
