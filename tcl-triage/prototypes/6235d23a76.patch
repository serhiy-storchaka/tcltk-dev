--- tests/env.test	
+++ tests/env.test	
@@ -544,10 +544,23 @@
 	[set ::env(ENV110) ""] \
 	[info exists ::env(ENV110)] \
 	[catch {set ::env(ENV110)} error] \
 	$error
 } -result {1 foo {} 0 1 {can't read "::env(ENV110)": no such variable}}
+
+test env-12.0 {
+    Bug [6235d23a76] - interp create does not restore an unset env(HOME)
+} -setup {
+    set home [array get ::env HOME]
+    unset -nocomplain ::env(HOME)
+} -cleanup {
+    interp delete child
+    array set ::env $home
+} -body {
+    interp create child
+    list [info exists ::env(HOME)] [child eval {info exists ::env(HOME)}]
+} -result {0 0}
 
 
 
 # cleanup
 rename getenv {}

