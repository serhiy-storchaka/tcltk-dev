+
+test info-bug-931e4956b9 {info cmdcount counts first compiled command [Bug 931e4956b9]} -setup {
+    interp create child
+} -body {
+    set x [child eval {info cmdcount}]
+    child eval {incr i}
+    child eval {incr i}
+    child eval {set j 1}
+    expr {[child eval {info cmdcount}] - $x}
+} -cleanup {
+    interp delete child
+    unset -nocomplain x
+} -result 5
 
 # cleanup
 catch {namespace delete test_ns_info1 test_ns_info2}
 ::tcltest::cleanupTests
 return

