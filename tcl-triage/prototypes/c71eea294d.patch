--- generic/tclVar.c
+++ generic/tclVar.c
@@ -5408,19 +5408,60 @@
  *	Variables are deleted and trace functions are invoked, if any are
  *	declared.
  *
  *----------------------------------------------------------------------
  */
+
+static Var *
+NextVarToDelete(
+    TclVarHashTable *tablePtr,
+    Var ***varsPtr,		/* Snapshot of the variables in tablePtr. */
+    Tcl_Size *indexPtr,		/* Index of the next variable in snapshot. */
+    Tcl_Size *countPtr)		/* Number of variables in snapshot. */
+{
+    Tcl_HashSearch search;
+    Var *varPtr;
+    Tcl_Size i = 0;
+
+    if (*indexPtr < *countPtr) {
+	return (*varsPtr)[(*indexPtr)++];
+    }
+
+    /*
+     * Take a snapshot of all variables instead of restarting the search
+     * after every deletion, which is quadratic. [Bug c71eea294d] Raise the
+     * refCounts, so the entries stay in the table until we delete them.
+     */
+
+    if (*varsPtr != NULL) {
+	Tcl_Free(*varsPtr);
+	*varsPtr = NULL;
+    }
+    *indexPtr = *countPtr = 0;
+    if (tablePtr->table.numEntries == 0) {
+	return NULL;
+    }
+    *varsPtr = (Var **)Tcl_Alloc(sizeof(Var *) * tablePtr->table.numEntries);
+    for (varPtr = VarHashFirstVar(tablePtr, &search); varPtr != NULL;
+	    varPtr = VarHashNextVar(&search)) {
+	VarHashRefCount(varPtr)++;
+	(*varsPtr)[i++] = varPtr;
+    }
+    *countPtr = i;
+    *indexPtr = 1;
+    return (*varsPtr)[0];
+}
 
