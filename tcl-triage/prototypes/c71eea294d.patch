--- tests/trace.test
+++ tests/trace.test
@@ -1246,10 +1246,34 @@
     set info {}
     namespace delete ::ref
     rename doTrace {}
     set info
 } 1110
+test trace-18.5 {namespace delete with many variables, unset traces creating and unsetting variables, Bug c71eea294d} -setup {
+    set info {}
+    namespace eval ::ns {
+	for {set i 0} {$i < 1000} {incr i} {
+	    variable v$i $i
+	}
+    }
+    proc doTrace {name args} {
+	lappend ::info $name
+	if {$name eq "::ns::v1"} {
+	    unset -nocomplain ::ns::v2 ::ns::v999
+	    set ::ns::new 1
+	    trace add variable ::ns::new unset [list doTrace ::ns::new]
+	}
+    }
+    foreach v {v1 v2 v999} {
+	trace add variable ::ns::$v unset [list doTrace ::ns::$v]
+    }
+} -body {
+    namespace delete ::ns
+    list [namespace exists ::ns] [lsort $info]
+} -cleanup {
+    rename doTrace {}
+} -result {0 {::ns::new ::ns::v1 ::ns::v2 ::ns::v999}}
 
