--- tests/fileName.test
+++ tests/fileName.test
@@ -1141,10 +1141,36 @@
     glob -path hello -path salut *
 } -result {"-path" may only be used once}
 test filename-11.51 {Tcl_GlobCmd} -returnCodes error -body {
     glob -dir hello -dir salut *
 } -result {"-directory" may only be used once}
+test filename-11.52 {Tcl_GlobCmd: -types {l hidden} on dangling links: bug 391bc0fd2c} -constraints {
+    unix symbolicLinkFile
+} -setup {
+    set dir [makeDirectory globLinks391]
+    close [open [file join $dir target] w]
+    file link -symbolic [file join $dir badlink] target
+    file link -symbolic [file join $dir .badlink] target
+    file delete [file join $dir target]
+} -body {
+    list [glob -nocomplain -tails -types l -dir $dir *] \
+	[glob -nocomplain -tails -types {hidden l} -dir $dir *]
+} -cleanup {
+    file delete -force $dir
+} -result {badlink .badlink}
+test filename-11.53 {Tcl_GlobCmd: -types hidden without search permission: bug 391bc0fd2c} -constraints {
+    unix notRoot
+} -setup {
+    set dir [makeDirectory globPerm391]
+    file mkdir [file join $dir .h] [file join $dir v]
+    file attributes $dir -permissions 0600
+} -body {
+    glob -nocomplain -tails -types hidden -dir $dir .h
+} -cleanup {
+    file attributes $dir -permissions 0700
+    file delete -force $dir
+} -result {.h}
 
 file rename $horribleglobname globTest
 file delete -force $tildeglobname
 set globname globTest
 unset horribleglobname tildeglobname

