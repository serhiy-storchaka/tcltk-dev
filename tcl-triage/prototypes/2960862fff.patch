 /*
  *----------------------------------------------------------------------
  *
+ * NormalizedFileName --
+ *
+ *	Returns the name under which a library file is recorded: the
+ *	normalized path if the file exists, so that the same file loaded
+ *	through different paths is recognized [Bug 2960862]. Otherwise (e.g.
+ *	a name to be found on the system search path) the name as given.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static const char *
+NormalizedFileName(
+    Tcl_Obj *pathPtr,
+    Tcl_DString *dsPtr)		/* Initialized DString to hold the result. */
+{
+    const char *name = TclGetString(pathPtr);
+
+    if (name[0] != '\0' && Tcl_FSAccess(pathPtr, F_OK) == 0) {
+	Tcl_Obj *normPtr = Tcl_FSGetNormalizedPath(NULL, pathPtr);
+
+	if (normPtr != NULL) {
+	    name = TclGetString(normPtr);
+	}
+    }
+    return Tcl_DStringAppend(dsPtr, name, TCL_INDEX_NONE);
+}
