+    /*
+     * Encoding names are case-insensitive (see RFC 2978). If there is no
+     * exact match, look for a loaded encoding, then for an encoding file,
+     * whose name differs only in case. [Bug 1214461]
+     */
+
+    nameObj = FindEncodingNameNoCase(name, 0);
+    if (nameObj == NULL) {
+	encoding = LoadEncodingFile(interp, name);
+	if (encoding != NULL) {
+	    return encoding;
+	}
+	nameObj = FindEncodingNameNoCase(name, 1);
+	if (nameObj == NULL) {
+	    return NULL;
+	}
+	if (interp != NULL) {
+	    Tcl_ResetResult(interp);
+	}
+    }
+    encoding = Tcl_GetEncoding(interp, TclGetString(nameObj));
+    Tcl_DecrRefCount(nameObj);
