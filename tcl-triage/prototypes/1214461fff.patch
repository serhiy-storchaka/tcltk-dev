+}
+
+/*
+ *-------------------------------------------------------------------------
+ *
+ * FindEncodingNameNoCase --
+ *
+ *	Looks for an encoding whose name differs from the given one only in
+ *	case: among the loaded encodings, or (if files is true) among the
+ *	encoding files on the encoding search path.
+ *
+ * Results:
+ *	The name found, with a reference count of 1, or NULL.
+ *
+ *-------------------------------------------------------------------------
+ */
+
+static Tcl_Obj *
+FindEncodingNameNoCase(
+    const char *name,
+    int files)
+{
+    Tcl_Obj *result = NULL;
+
+    if (!files) {
+	Tcl_HashSearch search;
+	Tcl_HashEntry *hPtr;
+
+	Tcl_MutexLock(&encodingMutex);
+	for (hPtr = Tcl_FirstHashEntry(&encodingTable, &search);
+		hPtr != NULL; hPtr = Tcl_NextHashEntry(&search)) {
+	    const char *key = (const char *)
+		    Tcl_GetHashKey(&encodingTable, hPtr);
+
+	    if (TclUtfCasecmp(key, name) == 0) {
+		result = Tcl_NewStringObj(key, TCL_INDEX_NONE);
+		break;
+	    }
+	}
+	Tcl_MutexUnlock(&encodingMutex);
+    } else {
+	Tcl_Obj *map, *key;
+	Tcl_DictSearch search;
+	int done = 0;
+
+	FillEncodingFileMap();
+	map = TclGetProcessGlobalValue(&encodingFileMap);
+	Tcl_DictObjFirst(NULL, map, &search, &key, NULL, &done);
+	for (; !done; Tcl_DictObjNext(&search, &key, NULL, &done)) {
+	    if (strcmp(TclGetString(key), name) != 0
+		    && TclUtfCasecmp(TclGetString(key), name) == 0) {
+		result = key;
+		break;
+	    }
+	}
+	Tcl_DictObjDone(&search);
+    }
+    if (result != NULL) {
+	Tcl_IncrRefCount(result);
+    }
+    return result;
 }
 
