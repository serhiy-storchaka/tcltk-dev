Index: tests/choosedir.test
==================================================================
--- tests/choosedir.test
+++ tests/choosedir.test
@@ -47,10 +47,26 @@
 
 proc ToEnterDirsByKey {parent dirs} {
     after 100 [list EnterDirsByKey $parent $dirs]
 }
 
+proc SelectDirAndPressOk {parent dir} {
+    upvar ::tk::dialog::file::__tk_choosedir data
+    update
+    set canvas $data(icons).cHull.canvas
+    focus -force $canvas
+    for {set i 0} {[$data(icons) get $i] ne $dir} {incr i} {}
+    $data(icons) selection set $i
+    event generate $data(icons) <<ListboxSelect>>
+    update
+    # The OK button takes the focus on press, the icon list loses it
+    event generate $data(okBtn) <Enter>
+    event generate $data(okBtn) <Button-1> -x 5 -y 5
+    update
+    event generate $data(okBtn) <ButtonRelease-1> -x 5 -y 5
+}
+
 #
 # COMMON TEST SETUP
 #
 set parent .
 
@@ -142,14 +158,26 @@
 } -body {
     ToEnterDirsByKey $parent [list "" $real $real]
     tk_chooseDirectory -title "Clear entry, Press OK; Enter $real, press OK" \
 	    -parent $parent
 } -result $real
+
+test choosedir-7.1 {tk_chooseDirectory, select a subdirectory and press OK} -constraints {
+	unix notAqua
+} -setup {
+    file mkdir [file join $real sub]
+} -body {
+    after 100 [list SelectDirAndPressOk $parent sub]
+    tk_chooseDirectory -title "Select \"sub\" and press OK" \
+	    -parent $parent -initialdir $real
+} -cleanup {
+    file delete [file join $real sub]
+} -result [file join $real sub]
 
 #
 # TESTFILE CLEANUP
 #
 
 unset fake parent real
 removeDirectory choosedirTest
 testutils forget dialog
 cleanupTests

