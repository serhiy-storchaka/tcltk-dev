+test unixEmbed-11.3 {root coordinates of a toplevel with menubar embedded in another process} -constraints {
+    unix
+} -setup {
+    deleteWindows
+    set script [makeFile {
+	menu .mb -tearoff 0
+	.mb add cascade -label File -menu .mb.f
+	menu .mb.f -tearoff 0
+	. configure -menu .mb
+	pack [label .l -text Embedded]
+	update
+	after 500 {
+	    puts "[winfo rooty .] [winfo rooty .#mb] [winfo height .#mb]"
+	    flush stdout
+	    gets stdin
+	    exit
+	}
+    } embedmenu.tcl]
+} -body {
+    toplevel .main
+    wm geometry .main +100+100
+    frame .main.f -container 1 -width 200 -height 200
+    pack .main.f
+    update
+    set f [open "|[list [interpreter] $script -use [winfo id .main.f]]" r+]
+    fileevent $f readable {set line [gets $f]}
+    set timer [after 10000 {set line timeout}]
+    vwait line
+    after cancel $timer
+    lassign $line top mbtop mbheight
+    list [expr {$mbtop - [winfo rooty .main.f]}] \
+	    [expr {$top - [winfo rooty .main.f] - $mbheight}]
+} -cleanup {
+    catch {puts $f {}; close $f}
+    removeFile embedmenu.tcl
+    deleteWindows
+} -result {0 0}
 
