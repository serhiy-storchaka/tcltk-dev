+
+    /*
+     * Remove the slot of the entry which could not be created.
+     */
+
+  error:
+    Tcl_Free(mePtr);
+    for (i = index; i < menuPtr->numEntries - 1; i++) {
+	menuPtr->entries[i] = menuPtr->entries[i + 1];
