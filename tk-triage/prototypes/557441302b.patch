Index: tests/winWm.test
==================================================================
--- tests/winWm.test
+++ tests/winWm.test
@@ -610,6 +610,24 @@
     destroy .t
 } -result 0
 
+test winWm-11.1 {wm geometry reports the position of a zoomed toplevel} -constraints win -setup {
+    destroy .t
+    toplevel .t
+    wm geometry .t 200x200+303+175
+    update
+} -body {
+    wm state .t zoomed
+    update
+    regexp {[+-](-?\d+)[+-](-?\d+)$} [wm geometry .t] -> x y
+    set res [list [expr {abs($x - [winfo rootx .t]) < 20}] \
+	    [expr {abs($y - [winfo rooty .t]) < 50}]]
+    wm state .t normal
+    update
+    lappend res [wm geometry .t]
+} -cleanup {
+    destroy .t
+} -result {1 1 200x200+303+175}
+
 #
 # TESTFILE CLEANUP
 #
