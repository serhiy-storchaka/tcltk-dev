--- tests/ttk/combobox.test
+++ tests/ttk/combobox.test
@@ -132,10 +132,28 @@
     update
     set result
 } -result [list Start 0 {} Post 1 {} Select 0 b Event 0 b] -cleanup {
     destroy .cb
 }
+
+test combobox-1600dc73a9 "Popdown unposted when combobox gets obscured" \
+    -constraints {x11} -setup {
+    pack [ttk::combobox .cb -values [list a b c]]
+    update
+} -body {
+    ttk::combobox::Post .cb
+    update
+    set result [winfo ismapped .cb.popdown]
+    toplevel .t
+    wm geometry .t [winfo width .]x[winfo height .]+[winfo rootx .]+[winfo rooty .]
+    update
+    after 200 {set done 1}; vwait done
+    lappend result [winfo ismapped .cb.popdown]
+} -cleanup {
+    destroy .t .cb
+    unset -nocomplain result done
+} -result {1 0}
 
