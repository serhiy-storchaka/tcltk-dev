Index: library/ttk/combobox.tcl
==================================================================
--- library/ttk/combobox.tcl
+++ library/ttk/combobox.tcl
@@ -65,10 +65,21 @@
     if {$tk::Priv(deltaY) != 0 && %# %% 15 == 0} {
 	ttk::combobox::Scroll %W [expr {$tk::Priv(deltaY) > 0 ? -1 : 1}]
     }
 }
 bind TCombobox <<TraverseIn>>		{ ttk::combobox::TraverseIn %W }
+
+# The popdown is an override-redirect window that stays above other
+# windows, so unpost it if the combobox gets obscured by another window.
+if {[tk windowingsystem] eq "x11"} {
+    bind TCombobox <Visibility> {
+	if {"%s" ne "VisibilityUnobscured"
+		&& [winfo exists %W.popdown] && [winfo ismapped %W.popdown]} {
+	    ttk::combobox::Unpost %W
+	}
+    }
+}
 
 ### Combobox listbox bindings.
 #
 bind ComboboxListbox <ButtonRelease-1>	{ ttk::combobox::LBSelected %W }
 bind ComboboxListbox <Return>		{ ttk::combobox::LBSelected %W }

