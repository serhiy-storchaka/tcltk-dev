--- tests/send.test
+++ tests/send.test
@@ -743,10 +743,27 @@
     lappend result [send $app {set a 25}]
     lappend result [set a]
     childTkProcess exit
     set result
 } {{can't read "a": no such variable} 25 a}
+test send-17.2 {Tk_SetAppName procedure, name just taken in another process} {unix notAqua} {
+    set fd [open "|[list [::tcltest::interpreter] -name t_s_child]" r+]
+    puts $fd [loadTkCommand]
+    puts $fd {puts ready; flush stdout}
+    flush $fd
+    gets $fd
+    # No event processing between setting the name here and in the child.
+    tk appname t_s_dup
+    puts $fd {puts [tk appname t_s_dup]; flush stdout}
+    flush $fd
+    set result [list [gets $fd] [lsort [lsearch -all -inline [winfo interps] t_s_dup*]]]
+    puts $fd exit
+    close $fd
+    lappend result [lsearch -all -inline [winfo interps] t_s_dup*]
+    tk appname tktest
+    set result
+} {{t_s_dup #2} {t_s_dup {t_s_dup #2}} t_s_dup}
 
