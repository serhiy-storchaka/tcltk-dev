+# ::tk::MenuButtonUp --
+# This procedure is invoked when a mouse button is released over a menu.
+# The release of a click which posted the menu under the pointer (e.g.
+# the menu was shifted to fit on the screen) is ignored and the menu
+# stays posted.  Otherwise the active entry is invoked.
+#
+# Arguments:
+# menu -		The menu window.
+# rootx, rooty -	Root coordinates of mouse.
+
+proc ::tk::MenuButtonUp {menu rootx rooty} {
+    variable ::tk::Priv
+
+    if {[info exists Priv(pressed)]} {
+	lassign $Priv(pressed) w x y
+	unset Priv(pressed)
+	if {$w ne $menu && abs($rootx - $x) < 3 && abs($rooty - $y) < 3} {
+	    return
+	}
+    }
+    MenuInvoke $menu 1
+}
 
 # ::tk::MenuInvoke --
 # This procedure is invoked when button 1 is released over a menu.
 # It invokes the appropriate menu action and unposts the menu if
 # it came from a menubutton.

