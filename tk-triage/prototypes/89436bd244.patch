--- tests/ttk/progressbar.test
+++ tests/ttk/progressbar.test
@@ -206,10 +206,30 @@
     ttk::progressbar .w -orient vertical -style customStyle.Vertical.TProgressbar
     list [.w cget -style] [.w style] [winfo class .w]
 } -cleanup {
     destroy .w
 } -result {customStyle.Vertical.TProgressbar Vertical.customStyle.Vertical.TProgressbar TProgressbar}
+
+test progressbar-5.1 "stopped indeterminate progressbar is not animated - Bug 89436bd244" -setup {
+    ttk::style configure Anim.Horizontal.TProgressbar -period 10 -maxphase 1000
+    ttk::progressbar .w -mode indeterminate -style Anim.Horizontal.TProgressbar
+    pack .w
+    update
+} -body {
+    after 100 {set ::done 1}; vwait ::done
+    set result [.w cget -phase]
+    .w step
+    after 100 {set ::done 1}; vwait ::done
+    lappend result [expr {[.w cget -phase] > 0}]
+    .w configure -value 0
+    set phase [.w cget -phase]
+    after 100 {set ::done 1}; vwait ::done
+    lappend result [expr {[.w cget -phase] - $phase}]
+} -cleanup {
+    destroy .w
+    unset -nocomplain ::done phase
+} -result {0 1 0}
 
