 	$w tag configure tk_rtl_right -justify right
+    } else {
+	$w tag remove tk_rtl_right 1.0 end
     }
     # Get all lines that need checking
     set end_line [lindex [split [$w index "end-1c"] .] 0]
 
     for {set line 1} {$line <= $end_line} {incr line} {
