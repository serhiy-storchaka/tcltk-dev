--- tests/menubut.test
+++ tests/menubut.test
@@ -808,10 +808,48 @@
     bind .b <Configure> {unset -nocomplain var}
     update
     destroy .b
     unset new
 } {}
+
+test menubutton-11.1 {release of the posting click over the menu does not invoke} -setup {
+    menubutton .mb -text Menu -menu .mb.m
+    menu .mb.m -tearoff 0
+    .mb.m add command -label One -command {set res invoked}
+    pack .mb
+    update
+    set res {}
+} -constraints x11 -body {
+    event generate .mb <Enter>
+    event generate .mb <Motion> -warp 1 -x 3 -y 3
+    update
+    event generate .mb <Button-1> -x 3 -y 3
+    event generate .mb.m <ButtonRelease-1> -x 3 -y 3
+    update
+    lappend res [winfo ismapped .mb.m]
+} -cleanup {
+    tk::MenuUnpost {}
+    destroy .mb
+} -result 1
+test menubutton-11.2 {release of the posting click over the menu does not invoke} -setup {
+    ttk::menubutton .mb -text Menu -menu .mb.m
