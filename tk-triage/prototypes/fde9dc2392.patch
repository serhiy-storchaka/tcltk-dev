     destroy .ttk_image22
 } -result {}
+
+test image-3.1 "Image element on another display - bug fde9dc2392" -constraints {
+    altDisplay
+} -setup {
+    image create photo test.image -width 16 -height 16
+    test.image put red -to 0 0 16 16
+    ttk::style element create test.image.element image test.image
+    ttk::style layout Test.TLabel {test.image.element -sticky nswe}
+} -body {
+    toplevel .t -screen $env(TK_ALT_DISPLAY)
+    pack [ttk::label .t.l -style Test.TLabel]
+    update
+} -cleanup {
+    destroy .t
+    image delete test.image
+} -result {}
 
