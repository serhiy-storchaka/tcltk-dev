Index: tests/unixButton.test
==================================================================
--- tests/unixButton.test
+++ tests/unixButton.test
@@ -285,10 +285,26 @@
     after 400
     set on
 } -cleanup {
     deleteWindows
 } -result 1
+
+test unixbutton-3.1 {TkpDisplayButton: huge widget, bug bffa794b1b} -constraints {
+    unix
+} -setup {
+    deleteWindows
+} -body {
+    label .l -text Huge -padx 20000 -pady 20000
+    grid .l
+    update
+    button .b -text Huge -padx 40000 -pady 40000
+    grid .b
+    update
+    list [expr {[winfo width .l] > 40000}] [expr {[winfo width .b] > 65536}]
+} -cleanup {
+    deleteWindows
+} -result {1 1}
 
