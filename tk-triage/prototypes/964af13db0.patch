@@ -96,11 +96,15 @@
 
     # Set a grab and claim the focus too.
 
     ::tk::SetFocusGrab $w $data(ent)
     $data(ent) delete 0 end
-    $data(ent) insert 0 $data(selectPath)
+    if {[info exists data(initialEntry)]} {
+	$data(ent) insert 0 $data(initialEntry)
+    } else {
+	$data(ent) insert 0 $data(selectPath)
+    }
     $data(ent) selection range 0 end
     $data(ent) icursor end
 
     # Wait for the user to respond, then restore the focus and
     # return the index of the selected button.  Restore the focus
@@ -173,17 +177,31 @@
     set data(-multiple) 0
 
     # 4: set the default directory and selection according to the -initial
     #    settings
     #
+    unset -nocomplain data(initialEntry)
     if {$data(-initialdir) ne ""} {
 	# Ensure that initialdir is an absolute path name.
 	if {[file isdirectory $data(-initialdir)]} {
 	    set old [pwd]
 	    cd $data(-initialdir)
 	    set data(selectPath) [pwd]
 	    cd $old
+	} elseif {!$data(-mustexist)} {
+	    # Start in the nearest existing ancestor and propose the
+	    # non-existent directory in the entry.
+	    set dir [file normalize $data(-initialdir)]
+	    set data(initialEntry) $dir
+	    while {![file isdirectory $dir] && [file dirname $dir] ne $dir} {
+		set dir [file dirname $dir]
+	    }
+	    if {[file isdirectory $dir]} {
+		set data(selectPath) $dir
+	    } else {
+		set data(selectPath) [pwd]
+	    }
 	} else {
 	    set data(selectPath) [pwd]
 	}
     }
 

