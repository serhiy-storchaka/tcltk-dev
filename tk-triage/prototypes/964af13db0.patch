+test choosedir-4.4 {tk_chooseDirectory, nonexistent initialdir, -mustexist 0} -constraints {
+	unix notAqua
+} -body {
+    after 100 {
+	upvar #0 ::tk::dialog::file::__tk_choosedir data
+	lappend result $data(selectPath) [$data(ent) get]
+	SendButtonPress . ok mouse
+	after 50 {SendButtonPress . ok mouse}
+    }
+    set result {}
+    lappend result [tk_chooseDirectory -title "Press Ok twice" \
+	    -parent $parent -initialdir [file join $fake sub] -mustexist 0]
+} -result [list [file dirname $fake] [file join $fake sub] [file join $fake sub]]
