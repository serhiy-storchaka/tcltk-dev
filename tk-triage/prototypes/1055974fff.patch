Index: win/tkWinDraw.c
==================================================================
--- win/tkWinDraw.c
+++ win/tkWinDraw.c
@@ -1738,14 +1738,64 @@
 static HPEN
 SetUpGraphicsPort(
     GC gc)
 {
     DWORD style;
+    DWORD dashes[16];		/* PS_USERSTYLE array, at most 16 entries */
+    DWORD numDashes = 0;
+    LOGBRUSH lb;
+
+    lb.lbStyle = BS_SOLID;
+    lb.lbColor = gc->foreground;
+    lb.lbHatch = 0;
 
     if (gc->line_style == LineOnOffDash) {
 	unsigned char *p = (unsigned char *) &(gc->dashes);
 				/* pointer to the dash-list */
+	DWORD seg[20], period = 0, offset;
+	int n = 0, i, k;
+
+	/*
+	 * Build a user-defined pen style from the real dash list, rotated by
+	 * the dash offset. An odd-length list is repeated so that on and off
+	 * segments alternate, as in X11.
+	 */
+
+	while (p[n]) {
+	    seg[n] = p[n];
+	    period += p[n];
+	    n++;
+	}
+	if (n & 1) {
+	    for (i = 0; i < n; i++) {
+		seg[n + i] = seg[i];
+	    }
+	    n *= 2;
+	    period *= 2;
+	}
+	if (n > 0 && n <= 14) {
+	    offset = gc->dash_offset >= 0 ? (DWORD) gc->dash_offset % period
+		    : period - (DWORD) (-gc->dash_offset) % period;
+	    for (k = 0; offset >= seg[k]; k++) {
+		offset -= seg[k];
+	    }
+	    if (k & 1) {
+		dashes[numDashes++] = 0;	/* Start inside an off segment. */
+	    }
+	    dashes[numDashes++] = seg[k] - offset;
+	    for (i = 1; i < n; i++) {
+		dashes[numDashes++] = seg[(k + i) % n];
+	    }
+	    if (offset) {
+		dashes[numDashes++] = offset;
+	    }
+	    if (numDashes & 1) {
+		dashes[numDashes++] = 0;
+	    }
+	    style = PS_USERSTYLE;
+	    goto makePen;
+	}
 
 	/*
 	 * Below is a simple translation of serveral dash patterns to valid
 	 * windows pen types. Far from complete, but I don't know how to do it
 	 * better. Any ideas: <mailto:j.nijtmans@chello.nl>
@@ -1765,19 +1815,14 @@
 	    }
 	}
     } else {
 	style = PS_SOLID;
     }
-    if (gc->line_width < 2) {
+  makePen:
+    if (gc->line_width < 2 && !numDashes) {
 	return CreatePen((int) style, gc->line_width, gc->foreground);
     } else {
-	LOGBRUSH lb;
-
-	lb.lbStyle = BS_SOLID;
-	lb.lbColor = gc->foreground;
-	lb.lbHatch = 0;
-
 	style |= PS_GEOMETRIC;
 	switch (gc->cap_style) {
 	case CapNotLast:
 	case CapButt:
 	    style |= PS_ENDCAP_FLAT;
@@ -1798,11 +1843,18 @@
 	    break;
 	default:
 	    style |= PS_JOIN_BEVEL;
 	    break;
 	}
-	return ExtCreatePen(style, (DWORD) gc->line_width, &lb, 0, NULL);
+	/*
+	 * Cosmetic pens measure user styles in device style units, not
+	 * pixels, so dashed lines always use a geometric pen.
+	 */
+
+	return ExtCreatePen(style,
+		(DWORD) (gc->line_width < 1 ? 1 : gc->line_width), &lb,
+		numDashes, numDashes ? dashes : NULL);
     }
 }
 
