Index: tests/canvas.test
==================================================================
--- tests/canvas.test
+++ tests/canvas.test
@@ -1622,10 +1622,41 @@
     expr {$t < 5000000}
 } -cleanup {
     destroy .c
     unset points
 } -result 1
+
+test canvas-31.1 {dash list and -dashoffset of a line - bug 1055974} -constraints {
+    testpixel
+} -setup {
+    destroy .c
+    canvas .c -width 100 -height 40 -borderwidth 0 -highlightthickness 0 \
+	-background white
+    pack .c
+    update
+} -body {
+    set res {}
+    foreach {width offset} {1 0 1 8 1 4 3 0 3 8} {
+	.c delete all
+	.c create line 0 10 100 10 -width $width -capstyle butt -fill black \
+		-dash {8 8} -dashoffset $offset
+	update
+	set s {}
+	for {set x 0} {$x < 32} {incr x} {
+	    append s [expr {[testpixel .c $x 10] eq "#000000"}]
+	}
+	lappend res $s
+    }
+    join $res \n
+} -cleanup {
+    destroy .c
+    unset -nocomplain res s width offset x
+} -result {11111111000000001111111100000000
+00000000111111110000000011111111
+11110000000011111111000000001111
+11111111000000001111111100000000
+00000000111111110000000011111111}
 
