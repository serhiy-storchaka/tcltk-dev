 /*
  *----------------------------------------------------------------------
  *
+ * GetGammaPixels --
+ *
+ *	Returns the 32-bit RGBA data of the model of a photo instance for
+ *	direct rendering. If the instance's gamma is not 1.0, returns instead
+ *	a newly allocated copy with the gamma correction applied, as is done
+ *	when allocating the colors for the instance's pixmap.
+ *
+ * Results:
+ *	Pointer to RGBA data. If it differs from the model's pix32 data, the
+ *	caller must free it with Tcl_Free.
+ *
+ * Side effects:
+ *	None.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static unsigned char *
+GetGammaPixels(
+    PhotoInstance *iPtr)
+{
+    unsigned char *src = iPtr->modelPtr->pix32, *dst, table[256];
+    size_t i, n;
+
+    if (iPtr->gamma == 1.0) {
+	return src;
+    }
+    for (i = 0; i < 256; i++) {
+	table[i] = (unsigned char)(255.99 * pow(i / 255.0, 1.0 / iPtr->gamma));
+    }
+    n = (size_t)iPtr->modelPtr->width * iPtr->modelPtr->height * 4;
+    dst = (unsigned char *)Tcl_Alloc(n);
+    for (i = 0; i < n; i += 4) {
+	dst[i] = table[src[i]];
+	dst[i + 1] = table[src[i + 1]];
+	dst[i + 2] = table[src[i + 2]];
+	dst[i + 3] = src[i + 3];
+    }
+    return dst;
+}
+
