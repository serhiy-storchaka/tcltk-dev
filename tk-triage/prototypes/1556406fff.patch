--- tests/window.test
+++ tests/window.test
@@ -314,10 +314,32 @@
 } -result {0 {waiting
 ringing the bell -> cannot invoke "bell" command: application has been destroyed
 done waiting
 bell -> cannot invoke "bell" command: application has been destroyed
 update -> }}
+test window-2.13 {Bug [1556406fff]: destroying the app keeps user-defined commands} -constraints {
+    unixOrWin
+} -body {
+    set code [loadTkCommand]
+    append code {
+	rename scale tk_scale
+	proc scale args {return "user scale"}
+	destroy .
+	catch {bell} msg
+	puts "bell -> $msg"
+	puts "scale -> [scale]"
+    }
+    set script [makeFile $code script]
+    if {[catch {exec [interpreter] $script -geometry 10x10+0+0} msg]} {
+	set error 1
+    } else {
+	set error 0
+    }
+    removeFile script
+    list $error $msg
+} -result {0 {bell -> cannot invoke "bell" command: application has been destroyed
+scale -> user scale}}
 
 
