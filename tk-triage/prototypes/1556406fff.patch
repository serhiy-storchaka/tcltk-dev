+test window-2.14 {destroying the app keeps commands replacing Tk's - bug 1556406fff} -constraints {
+    unixOrWin
+} -body {
+    set code [loadTkCommand]
+    append code {
+	rename scale tk_scale
+	proc scale args {return "user scale"}
+	destroy .
+	puts "scale -> [scale]"
+    }
+    set script [makeFile $code script]
+    if {[catch {exec [interpreter] $script -geometry 10x10+0+0} msg]} {
+	set error 1
+    } else {
+	set error 0
+    }
+    removeFile script
+    list $error $msg
+} -result {0 {scale -> user scale}}
+test window-2.15 {destroying the app disables renamed Tk commands - bug 1556406fff} -constraints {
+    unixOrWin
+} -body {
+    set code [loadTkCommand]
+    append code {
+	rename scale tk_scale
+	rename canvas tk_canvas
+	rename update tk_update
+	rename label {}
+	destroy .
+	catch {tk_scale .s} msg
+	puts "tk_scale -> $msg"
+	catch {tk_canvas .c} msg
+	puts "tk_canvas -> $msg"
+	catch {tk_update foo} msg
+	puts "tk_update -> $msg"
+	puts "label -> \"[info commands label]\""
+    }
+    set script [makeFile $code script]
+    if {[catch {exec [interpreter] $script -geometry 10x10+0+0} msg]} {
+	set error 1
+    } else {
+	set error 0
+    }
+    removeFile script
+    list $error $msg
+} -result {0 {tk_scale -> cannot invoke "tk_scale" command: application has been destroyed
+tk_canvas -> cannot invoke "tk_canvas" command: application has been destroyed
+tk_update -> bad option "foo": must be idletasks
+label -> ""}}
 
 
