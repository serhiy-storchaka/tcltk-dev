+/*
+ * ICU puts a word boundary after every punctuation character. Skip the
+ * boundaries between two punctuation characters, so that a run of
+ * punctuation counts as a single word, like a run of letters.
+ */
+
+static int32_t
+SkipPunctuation(
+    void *it,
+    const uint16_t *ustr,
+    Tcl_Size len,
+    int32_t idx,
+    int following)
+{
+    while (icu_getRuleStatus && idx > 0 && idx < len
+	    && icu_getRuleStatus(it) < UBRK_WORD_NONE_LIMITX
+	    && !Tcl_UniCharIsSpace(ustr[idx-1])) {
+	int ch = ustr[idx];
+
+	if (((ch & 0xFC00) == 0xD800) && (idx + 1 < len)
+		&& ((ustr[idx+1] & 0xFC00) == 0xDC00)) {
+	    ch = (((ch & 0x3FF) << 10) | (ustr[idx+1] & 0x3FF)) + 0x10000;
+	}
+	if (Tcl_UniCharIsSpace(ch) || Tcl_UniCharIsWordChar(ch)) {
+	    break;
+	}
+	idx = following ? icu_next(it) : icu_previous(it);
+    }
+    return idx;
+}
 
