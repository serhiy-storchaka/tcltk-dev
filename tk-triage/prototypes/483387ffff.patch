+static Tk_Window
+FindWindowOnScreen(
+    TkWindow *winPtr,		/* Root of the window tree to search. */
+    Screen *screen)		/* The screen to look for. */
+{
+    TkWindow *childPtr;
+    Tk_Window result;
+
+    if (Tk_Screen((Tk_Window) winPtr) == screen) {
+	return (Tk_Window) winPtr;
+    }
+    for (childPtr = winPtr->childList; childPtr != NULL;
+	    childPtr = childPtr->nextPtr) {
+	result = FindWindowOnScreen(childPtr, screen);
+	if (result != NULL) {
+	    return result;
+	}
+    }
+    return NULL;
+}
 
