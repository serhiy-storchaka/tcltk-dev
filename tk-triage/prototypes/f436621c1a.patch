Index: doc/getOpenFile.n
==================================================================
--- doc/getOpenFile.n
+++ doc/getOpenFile.n
@@ -56,12 +56,13 @@
 \fB\-defaultextension\fI extension\fR
 .
 Specifies a string that will be appended to the filename if the user
-enters a filename without an extension. The default value is the empty
-string, which means no extension will be appended to the filename in
-any case. This option is ignored on macOS, which
-does not require extensions to filenames,
-and the UNIX implementation guesses reasonable values for this from
-the \fB\-filetypes\fR option when this is not supplied.
+enters a filename without an extension.
+If this option is empty or not specified, the extension of the currently
+selected file type from the \fB\-filetypes\fR option (if any) is appended.
+On Windows, if the currently selected file type has an extension, that
+extension is appended even if this option is specified.
+This option is ignored on macOS, which
+does not require extensions to filenames.
 .\" OPTION: -filetypes
 .TP
 \fB\-filetypes\fI filePatternList\fR
Index: win/tkWinDialog.c
==================================================================
--- win/tkWinDialog.c
+++ win/tkWinDialog.c
@@ -817,6 +817,17 @@
 	Tcl_DStringFree(&ds);
 	if (FAILED(hr))
 	    goto vamoose;
+    } else if (oper == OFN_FILE_SAVE) {
+	/*
+	 * As on Unix, append the extension of the selected file type if
+	 * -defaultextension is not given. With an empty default extension
+	 * the dialog uses the extension of the selected file type and follows
+	 * the type selector.
+	 */
+
+	hr = fdlgIf->lpVtbl->SetDefaultExtension(fdlgIf, L"");
+	if (FAILED(hr))
+	    goto vamoose;
     }
 
     if (optsPtr->titleObj != NULL) {
Index: tests/winDialog.test
