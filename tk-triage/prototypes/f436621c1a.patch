--- tests/winDialog.test
+++ tests/winDialog.test
@@ -385,6 +385,42 @@
     return $x
 } -result [file join $initialDir "5 7 8.aaa"]
 
+test winDialog-5.7.9 {GetFileName: no -defaultextension, extension of file type} -constraints {
+    nt testwinevent
+} -body {
+    testDialog launch {set x [tk_getSaveFile -filetypes {{Text .txt} {All *}} -title Save]}
+    set msg {}
+    testDialog onDisplay {
+	if {[catch {SetText 0x3e9 bar} msg]} {
+	    Click cancel
+	} else {
+	    Click ok
+	}
+    }
+    set x "[file tail $x]$msg"
+} -cleanup {
+    unset msg
+} -result bar.txt
+
+test winDialog-5.7.10 {GetFileName: no -defaultextension, -typevariable} -constraints {
+    nt testwinevent
+} -body {
+    set tv Tcl
+    testDialog launch {set x [tk_getSaveFile -filetypes {{Text .txt} {Tcl .tcl}} \
+	    -typevariable tv -title Save]}
+    set msg {}
+    testDialog onDisplay {
+	if {[catch {SetText 0x3e9 bar} msg]} {
+	    Click cancel
+	} else {
+	    Click ok
+	}
+    }
+    set x "[file tail $x]$msg"
+} -cleanup {
+    unset msg tv
+} -result bar.tcl
+
