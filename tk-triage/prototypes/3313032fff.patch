--- tests/ttk/spinbox.test
+++ tests/ttk/spinbox.test
@@ -425,10 +425,21 @@
     ttk::spinbox .w -style customStyle.TSpinbox
     list [.w cget -style] [.w style] [winfo class .w]
 } -cleanup {
     destroy .w
 } -result {customStyle.TSpinbox customStyle.TSpinbox TSpinbox}
+
+test spinbox-6.1 "field fills the allocated height" -body {
+    ttk::spinbox .sb
+    pack .sb -fill both -expand 1
+    wm geometry . 200x200
+    update
+    .sb identify element 20 [expr {[winfo height .sb] / 2}]
+} -cleanup {
+    destroy .sb
+    wm geometry . {}
+} -result textarea
 
