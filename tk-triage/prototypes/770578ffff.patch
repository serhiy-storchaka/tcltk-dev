 /*
  *--------------------------------------------------------------
  *
+ * DrawableCoord, ClampShort --
+ *
+ *	Helpers for DisplayCanvText: convert a canvas coordinate to a
+ *	drawable coordinate without clipping it to 16 bits, and clip a
+ *	drawable coordinate to 16 bits.
+ *
+ *--------------------------------------------------------------
+ */
+
+static int
+DrawableCoord(
+    double coord,
+    int origin)
+{
+    double tmp = ((coord >= 0) ? floor(coord + 0.5) : ceil(coord - 0.5))
+	    - origin;
+
+    if (tmp > INT_MAX/2) {
+	return INT_MAX/2;
+    } else if (tmp < -(INT_MAX/2)) {
+	return -(INT_MAX/2);
+    }
+    return (int) tmp;
+}
+
+static short
+ClampShort(
+    double coord)
+{
+    if (coord > SHRT_MAX) {
+	return SHRT_MAX;
+    } else if (coord < SHRT_MIN) {
+	return SHRT_MIN;
+    }
+    return (short) coord;
+}
+
