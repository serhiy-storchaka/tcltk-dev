     destroy .c
 } -returnCodes ok -result {}  ; # shall not crash (assertion failed)
+
+test bind-38.1 {Return and KP_Enter are distinct keysyms, bug [787402ffff]} -setup {
+    frame .f -width 150 -height 100
+    pack .f
+    focus -force .f
+    update
+    set x {}
+} -body {
+    bind .f <Key> {lappend x %K}
+    event generate .f <Key-Return>
+    event generate .f <Key-KP_Enter>
+    set x
+} -cleanup {
+    destroy .f
+} -result {Return KP_Enter}
 
