+/*
+ *----------------------------------------------------------------------
+ *
+ * Tk_ClipDrawableToRect --
+ *
+ *	Clip drawing to the given rectangle. If width or height are negative,
+ *	reset to no clipping. On X11 this only affects text drawn with Xft,
+ *	which ignores the clip mask of the GC; other drawing must be clipped
+ *	with the GC as usual. The clipping applies to all drawables until it
+ *	is reset.
+ *
+ * Results:
+ *	None.
+ *
+ * Side effects:
+ *	Subsequent Xft text drawing in this thread is clipped.
+ *
+ *----------------------------------------------------------------------
+ */
+
+#if defined(HAVE_XFT) || defined(HAVE_BIDI)
+static Tcl_ThreadDataKey clipKey;
+#endif
+
+void
+Tk_ClipDrawableToRect(
+    TCL_UNUSED(Display *),
+    TCL_UNUSED(Drawable),
+    int x, int y,
+    int width, int height)
+{
+#if defined(HAVE_XFT) || defined(HAVE_BIDI)
+    Region *clipRegionPtr = (Region *)
+	    Tcl_GetThreadData(&clipKey, sizeof(Region));
+
+    if (*clipRegionPtr != NULL) {
+	TkUnixSetXftClipRegion(NULL);
+	XDestroyRegion(*clipRegionPtr);
+	*clipRegionPtr = NULL;
+    }
+    if (width >= 0 && height >= 0) {
+	XRectangle rect;
+
+	rect.x = x;
+	rect.y = y;
+	rect.width = width;
+	rect.height = height;
+	*clipRegionPtr = XCreateRegion();
+	XUnionRectWithRegion(&rect, *clipRegionPtr, *clipRegionPtr);
+	TkUnixSetXftClipRegion(*clipRegionPtr);
+    }
+#else
+    (void)x;
+    (void)y;
+    (void)width;
+    (void)height;
+#endif
+}
+
