 #include "tkText.h"
 #include "default.h"
 
+/*
+ * The -tabs option is parsed when it is set, so that an invalid value is
+ * rejected before it is stored in the tag (see [026e2bb685]).
+ */
+
+static int
+SetTabArray(
+    TCL_UNUSED(void *),
+    Tcl_Interp *interp,
+    Tk_Window tkwin,
+    Tcl_Obj **valuePtr,
+    char *recordPtr,
+    Tcl_Size internalOffset,
+    char *saveInternalPtr,
+    TCL_UNUSED(int))
+{
+    TkTextTabArray **internalPtr =
+	    (TkTextTabArray **)(recordPtr + internalOffset);
+    TkTextTabArray *tabArrayPtr = NULL;
+
+    if (TkObjIsEmpty(*valuePtr)) {
+	*valuePtr = NULL;
+    } else {
+	tabArrayPtr = TkTextGetTabs(interp, tkwin, *valuePtr);
+	if (tabArrayPtr == NULL) {
+	    return TCL_ERROR;
+	}
+    }
+    *(TkTextTabArray **)saveInternalPtr = *internalPtr;
+    *internalPtr = tabArrayPtr;
+    return TCL_OK;
+}
+
+static void
+RestoreTabArray(
+    TCL_UNUSED(void *),
+    TCL_UNUSED(Tk_Window),
+    char *internalPtr,
+    char *saveInternalPtr)
+{
+    *(TkTextTabArray **)internalPtr = *(TkTextTabArray **)saveInternalPtr;
+}
+
+static void
+FreeTabArray(
+    TCL_UNUSED(void *),
+    TCL_UNUSED(Tk_Window),
+    char *internalPtr)
+{
+    if (*(TkTextTabArray **)internalPtr != NULL) {
+	Tcl_Free(*(TkTextTabArray **)internalPtr);
+	*(TkTextTabArray **)internalPtr = NULL;
+    }
+}
+
+static const Tk_ObjCustomOption tabArrayOption = {
+    "tabs", SetTabArray, NULL, RestoreTabArray, FreeTabArray, NULL
+};
