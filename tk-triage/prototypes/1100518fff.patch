Index: tests/button.test
==================================================================
--- tests/button.test
+++ tests/button.test
@@ -4109,10 +4109,28 @@
     pack .b
     bind .b <Configure> {unset var}
     update
     destroy .b
 } {}
+
+test button-16.1 {-overrelief is restored after click, bug [1100518fff]} -setup {
+    button .b -text B -relief flat -overrelief raised
+    pack .b
+    update
+} -body {
+    set res {}
+    event generate .b <Enter> -x 5 -y 5
+    lappend res [.b cget -relief]
+    event generate .b <ButtonPress-1> -x 5 -y 5
+    lappend res [.b cget -relief]
+    event generate .b <ButtonRelease-1> -x 5 -y 5
+    lappend res [.b cget -relief]
+    event generate .b <Leave>
+    lappend res [.b cget -relief]
+} -cleanup {
+    destroy .b
+} -result {raised sunken raised flat}
 
