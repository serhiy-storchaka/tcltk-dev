+test textDisp-37.6 {RTL text: dragging the selection only extends it - bug 59d6d5f6c0} -setup {
+    text .t1 -font $fixedFont -width 40 -height 3 -wrap none
+    pack .t1
+    update
+} -body {
+    .t1 insert end "שלום עליכם, זהו טקסט"
+    update
+    # Drag from the first character (on the right if the text is laid out
+    # from right to left) to the last one.
+    lassign [.t1 bbox 1.0] x0 y w h
+    lassign [.t1 bbox 1.19] x1
+    set y [expr {$y + $h/2}]
+    set step [expr {$x1 < $x0 ? -2 : 2}]
+    event generate .t1 <Button-1> -x [expr {$x0 + $w/2}] -y $y
+    set res {}
+    set last 0
+    for {set x [expr {$x0 + $w/2}]} {($x - $x1) * $step < 0} {incr x $step} {
+	event generate .t1 <B1-Motion> -x $x -y $y
+	update
+	set range [.t1 tag ranges sel]
+	set n [expr {[llength $range] ? [.t1 count -chars {*}$range] : 0}]
+	if {$n < $last} {
+	    lappend res "$x: $last -> $n"
+	}
+	set last $n
+    }
+    event generate .t1 <ButtonRelease-1> -x $x -y $y
+    list $res [expr {$last > 15}]
+} -cleanup {
+    destroy .t1
+    unset -nocomplain x0 x1 y w h step x res last range n
+} -result {{} 1}
 
