+++ library/text.tcl
@@ -538,11 +538,15 @@
     if {$x > [lindex $bbox 0]} {
 	$w mark gravity $anchorname right
     } else {
 	$w mark gravity $anchorname left
     }
-    focus $w
+    # A disabled text widget takes the focus too, so that <<Copy>> works,
+    # unless it was explicitly excluded from focus with -takefocus 0.
+    if {[$w cget -state] eq "normal" || [$w cget -takefocus] ne "0"} {
+	focus $w
+    }
     if {[$w cget -autoseparators]} {
 	$w edit separator
     }
 }
 

