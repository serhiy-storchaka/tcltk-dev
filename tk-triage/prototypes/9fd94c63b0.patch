+/*
+ *----------------------------------------------------------------------
+ *
+ * GetItemRedrawArea --
+ *
+ *	Compute the area of the canvas that must be redrawn for an item. This
+ *	is the item's bounding box, enlarged for text items because glyphs can
+ *	extend beyond their advance width.
+ *
+ * Results:
+ *	The area is stored in *x1Ptr, *y1Ptr, *x2Ptr and *y2Ptr.
+ *
+ * Side effects:
+ *	None.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static void
+GetItemRedrawArea(
+    Tk_Item *itemPtr,
+    int *x1Ptr, int *y1Ptr,
+    int *x2Ptr, int *y2Ptr)
+{
+    int margin = 0;
+
+    if (itemPtr->typePtr == &tkTextType
+	    && itemPtr->x1 < itemPtr->x2 && itemPtr->y1 < itemPtr->y2) {
+	margin = TkCanvTextRedrawMargin(itemPtr);
+    }
+    *x1Ptr = itemPtr->x1 - margin;
+    *y1Ptr = itemPtr->y1 - margin;
+    *x2Ptr = itemPtr->x2 + margin;
+    *y2Ptr = itemPtr->y2 + margin;
+}
 
