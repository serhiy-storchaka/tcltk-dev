+/*
+ *--------------------------------------------------------------
+ *
+ * TkCanvTextRedrawMargin --
+ *
+ *	Glyphs can extend beyond their advance width (e.g. in italic fonts),
+ *	so the ink of a text item can stick out of its bounding box. This
+ *	function returns an extra margin by which the area redrawn for the
+ *	item should be enlarged.
+ *
+ * Results:
+ *	The margin in pixels.
+ *
+ * Side effects:
+ *	None.
+ *
+ *--------------------------------------------------------------
+ */
+
+int
+TkCanvTextRedrawMargin(
+    Tk_Item *itemPtr)		/* Text item. */
+{
+    TextItem *textPtr = (TextItem *) itemPtr;
+    Tk_FontMetrics fm;
+
+    if (textPtr->actualWidth <= 0 || textPtr->tkfont == NULL) {
+	return 0;
+    }
+    Tk_GetFontMetrics(textPtr->tkfont, &fm);
+    return (fm.ascent + fm.descent + 3) / 4;
+}
