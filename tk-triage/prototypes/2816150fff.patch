 } -result {}
+test winfont-6.2 {Tk_DrawAngledChars procedure: raster font is rotated} -constraints {
+    win testpixel
+} -setup {
+    destroy .t.c
+    canvas .t.c -width 200 -height 200 -borderwidth 0 -highlightthickness 0 \
+	-background white
+    pack .t.c
+    raise .t
+    update
+} -body {
+    # GDI cannot rotate the raster font Fixedsys: the text was drawn
+    # horizontally, outside the bbox of the item. Redraw the whole canvas,
+    # so that ink outside the bbox is not clipped away.
+    .t.c create text 100 100 -text ABCDEFGH -font Fixedsys -angle 90 -tags t
+    update
+    .t.c configure -background white
+    update
+    lassign [.t.c bbox t] x0 y0 x1 y1
+    set n 0
+    for {set y 0} {$y < 200} {incr y 2} {
+	for {set x 0} {$x < 200} {incr x 2} {
+	    if {($x < $x0 || $x >= $x1 || $y < $y0 || $y >= $y1)
+		    && [testpixel .t.c $x $y] ne "#ffffff"} {
+		incr n
+	    }
+	}
+    }
+    set n
+} -cleanup {
+    destroy .t.c
+    unset -nocomplain x0 y0 x1 y1 x y n
+} -result 0
 
 
