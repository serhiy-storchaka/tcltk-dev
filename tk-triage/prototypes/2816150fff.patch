+
+/*
+ *-------------------------------------------------------------------------
+ *
+ * DrawUnrotatableRun --
+ *
+ *	GDI cannot rotate raster fonts (e.g. "Courier" or "Fixedsys"): the
+ *	angled font selected in hdc is drawn unrotated. If that is the case,
+ *	draw the characters of the run with a rotated TrueType font instead,
+ *	spaced like the shaped glyphs.
+ *
+ * Results:
+ *	1 if the run was drawn, 0 if the selected font can be rotated.
+ *
+ * Side effects:
+ *	*hAngledPtr may be replaced by the TrueType font (the old one is
+ *	deleted).
+ *
+ *-------------------------------------------------------------------------
+ */
+
+static int
+DrawUnrotatableRun(
+    HDC hdc,
+    HFONT *hAngledPtr,		/* Angled font, selected in hdc. */
+    const TkWinShapedRun *run,
+    const WCHAR *wstr,
+    int x, int y)
+{
+    TEXTMETRICW tm;
+    LOGFONTW lf;
+    HFONT hFont;
+    int *dx, c, g, end;
+
+    if (!GetTextMetricsW(hdc, &tm) || (tm.tmPitchAndFamily & TMPF_VECTOR)
+	    || run->charLen <= 0) {
+	return 0;
+    }
+    GetObjectW(*hAngledPtr, sizeof(lf), &lf);
+    lf.lfOutPrecision = OUT_TT_ONLY_PRECIS;
+    lf.lfPitchAndFamily = (tm.tmPitchAndFamily & 0xF0)
+	    | ((tm.tmPitchAndFamily & TMPF_FIXED_PITCH) ? VARIABLE_PITCH
+	    : FIXED_PITCH);
+    hFont = CreateFontIndirectW(&lf);
+    if (hFont == NULL) {
+	return 0;
+    }
+    SelectObject(hdc, hFont);
+    DeleteObject(*hAngledPtr);
+    *hAngledPtr = hFont;
+
+    dx = (int *)Tcl_Alloc(sizeof(int) * run->charLen);
+    for (c = 0; c < run->charLen; c++) {
+	end = (c + 1 < run->charLen) ? run->logClust[c + 1] : run->glyphCount;
+	dx[c] = 0;
+	for (g = run->logClust[c]; g < end; g++) {
+	    dx[c] += run->advances[g];
+	}
+    }
+    ExtTextOutW(hdc, x, y, 0, NULL, wstr + run->charStart, run->charLen, dx);
+    Tcl_Free(dx);
+    return 1;
+}
 
