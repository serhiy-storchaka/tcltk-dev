--- tests/winDialog.test
+++ tests/winDialog.test
@@ -757,10 +757,24 @@
 } -body {
     exec [interpreter] <$script
 } -cleanup {
     removeFile script
 } -result {.t.e}
+
+test winDialog-5.28 {tk_getOpenFile: -multiple -initialfile is a list - bug 2473895} -constraints {
+    nt testwinevent
+} -body {
+    unset -nocomplain x y
+    testDialog launch {set x [tk_getOpenFile -multiple 1 \
+		      -initialdir [file nativename $initialDir] \
+		      -initialfile [list a.txt "b c.txt"] -title Foo]}
+    testDialog onDisplay {
+	set y [GetText 0x47c]
+	Click cancel
+    }
+    list $y $x
+} -result {{"a.txt" "b c.txt"} {}}
 
 test winDialog-6.1 {MakeFilter} -constraints {emptyTest nt} -body {}
 
 
