Index: tests/winWm.test
==================================================================
--- tests/winWm.test
+++ tests/winWm.test
@@ -688,10 +688,25 @@
     list [testwinevent [wm frame .t] 0 WM_MOUSEACTIVATE [wm frame .t] $lParam] \
 	    [testwinevent [wm frame .t] 0 WM_MOUSEACTIVATE [testforeignwindow] $lParam]
 } -cleanup {
     destroy .t
 } -result {1 1}
+
+test winWm-13.1 {WM_DISPLAYCHANGE keeps tk scaling, Bug 1567354} -constraints {
+    win testwinevent
+} -setup {
+    set oldScaling [tk scaling]
+} -body {
+    tk scaling 2.0
+    set scaling [tk scaling]
+    testwinevent [wm frame .] 0 WM_DISPLAYCHANGE [winfo depth .] \
+	    [expr {([winfo screenheight .] << 16) | [winfo screenwidth .]}]
+    expr {abs([tk scaling] - $scaling) < 0.01}
+} -cleanup {
+    tk scaling $oldScaling
+    unset oldScaling scaling
+} -result 1
 
 #
 # TESTFILE CLEANUP
 #
 

