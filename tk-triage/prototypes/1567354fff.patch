Index: tests/winWm.test
==================================================================
--- tests/winWm.test
+++ tests/winWm.test
@@ -610,6 +610,21 @@
     destroy .t
 } -result 0
 
+test winWm-11.1 {WM_DISPLAYCHANGE keeps tk scaling, Bug 1567354} -constraints {
+    win testwinevent
+} -setup {
+    set oldScaling [tk scaling]
+} -body {
+    tk scaling 2.0
+    set scaling [tk scaling]
+    testwinevent [wm frame .] 0 WM_DISPLAYCHANGE [winfo depth .] \
+	    [expr {([winfo screenheight .] << 16) | [winfo screenwidth .]}]
+    expr {abs([tk scaling] - $scaling) < 0.01}
+} -cleanup {
+    tk scaling $oldScaling
+    unset oldScaling scaling
+} -result 1
+
 #
 # TESTFILE CLEANUP
 #
