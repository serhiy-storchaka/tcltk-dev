--- win/tkWinX.c
+++ win/tkWinX.c
@@ -372,6 +372,47 @@
 /*
  *----------------------------------------------------------------------
  *
+ * TkWinScreenSizeChanged --
+ *
+ *	Update the size of the screen in pixels and millimeters. If the size
+ *	in millimeters is already known, the number of pixels per millimeter
+ *	is kept, so that a scaling factor set by [tk scaling] is preserved.
+ *
+ * Results:
+ *	None.
+ *
+ * Side effects:
+ *	The screen dimensions are updated.
+ *
+ *----------------------------------------------------------------------
+ */
+
+void
+TkWinScreenSizeChanged(
+    Screen *screen,
+    int width,
+    int height,
+    HDC dc)
+{
+    if (WidthOfScreen(screen) > 0 && WidthMMOfScreen(screen) > 0
+	    && HeightOfScreen(screen) > 0 && HeightMMOfScreen(screen) > 0) {
+	WidthMMOfScreen(screen) = MulDiv(width, WidthMMOfScreen(screen),
+		WidthOfScreen(screen));
+	HeightMMOfScreen(screen) = MulDiv(height, HeightMMOfScreen(screen),
+		HeightOfScreen(screen));
+    } else {
+	WidthMMOfScreen(screen) = MulDiv(width, 254,
+		GetDeviceCaps(dc, LOGPIXELSX) * 10);
+	HeightMMOfScreen(screen) = MulDiv(height, 254,
+		GetDeviceCaps(dc, LOGPIXELSY) * 10);
+    }
+    WidthOfScreen(screen) = width;
+    HeightOfScreen(screen) = height;
+}
+
