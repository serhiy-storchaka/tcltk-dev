+/*
+ *----------------------------------------------------------------------
+ *
+ * LayoutWrapper --
+ *
+ *	Positions the toplevel and its menubar within the current size of the
+ *	wrapper window.
+ *
+ * Results:
+ *	None.
+ *
+ * Side effects:
+ *	The toplevel and menubar are moved/resized, and a ConfigureNotify
+ *	event is synthesized for the toplevel.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static void
+LayoutWrapper(
+    WmInfo *wmPtr)		/* Information about toplevel window. */
