Index: tests/unixWm.test
==================================================================
--- tests/unixWm.test
+++ tests/unixWm.test
@@ -2749,10 +2749,42 @@
     list [expr {$before - [winfo reqheight .t]}] \
 	    [expr {$after - [winfo reqheight .t] - [winfo rooty .t] + $rooty}]
 } -cleanup {
     destroy .t
 } -result {0 0}
+
+test unixWm-64.1 {UpdateGeometryInfo procedure, toggle the menubar of a\
+	zoomed window, bug [1d926db566]} -constraints {
+    unix withWindowManager
+} -setup {
+    destroy .t
+    toplevel .t
+    menu .t.m
+    .t.m add cascade -label File
+    .t configure -menu .t.m
+    update
+} -body {
+    wm attributes .t -zoomed 1
+    pause 500
+    update
+    set height [winfo height .t]
+    set result {}
+    # The window manager keeps the size of the zoomed wrapper, so the
+    # toplevel grows when the menubar is removed and shrinks when it is
+    # added back.
+    foreach menu {{} .t.m {} .t.m} {
+	.t configure -menu $menu
+	update
+	pause 100
+	update
+	lappend result [expr {[winfo height .t] - $height}]
+    }
+    lmap d $result {expr {$d > 0}}
+} -cleanup {
+    destroy .t
+    unset -nocomplain height result menu d
+} -result {1 0 1 0}
 
 #
 # TESTFILE CLEANUP
 #
 

