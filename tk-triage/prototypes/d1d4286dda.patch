+
+## ScrollPages --
+#	Auto-repeat callback for clicks in the trough: scroll by pages
+#	until the thumb reaches the pointer.
+#
+proc ttk::scrollbar::ScrollPages {w n} {
+    variable State
+    if {![winfo exists $w] || ![info exists State(xPress)]} {
+	return
+    }
+    set f [$w fraction $State(xPress) $State(yPress)]
+    lassign [$w get] first last
+    if {($n < 0 && $f < $first) || ($n > 0 && $f > $last)} {
+	Scroll $w $n pages
+    }
+}
 
 proc ttk::scrollbar::Drag {w x y} {
     variable State
     if {![info exists State(first)]} {
 	# Initial buttonpress was not on the thumb,
