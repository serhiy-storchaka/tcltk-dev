+	# or something screwy has happened.  In either case, just
+	# track the pointer for ScrollPages:
+	set State(xPress) $x
+	set State(yPress) $y
 	return;
     }
     set xDelta [expr {$x - $State(xPress)}]
     set yDelta [expr {$y - $State(yPress)}]
     Moveto $w [expr {$State(first) + [$w delta $xDelta $yDelta]}]

