Index: tests/panedwindow.test
==================================================================
--- tests/panedwindow.test
+++ tests/panedwindow.test
@@ -5436,10 +5436,34 @@
     }
     set res
 } -cleanup {
     deleteWindows
 } -result {0 1 0 1}
+test panedwindow-31.2 {sash move does not resize a gridded toplevel - bug 3466588} -setup {
+    deleteWindows
+} -body {
+    toplevel .t
+    panedwindow .t.p -orient vertical
+    text .t.p.t -setgrid 1
+    frame .t.p.f
+    .t.p add .t.p.t .t.p.f
+    pack .t.p -expand 1 -fill both
+    update
+    wm geometry .t 64x30
+    update
+    set size [winfo width .t]x[winfo height .t]
+    set res {}
+    foreach dy {1 20 -40} {
+	.t.p sash place 0 1 [expr {[lindex [.t.p sash coord 0] 1] + $dy}]
+	update
+	lappend res [expr {"[winfo width .t]x[winfo height .t]" eq $size}]
+    }
+    set res
+} -cleanup {
+    deleteWindows
+    unset -nocomplain size res dy
+} -result {1 1 1}
 
 #
 # TESTFILE CLEANUP
 #
 

Index: win/tkWinWm.c
==================================================================
--- win/tkWinWm.c
+++ win/tkWinWm.c
@@ -6196,10 +6196,20 @@
     if (wmPtr) {
 	if ((winPtr->flags & TK_EMBEDDED) && (wmPtr->wrapper != NULL)) {
 	    SendMessageW(wmPtr->wrapper, TK_GEOMETRYREQ, Tk_ReqWidth(tkwin),
 		Tk_ReqHeight(tkwin));
 	}
+
+	/*
+	 * Explicit dimensions have been set for this window, so ignore the
+	 * geometry request, as on X11. For a gridded window the size would
+	 * otherwise change: it is computed from the requested size.
+	 */
+
+	if ((wmPtr->width >= 0) && (wmPtr->height >= 0)) {
+	    return;
+	}
 	if (!(wmPtr->flags & (WM_UPDATE_PENDING|WM_NEVER_MAPPED))) {
 	    Tcl_DoWhenIdle(UpdateGeometryInfo, winPtr);
 	    wmPtr->flags |= WM_UPDATE_PENDING;
 	}
     }

