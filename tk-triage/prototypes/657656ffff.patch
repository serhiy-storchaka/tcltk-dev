Index: library/tkfbox.tcl
==================================================================
--- library/tkfbox.tcl
+++ library/tkfbox.tcl
@@ -609,10 +609,22 @@
     if {$class eq "TkFDialog"} {
 	# Make the file list if this is a File Dialog, selecting all but
 	# 'd'irectory type files.
 	#
 	$data(icons) add $file [GlobFiltered [pwd] {f b c l p s}]
+
+	# Highlight the currently selected file, if it is in the list.
+	#
+	set n [$data(icons) index end]
+	for {set i 0} {$i < $n} {incr i} {
+	    if {[$data(icons) get $i] eq $data(selectFile)} {
+		$data(icons) selection set $i
+		$data(icons) selection anchor $i
+		$data(icons) see $i
+		break
+	    }
+	}
     }
 
     # Update the Directory: option menu
     #
     set list ""

