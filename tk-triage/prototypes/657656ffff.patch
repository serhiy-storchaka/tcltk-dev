+
+	test filebox-7.3-$mode "tk_getOpenFile - -initialfile is highlighted" \
+	    -constraints {nonUnixUserInteraction x11} \
+	    -body {
+		after 100 {
+		    set icons $::tk::dialog::file::__tk_filedialog(icons)
+		    set res {}
+		    foreach i [$icons selection get] {
+			lappend res [$icons get $i]
+		    }
+		}
+		ToPressButton $parent cancel
+		tk_getOpenFile -parent $parent \
+		    -initialdir [tcltest::temporaryDirectory] -initialfile $tmpFile
+		set res
+	    } \
+	    -cleanup {
+		unset -nocomplain res icons
+	    } \
+	    -result $tmpFile
     }
 
