+/* Static text is one line: every unit is the whole text. */
+static gchar *tk_text_get_string_at_offset(
+    AtkText *text,
+    TCL_UNUSED(gint),		/* offset */
+    TCL_UNUSED(AtkTextGranularity),
+    gint *start_offset,
+    gint *end_offset)
+{
+    gchar *value = GetStaticText(text);
+
+    *start_offset = 0;
+    *end_offset = value ? (gint)g_utf8_strlen(value, -1) : 0;
+    return value;
+}
+
+/* Without per-character geometry, report the box of the whole widget. */
+static void tk_text_get_character_extents(
+    AtkText *text,
+    TCL_UNUSED(gint),		/* offset */
+    gint *x, gint *y, gint *width, gint *height,
+    AtkCoordType coords)
+{
+    tk_get_extents((AtkComponent *)text, x, y, width, height, coords);
+}
+
+static void tk_text_get_range_extents(
+    AtkText *text,
+    TCL_UNUSED(gint),		/* start_offset */
+    TCL_UNUSED(gint),		/* end_offset */
+    AtkCoordType coord_type,
+    AtkTextRectangle *rect)
+{
+    tk_get_extents((AtkComponent *)text, &rect->x, &rect->y,
+	    &rect->width, &rect->height, coord_type);
+}
