  * text widgets. All accessibility in text data is managed at the script level.
  */
 
+/*
+ * Static text: the text of a label, so that a screen reader can read it
+ * without the label taking the focus (Orca's flat review, "read window").
+ * Returns NULL for other widgets. The result must be freed with g_free().
+ */
+static gchar *GetStaticText(AtkText *text)
+{
+    TkAtkAccessible *acc = (TkAtkAccessible *)text;
+
+    if (!acc || !acc->tkwin || GetAtkRoleForWidget(acc->tkwin) != ATK_ROLE_LABEL) {
+	return NULL;
+    }
+    return GetAtkValueForWidget(acc->tkwin);
+}
+
 static gchar *tk_text_get_text(
-    TCL_UNUSED(AtkText *),
-    TCL_UNUSED(gint),
-    TCL_UNUSED(gint))
+    AtkText *text,
+    gint start_offset,
+    gint end_offset)
 {
-    return NULL;
+    gchar *value = GetStaticText(text);
+    gchar *result;
+    glong len;
+
+    if (!value) {
+	return NULL;
+    }
+    len = g_utf8_strlen(value, -1);
+    if (end_offset < 0 || end_offset > len) {
+	end_offset = len;
+    }
+    if (start_offset < 0) {
+	start_offset = 0;
+    }
+    if (start_offset > end_offset) {
+	start_offset = end_offset;
+    }
+    result = g_utf8_substring(value, start_offset, end_offset);
+    g_free(value);
+    return result;
 }
 
