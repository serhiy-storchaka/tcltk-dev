+	if (selPtr == NULL) {
+	    selPtr = (TkSelHandler *)Tcl_Alloc(sizeof(TkSelHandler));
+	    selPtr->nextPtr = winPtr->selHandlerList;
+	    winPtr->selHandlerList = selPtr;
+	    selPtr->selection = selection;
+	    selPtr->target = target;
+	    selPtr->format = target; /* We want UTF8_STRING format */
+	    selPtr->size = 8;
+	} else if (selPtr->format == target && selPtr->proc == oldProc) {
+	    /*
+	     * Looks like we had a utf-8 target implicitly created together
+	     * with the STRING handler being replaced. Replace it too.
