+
+test select-14.2 {Bug [af31a84c91]: Replacing selection handler also replaces implicit UTF8_STRING handler} -constraints {
+    unix
+} -setup {
+    proc strhandler {str offset count} {
+	return [string range $str $offset [expr {$offset + $count - 1}]]
+    }
+} -body {
+    selection own .
+    selection handle . {strhandler "Original"}
+    selection handle . {strhandler "Replaced"}
+    list [selection get -type STRING] [selection get -type UTF8_STRING]
+} -cleanup {
+    selection handle . {}
+    rename strhandler {}
+} -result {Replaced Replaced}
+test select-14.3 {Bug [af31a84c91]: Replacing STRING handler keeps explicit UTF8_STRING handler} -setup {
+    proc strhandler {str offset count} {
+	return [string range $str $offset [expr {$offset + $count - 1}]]
+    }
+} -body {
+    selection own .
+    selection handle -type UTF8_STRING . {strhandler "Explicit"}
+    selection handle . {strhandler "Original"}
+    selection handle . {strhandler "Replaced"}
+    list [selection get -type STRING] [selection get -type UTF8_STRING]
+} -cleanup {
+    selection handle -type UTF8_STRING . {}
+    selection handle . {}
+    rename strhandler {}
+} -result {Replaced Explicit}
 
