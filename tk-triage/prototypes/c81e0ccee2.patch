+
+test font-47.4 {Bug c81e0ccee2 - named font created after its name was used} -setup {
+    catch {font delete LateFont}
+    font create EarlyFont -family Helvetica -size 40
+    label .t.l1 -font EarlyFont -text LARGE
+} -body {
+    label .t.l2 -font LateFont -text LARGE
+    pack .t.l1 .t.l2
+    update
+    set before [expr {[winfo reqheight .t.l2] == [winfo reqheight .t.l1]}]
+    font create LateFont -family Helvetica -size 40
+    update
+    list $before [expr {[winfo reqheight .t.l2] == [winfo reqheight .t.l1]}]
+} -cleanup {
+    destroy .t.l1 .t.l2
+    font delete EarlyFont LateFont
+} -result {0 1}
 
