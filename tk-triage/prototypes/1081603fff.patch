+test canvas-27.3 {arc ends neither stop short nor overshoot - bug 1081603} -constraints {
+    testpixel
+} -setup {
+    destroy .c
+    canvas .c -width 120 -height 120 -background white -highlightthickness 0
+    pack .c
+} -body {
+    # Ends at 0, 90, 180, 270 degrees: the pixels before, at and after the
+    # end along the tangent; one of the first two must be drawn and the last
+    # one must not.
+    set res {}
+    foreach {start extent} {0 90 90 90 180 90 270 90 0 -90 90 -90 180 -90 270 -90} {
+	.c delete all
+	.c create arc 10 10 110 110 -start $start -extent $extent -style arc
+	update
+	foreach a [list $start [expr {($start + $extent) % 360}]] \
+		dir [list $extent [expr {-$extent}]] {
+	    # Offset from the end into the arc along the tangent.
+	    set d [expr {(($a == 0 || $a == 90) == ($dir > 0)) ? -1 : 1}]
+	    lassign [dict get {0 {110 60 0 1} 90 {60 10 1 0} 180 {10 60 0 1}
+		    270 {60 110 1 0}} $a] x y dx dy
+	    set p {}
+	    foreach i [list $d 0 [expr {-$d}]] {
+		append p [expr {[testpixel .c [expr {$x + $i*$dx}] \
+			[expr {$y + $i*$dy}]] ne "#ffffff"}]
+	    }
+	    if {![string match {1?0} $p] && ![string match {?10} $p]} {
+		lappend res "$start $extent at $a: $p"
+	    }
+	}
+    }
+    set res
+} -cleanup {
+    destroy .c
+    unset -nocomplain res start extent a dir d x y dx dy p i
+} -result {}
 
