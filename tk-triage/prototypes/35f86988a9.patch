+/*
+ *----------------------------------------------------------------------
+ *
+ * FrameGeometryRequest --
+ *
+ *	Request the size given by the -width and -height options, if any.
+ *
+ * Results:
+ *	None.
+ *
+ * Side effects:
+ *	The geometry manager of the frame may be notified.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static void
+FrameGeometryRequest(
+    Frame *framePtr)		/* Information about widget. */
+{
+    int width, height;
+
+    Tk_GetPixelsFromObj(NULL, framePtr->tkwin, framePtr->widthObj, &width);
+    Tk_GetPixelsFromObj(NULL, framePtr->tkwin, framePtr->heightObj, &height);
+    if ((width > 0) || (height > 0)) {
+	Tk_GeometryRequest(framePtr->tkwin, width, height);
+    }
+}
