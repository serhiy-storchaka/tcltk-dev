@@ -182,10 +182,36 @@
 test fontchooser-5.1 {fontchooser multiple configure} -constraints {scriptImpl} -body {
     tk fontchooser configure -title TestTitle -command foo
     tk fontchooser configure -command bar
     tk fontchooser configure -title
 } -result {TestTitle}
+
+test fontchooser-6.2 {-command error goes to interp bgerror handler} -constraints {
+    scriptImpl
+} -setup {
+    set res {}
+    set handler [interp bgerror {}]
+    proc bgerror {msg} {lappend ::res [list bgerror $msg]}
+    proc testBgerror {msg opts} {lappend ::res [list handler $msg]}
+    interp bgerror {} testBgerror
+} -body {
+    testDialog launch {
+	tk::fontchooser::Configure -command {error oops} -font courier
+	tk::fontchooser::Show
+    }
+    testDialog onDisplay {
+	Click apply
+	Click cancel
+    }
+    set res
+} -cleanup {
+    interp bgerror {} $handler
+    rename bgerror {}
+    rename testBgerror {}
+    tk::fontchooser::Configure -command {}
+    unset res handler
+} -result {{handler oops}}
 
