 	    my DrawSelection
 	}
     }
     method FocusOut {} {
 	$w state !focus
-	$w selection clear 0 end
+	# Keep the selection if the focus leaves the dialog, e.g. with
+	# a focus-follows-mouse window manager.
+	set f [focus -displayof $w]
+	if {$f ne "" && [winfo toplevel $f] eq [winfo toplevel $w]} {
+	    $w selection clear 0 end
+	}
     }
 
