Index: tests/select.test
==================================================================
--- tests/select.test
+++ tests/select.test
@@ -1113,10 +1113,28 @@
     selection get -selection CLIPBOARD_MANAGER -type SAVE_TARGETS
     clipboard get
 } -cleanup {
     rename get_clip {}
 } -result {abcd}
+
+test select-14.4 {Bug [1571737fff]: UTF8_STRING handler defaults to UTF8_STRING format} -constraints {
+    x11
+} -setup {
+    selectionSetup
+    childTkProcess create
+    proc utf8handler {offset count} {
+	string range "\u0442\u0435\u0441\u0442" $offset [expr {$offset + $count - 1}]
+    }
+} -body {
+    selection handle -type UTF8_STRING .f1 utf8handler
+    childTkProcess eval {
+	lmap c [split [selection get -type UTF8_STRING] ""] {scan $c %c}
+    }
+} -cleanup {
+    childTkProcess exit
+    rename utf8handler {}
+} -result {1090 1077 1089 1090}
 
